# ==========================================
# LOCAL DEVELOPMENT & EXAMPLES
# ==========================================
# Ignores localhost URLs that often appear in code snippets
# or documentation.
http://localhost.*
http://127\.0\.0\.1.*
http://0\.0\.0\.0.*

# Typical placeholder domains in code examples
https?://example\.(com|org|net)
https?://team4procoaching\.com
https?://team4procoaching\.com

# ==========================================
# SOCIAL MEDIA & SERVICES (BOT PROTECTION)
# ==========================================
# These services almost always block bots/scrapers (403/429 errors)
# It's not worth checking these in CI.
linkedin\.com
twitter\.com
x\.com
instagram\.com
facebook\.com
tiktok\.com
reddit\.com
socket\.dev

# ==========================================
# TECHNICAL EXCEPTIONS
# ==========================================
# If you use "Edit on GitHub" links that don't exist yet in the PR
# (dynamic branch name):
# github\.com/.*/edit/.*

# Optional: Ignore IP addresses (loopback)
# 127\.0\.0\.1
