{
  "name": "team4procoaching-website",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=24.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "prepare": "husky",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run check:conventions",
    "check:biome-rules": "node scripts/check-biome-rule-baseline.mjs",
    "check:conventions": "node scripts/check-conventions.mjs",
    "check:duplication": "jscpd src scripts",
    "fix": "pnpm run lint:fix && pnpm run format",
    "query:sonar-findings": "node --env-file-if-exists=.env.local scripts/query-sonar-findings.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "astro check",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "pnpm run organize-imports && pnpm run format:biome && pnpm run format:prettier",
    "format:check": "pnpm run format:biome:check && pnpm run format:prettier:check",
    "format:biome": "biome format --write .",
    "format:biome:check": "biome format --diagnostic-level=error .",
    "format:prettier": "prettier --write \"**/*.{astro,md,mdx,yml,yaml}\" --cache",
    "format:prettier:check": "prettier --check \"**/*.{astro,md,mdx,yml,yaml}\"",
    "organize-imports": "biome check --write --formatter-enabled=false --linter-enabled=false .",
    "validate:renovate": "pnpm dlx --package renovate renovate-config-validator"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.2",
    "@tailwindcss/typography": "0.5.19",
    "@tailwindcss/vite": "4.2.2",
    "@tailwindplus/elements": "1.0.22",
    "astro": "6.1.5",
    "tailwindcss": "4.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.8",
    "@biomejs/biome": "2.3.10",
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "@lhci/cli": "0.15.1",
    "@types/jsdom": "28.0.1",
    "axe-core": "4.11.4",
    "husky": "9.1.7",
    "jscpd": "4.0.9",
    "jsdom": "29.0.1",
    "lint-staged": "16.4.0",
    "playwright": "1.60.0",
    "prettier": "3.8.2",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.7.2",
    "typescript": "5.9.3",
    "vitest": "4.1.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,cjs,mjs}": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ],
    "*.{json,css}": [
      "biome format --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ],
    "*.{astro,md,mdx,yml,yaml}": [
      "prettier --write --cache"
    ]
  }
}
