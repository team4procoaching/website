# build output
dist/

# Lighthouse CI output dir — generated reports, not source-controlled.
# The lighthouserc*.cjs config files at the repo root ARE source-controlled.
.lighthouseci/

# Playwright local run artefacts — uploaded to GHA in playwright-a11y.yml.
test-results/
playwright-report/

# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# Local Netlify folder
.netlify

# Netlify CLI generates this for its internal Deno-based edge function runtime.
# Not relevant for this project since we use pnpm + Node.js.
deno.lock

# Claude Code session artefacts — committed: agents/, settings.json.
# Ignored: local overrides, ephemeral session data, worktrees.
.claude/settings.local.json
.claude/worktrees/
.claude/reviews/
.claude/plans/
.claude/cache/
.claude/logs/
.claude/work/
.claude/tmp/

# SonarLint cache and state — keep only the committed connectedMode.json
.sonarlint/*
!.sonarlint/connectedMode.json

# Agent-side SonarCloud query
.env.local
.sonar-cache/
.tmp_probe/

# Stryker mutation testing reports (reproducible artefact, not versioned)
reports/mutation/

# Vitest coverage reports (reproducible artefact, not versioned)
coverage/
.nyc_output/
