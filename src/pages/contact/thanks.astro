---
import Button from '~/components/ui/Button.astro';
import { thanksPage } from '~/data/thanks';
/**
 * Thank you page shown after successful contact form submission.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Message Sent"
  description="Thank you for contacting Team 4 Pro Coaching. We'll get back to you soon."
  noindex
>
  <section class="bg-background dark:bg-background-dark px-6 py-24 sm:py-32 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <div
        class="bg-accent-100 dark:bg-accent-900/30 mx-auto mb-8 flex size-16 items-center justify-center rounded-full"
      >
        {/* SAFETY: icon content is statically defined in ~/data/thanks.ts */}
        <svg
          class="text-accent-600 dark:text-accent-400 size-10"
          fill={thanksPage.iconType === 'fill' ? 'currentColor' : 'none'}
          stroke={thanksPage.iconType === 'stroke' ? 'currentColor' : 'none'}
          stroke-width={thanksPage.iconType === 'stroke' ? '1.5' : '0'}
          viewBox="0 0 24 24"
          aria-hidden="true"
          set:html={thanksPage.icon}
        />
      </div>

      <h1
        class="text-foreground-950 font-serif text-4xl font-bold tracking-tight sm:text-5xl dark:text-white"
      >
        {thanksPage.headline}
      </h1>

      <p class="text-foreground-600 mt-6 text-lg/8 dark:text-gray-400">
        {thanksPage.message}
      </p>

      <div class="mt-10 flex items-center justify-center gap-x-6">
        <Button href={thanksPage.backButton.href}>{thanksPage.backButton.label}</Button>
      </div>
    </div>
  </section>
</BaseLayout>
