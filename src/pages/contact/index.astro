---
/**
 * Contact page.
 * Split layout with contact info and Netlify-powered form.
 */
import Contact from '~/components/sections/Contact.astro';
import ContactForm from '~/components/sections/contact/ContactForm.astro';
import { contactSection } from '~/data/contact';
import BaseLayout from '~/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact"
  description="Get in touch with Team 4 Pro Coaching. Send us a message or connect with us on Instagram."
>
  <Contact
    headlineConversational={contactSection.headlineConversational}
    headlineTransactional={contactSection.headlineTransactional}
    headlineProgram={contactSection.headlineProgram}
    intro={contactSection.intro}
    contactMethods={contactSection.contactMethods}
  >
    <ContactForm
      slot="form"
      name={contactSection.form.name}
      action={contactSection.form.successRedirect}
      submitLabel={contactSection.form.submitLabel}
      lockedServiceLabel={contactSection.lockedServiceLabel}
      differentServiceLabel={contactSection.subscriptionBoxDifferentServiceLabel}
      subscriptionBoxHeading={contactSection.subscriptionBoxHeading}
      subscriptionBoxDetailLabel={contactSection.subscriptionBoxDetailLabel}
    />
  </Contact>
</BaseLayout>
