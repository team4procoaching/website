---
/**
 * Service detail page route — `/services/[slug]`.
 *
 * Renders the long-form detail composition for any service that passes
 * the launch-gate predicate. The route is statically generated at build
 * time via `getStaticPaths`, which filters `services` to detail-eligible
 * entries; services without complete content (no lead, sub-threshold
 * arrays) never produce a route.
 *
 * The page composes two arms keyed on `service.pricingModel`. The
 * subscription arm renders the long-form layout (WhoIsFor → WhatsIncluded
 * → Accordion → ServicePricingBlock); the session arm replaces the
 * long-form sections with a configurator (ProcessSteps → SocialProof →
 * SessionConfigurator) per ADR-0051. Hero, Breadcrumb, ProcessSteps,
 * SocialProof, and the QuizModal mount are shared by both arms.
 *
 * Subscription-arm composition follows the IA from the concept doc:
 *   1. Breadcrumb (semantic + SEO; encapsulates header clearance)
 *   2. ServiceDetailHero — eyebrow + h1 + tagline + lead + chips +
 *      primary/secondary CTAs
 *   3. ServiceWhoIsFor — single-column eligibility list
 *   4. ServiceWhatsIncluded — expanded `detailedFeatures` grid
 *   5. ProcessSteps — service override or shared global timeline (compact, default)
 *   6. ServiceSocialProof — testimonials, renders nothing when no IDs
 *      resolve (graceful launch-gate-fail path)
 *   7. Accordion — service-specific FAQ, parallel-open
 *   8. ServicePricingBlock — segmented control + rows + embedded primary
 *      CTA + tertiary inline quiz trigger
 *   + QuizModal mount — single per-page instance, ADR-0027 Invokers API
 *
 * Session-arm composition (ADR-0051, R1 Option 1): Breadcrumb → Hero →
 * ProcessSteps → SocialProof → SessionConfigurator → QuizModal mount. No
 * WhoIsFor / WhatsIncluded / Accordion on this arm — session services
 * carry only `lead` plus the configurator-substance fields.
 *
 * The Breadcrumb's intermediate trail step routes back to the catalogue
 * pre-filtered to the service's category via the `#<category>` hash
 * fragment; the services-index controller resolves the hash on its own
 * (see `servicesFilterController.ts`) — this page does nothing extra to
 * assist.
 *
 * Schema.org JSON-LD ride-along: `buildServiceSchema` produces a
 * standalone `Service` document, passed to `BaseLayout` via the
 * `additionalJsonLd` prop. The layout's existing `WebPage`/`WebSite`
 * block stays untouched — the new block is appended, never replacing
 * (Decision 3 contract).
 *
 * No page-level module script. The Hero secondary CTA, Pricing tertiary
 * trigger, and Accordion all consume the Invokers polyfill loaded
 * transitively by `BaseLayout`'s `@tailwindplus/elements` import; the
 * Pricing SegmentedControl is pure CSS via `:has()`. ADR-0026 does not
 * apply because there is no script to bootstrap.
 */
import Breadcrumb from '~/components/navigation/Breadcrumb.astro';
import ProcessSteps from '~/components/sections/howItWorks/ProcessSteps.astro';
import QuizModal from '~/components/sections/quiz/QuizModal.astro';
import SessionConfigurator from '~/components/sections/services/SessionConfigurator.astro';
import ServiceDetailHero from '~/components/sections/services/ServiceDetailHero.astro';
import ServicePricingBlock from '~/components/sections/services/ServicePricingBlock.astro';
import ServiceSocialProof from '~/components/sections/services/ServiceSocialProof.astro';
import ServiceWhatsIncluded from '~/components/sections/services/ServiceWhatsIncluded.astro';
import ServiceWhoIsFor from '~/components/sections/services/ServiceWhoIsFor.astro';
import Accordion from '~/components/ui/Accordion.astro';
import { processSteps } from '~/data/howItWorks';
import { routes } from '~/data/routes';
import {
  categoriesById,
  type ServiceWithCompleteDetailContent,
  serviceDetailHref,
} from '~/data/services';
import { siteConfig } from '~/data/site';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { buildServiceSchema } from '~/utils/serviceSchema';

export { getServiceSlugPaths as getStaticPaths } from '~/utils/serviceSlugPaths';

// Re-exporting `getStaticPaths` from a helper module breaks Astro's
// automatic prop inference for `Astro.props`. Declaring `Props` here
// restores the typed narrowing that `hasCompleteDetailContent` already
// performs inside the helper, so `service.category` is `ServiceCategory`
// rather than `any` at every consumer below.
type Props = { service: ServiceWithCompleteDetailContent };

const { service } = Astro.props;

// Caller-resolved category label for the hero eyebrow — mirrors the
// `programLabel` precedent from `success-stories/[slug]`. The hero stays
// decoupled from the categories module; this page owns the lookup. Direct
// record access on `categoriesById` (the `as const satisfies
// Record<ServiceCategory, CategoryInfo>` lookup table from `~/data/services`)
// is total at compile time — no runtime fallback needed.
const categoryLabel = categoriesById[service.category].name;

// `BaseHead` appends `siteConfig.name` to the page title with a ` | ` separator,
// so this carries only the page-specific portion. Matches the
// `success-stories/[slug]` precedent.
const pageTitle = service.name;
const pageDescription = service.lead;

// Trailing slash mirrors `formatCanonicalURL` in `SEO.astro`, which appends one
// to query-less canonical URLs. Aligning here keeps `Service.url` and
// `WebPage.url` byte-identical in the emitted HTML; extracting the canonicaliser
// from `SEO.astro` for shared use is a separate concern.
const serviceSchema = buildServiceSchema({
  service,
  organizationName: siteConfig.name,
  serviceUrl: new URL(`${serviceDetailHref(service.id)}/`, Astro.site).toString(),
});
---

<BaseLayout title={pageTitle} description={pageDescription} additionalJsonLd={[serviceSchema]}>
  {
    /* Section rhythm — Hero (default) → WhoIsFor (muted) → WhatsIncluded
       + ProcessSteps form a deliberate `default` substance block (the
       "what" plus the "how"), then SocialProof + FAQ run on `muted` as
       supportive evidence, and Pricing closes on `default` as the
       conversion stage. ServiceSocialProof returns null when no
       testimonials resolve; the empty state collapses rows 5+6 to a
       single muted band, keeping the site-wide "no three identical
       backgrounds in a row" discipline intact. */
  }
  <Breadcrumb
    trail={[{ label: 'Services', href: `${routes.services}#${service.category}` }]}
    current={service.name}
  />

  <ServiceDetailHero service={service} categoryLabel={categoryLabel} />

  {
    service.pricingModel === 'subscription' && (
      <>
        <ServiceWhoIsFor service={service} />

        <ServiceWhatsIncluded service={service} />

        <ProcessSteps
          steps={service.processStepsOverride ?? processSteps}
          size="compact"
          background="default"
          eyebrow=""
        />

        <ServiceSocialProof service={service} />

        <Accordion items={service.faq} exclusive={false} />

        <ServicePricingBlock service={service} />
      </>
    )
  }

  {
    service.pricingModel === 'session' && (
      <>
        <ProcessSteps
          steps={service.processStepsOverride ?? processSteps}
          size="compact"
          background="default"
          eyebrow=""
        />

        <ServiceSocialProof service={service} />

        <SessionConfigurator service={service} />
      </>
    )
  }

  <QuizModal />
</BaseLayout>
