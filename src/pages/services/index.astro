---
/**
 * Services overview page.
 * Showcases all coaching services organized by category with tab navigation.
 */
import HeroFullscreen from '~/components/sections/HeroFullscreen.astro';
import QuizModal from '~/components/sections/quiz/QuizModal.astro';
import ServicesCatalog from '~/components/sections/services/ServicesCatalog.astro';
import Cta from '~/components/ui/CTA.astro';
import { routes, servicesAnchors } from '~/data/routes';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { remoteImage } from '~/types/components';

// Option A: Video background
// Make sure the video is located in public/videos/
// const heroBackground = {
//   type: 'video' as const,
//   src: '/videos/services-hero.mp4',
// };

// Option B: Image background (remote URL with dimensions)
const heroBackground = {
  type: 'image' as const,
  src: remoteImage('https://placehold.co/1920x1080/4a9199/f7eee5?text=Services+Hero', 1920, 1080),
  alt: 'Athletes training',
};

// Option C: Local image (if available)
// import heroImage from '~/assets/images/services-hero.jpg';
// const heroBackground = {
//   type: 'image' as const,
//   src: { kind: 'local' as const, src: heroImage },
//   alt: 'Athletes training',
// };
---

<BaseLayout
  title="Services"
  description="From competition prep to lifestyle transformation. Choose your path and train with IFBB Pro champions."
  headerVariant="on-dark"
>
  <HeroFullscreen
    headline="Everything You Need to Reach Your Next Level"
    primaryCta={{ label: 'Take the Quiz', type: 'modal', modalId: 'quiz-modal' }}
    secondaryCta={{ label: 'Browse Our Services', href: servicesAnchors.categories }}
    background={heroBackground}
  >
    <p>
      From competition prep to lifestyle transformation. Choose your path and train with
      <strong>IFBB Pro champions</strong>.
    </p>
  </HeroFullscreen>

  {/* Categories Section with Filter */}
  <ServicesCatalog id="categories" headline="Our Services">
    <p class="text-foreground-700 text-left text-lg text-pretty sm:text-xl/8 dark:text-gray-400">
      Whether you're pushing past a plateau, coming back stronger after a break, or preparing for
      the stage — you're working with a team, not a single coach. When you book with Team 4 Pro,
      three IFBB Pro coaches collaborate behind the scenes to match you with the right coach for
      your goals, your body, and your life — and to adjust your plan when things change. Our
      programming accounts for what generic plans ignore: hormonal shifts, recovery needs, and the
      realities of training in a female body.
    </p>
    <p
      class="text-foreground-700 text-center text-lg font-medium text-pretty sm:text-xl/8 dark:text-gray-400"
    >
      Find the service that fits where you are right now.
    </p>
  </ServicesCatalog>

  {/* Bottom CTA */}
  <section class="bg-background-muted dark:bg-background-dark-muted px-6 py-16">
    <div class="mx-auto max-w-3xl">
      <Cta
        headline="Not Sure Which Service Is Right for You?"
        description="Take our quick quiz to get a personalized recommendation, or reach out directly—we're happy to help."
        primaryCta={{ label: 'Take the Quiz', type: 'modal', modalId: 'quiz-modal' }}
        secondaryCta={{ label: 'Contact Us', href: routes.contact }}
        headingLevel="h2"
        size="compact"
      />
    </div>
  </section>

  {/* Quiz Modal */}
  <QuizModal />
</BaseLayout>
