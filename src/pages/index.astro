---
import Coaches from '~/components/sections/Coaches.astro';
import Content from '~/components/sections/Content.astro';
import CoachDetailModal from '~/components/sections/coaches/CoachDetailModal.astro';
import HeroFullscreen from '~/components/sections/HeroFullscreen.astro';
import HeroSplit from '~/components/sections/HeroSplit.astro';
import QuizModal from '~/components/sections/quiz/QuizModal.astro';
import Services from '~/components/sections/Services.astro';
import Stats from '~/components/sections/Stats.astro';
import SuccessStories from '~/components/sections/SuccessStories.astro';
import ClientChatScreenshots from '~/components/sections/successStories/ClientChatScreenshots.astro';
import FeaturedTestimonial from '~/components/sections/successStories/FeaturedTestimonial.astro';
import SuccessStoryReadMoreModal from '~/components/sections/successStories/SuccessStoryReadMoreModal.astro';
import Usps from '~/components/sections/Usps.astro';
import CTA from '~/components/ui/CTA.astro';
import { clientChatScreenshots } from '~/data/clientChatScreenshots';
import { coachesExpanded, coachesSection } from '~/data/coaches';
import { finalCta } from '~/data/cta';
import { MODAL_IDS } from '~/data/ids';
import { homeAnchors, routes } from '~/data/routes';
import { getServicesByIds, servicesSection } from '~/data/services';
import { statsSection } from '~/data/stats';
import { successStoriesById, successStoriesSection } from '~/data/successStories';
import { usps, uspsSection } from '~/data/usps';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { sectionBackground } from '~/styles/sectionStyles';
import { remoteImage } from '~/types/components';

const heroImage = remoteImage(
  'https://placehold.co/1280x1067/4a9199/f7eee5?text=Coach+Video',
  1280,
  1067,
);
const strugglesImage = remoteImage(
  'https://placehold.co/1280x720/4a9199/f7eee5?text=Behind+the+Scenes',
  1280,
  720,
);
// Placeholder poster for the in-production banner — swapped for the real
// video frame the moment the production lands. Sized for a wide banner crop.
const bannerPosterImage = remoteImage(
  'https://placehold.co/1920x1080/1a1a1a/f7eee5?text=Coaches+On+Set',
  1920,
  1080,
);
const quizCta = {
  headline: 'Not Sure Which Program Is Right for You?',
  description:
    "Take our quick 2-minute quiz and we'll match you with the perfect coaching program based on your goals, experience level, and lifestyle.",
  primaryCta: {
    label: 'Find Your Fit',
    type: 'modal' as const,
    modalId: MODAL_IDS.quiz,
  },
};
const highlightedServices = getServicesByIds(servicesSection.highlightedServiceIds);
const highlightedSuccessStories = successStoriesSection.highlightedSuccessStoryIds.map(
  (id) => successStoriesById[id],
);
---

<BaseLayout headerVariant="on-dark">
  <HeroFullscreen
    headline="In production"
    headlineStyle="pill"
    headingLevel="h2"
    class="min-h-[60vh] md:min-h-[70vh]"
    background={{
      type: 'image',
      src: bannerPosterImage,
      alt: 'Team 4 Pro coaches on set during the upcoming production',
    }}
    secondaryCta={{ label: 'Meet our coaches', href: homeAnchors.coaches }}
  >
    <p>Three IFBB Pro coaches. Real training. Full film coming.</p>
  </HeroFullscreen>

  <HeroSplit
    headline="Elite Coaching for serious women who demand results"
    primaryCta={{ label: 'Work With Us', href: routes.contact }}
    secondaryCta={{ label: 'Explore Services', href: homeAnchors.services }}
    image={{
      src: heroImage,
      alt: 'Team 4 Pro Coaches - Helle, Gina & Irene',
    }}
  >
    <p>
      Whether you're starting your fitness journey, building serious muscle, preparing for
      competition, or transforming your lifestyle – our <strong>IFBB Pro female coaches</strong>
      provide the expertise and support to achieve <strong>extraordinary results</strong>.
    </p>
  </HeroSplit>

  <Content
    headline="We Actually Get Your Struggles"
    background="muted"
    image={{
      src: strugglesImage,
      alt: 'Behind the scenes training with Team 4 Pro coaches',
    }}
  >
    <p>
      Struggling with body image while building muscle? <strong>Lived it.</strong> Period affecting your
      workouts? <strong>Been there.</strong> Balancing everything while staying consistent?
      <strong>That's our expertise.</strong> We don't just coach women – we
      <strong>ARE women</strong> who've mastered every challenge you're facing.
    </p>
  </Content>

  <Services
    id="services"
    headline={servicesSection.headline}
    intro={servicesSection.intro}
    services={highlightedServices}
    quizCta={quizCta}
    allServicesLink={servicesSection.allServicesLink}
    background="teal"
  />

  <Stats
    headline={statsSection.headline}
    stats={Object.values(statsSection.stats)}
    background="muted"
  >
    <p>
      Real results from <strong>real women</strong> who trusted us with their transformation journey.
    </p>
  </Stats>

  <Usps headline={uspsSection.headline} usps={usps} background="silver">
    {/* SAFETY: intro is statically defined in ~/data/usps.ts */}
    <p set:html={uspsSection.intro} />
  </Usps>

  <Coaches
    id="coaches"
    headline={coachesSection.headline}
    coaches={coachesExpanded}
    background="sage"
  >
    <p>
      Three <strong>IFBB Pro athletes</strong> who've been exactly where you are. We don't just coach
      – we <strong>understand</strong>.
    </p>
  </Coaches>

  {
    /* Section rhythm — charcoal slider → muted filler → muted screenshots
       → default final CTA. The two consecutive `muted` blocks are the
       flag-off state (filler carries the section slot until real
       chat-screenshot assets land); when the screenshot array fills,
       the filler invocation is removed and the rhythm collapses to
       charcoal → muted → default. The screenshot section keeps
       `muted` either way — the seam below the slider needs the colour
       break, and `default` would re-merge with the final CTA below. */
  }
  <SuccessStories
    headline={successStoriesSection.headline}
    stories={highlightedSuccessStories}
    allStoriesLink={successStoriesSection.allStoriesLink}
    background="charcoal"
  >
    {/* SAFETY: intro is statically defined in ~/data/successStories.ts */}
    <p set:html={successStoriesSection.intro} />
  </SuccessStories>

  {/* Filler — interim until real client-chat screenshots land. */}
  <FeaturedTestimonial background="muted" />

  {/* Client-chat screenshots — renders nothing while the array is empty. */}
  <ClientChatScreenshots screenshots={clientChatScreenshots} background="muted" />

  <!-- Final CTA -->
  <div class:list={['px-6 py-24 sm:py-32 lg:px-8', sectionBackground.default]}>
    <div class="mx-auto max-w-4xl">
      <CTA
        headline={finalCta.headline}
        description={finalCta.description}
        primaryCta={finalCta.primaryCta}
        secondaryCta={finalCta.secondaryCta}
      />
    </div>
  </div>

  {/* Coach Detail Modal */}
  <CoachDetailModal coaches={coachesExpanded} />

  {/* Success Story Read-More Modal — populated client-side from triggers above */}
  <SuccessStoryReadMoreModal stories={highlightedSuccessStories} />

  {/* Quiz Modal */}
  <QuizModal />
</BaseLayout>
