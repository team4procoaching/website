---
import Content from '~/components/sections/Content.astro';
import Hero from '~/components/sections/Hero.astro';
import Services from '~/components/sections/Services.astro';
import { services, servicesSection } from '~/data/services';
import BaseLayout from '~/layouts/BaseLayout.astro';

const heroImage = 'https://placehold.co/1280x1067/4a9199/f7eee5?text=Coach+Video';
const strugglesImage = 'https://placehold.co/1280x720/4a9199/f7eee5?text=Behind+the+Scenes';
const quizCta = {
  headline: 'Not Sure Which Program Is Right for You?',
  description:
    "Take our quick 2-minute quiz and we'll match you with the perfect coaching program based on your goals, experience level, and lifestyle.",
  primaryCta: {
    label: 'Take the Quiz',
    href: '#',
  },
};
---

<BaseLayout>
  <Hero
    headline="Elite Coaching for serious women who demand results"
    primaryCta={{ label: 'Start with Team 4 Pro', href: '#contact' }}
    secondaryCta={{ label: 'Learn about our Services', href: '/services' }}
    image={{
      src: heroImage,
      alt: 'Team 4 Pro Coaches - Helle, Gina & Irene',
    }}
  >
    <p>
      Whether you're starting your fitness journey, building serious muscle, preparing for
      competition, or transforming your lifestyle – our <strong>IFBB Pro female coaches</strong>
      provide the expertise and support to achieve <strong>extraordinary results</strong>.
    </p>
  </Hero>

  <Content
    headline="We Actually Get Your Struggles"
    background="muted"
    image={{
      src: strugglesImage,
      alt: 'Behind the scenes training with Team 4 Pro coaches',
    }}
  >
    <p>
      Struggling with body image while building muscle? <strong>Lived it.</strong> Period affecting your
      workouts? <strong>Been there.</strong> Balancing everything while staying consistent?
      <strong>That's our expertise.</strong> We don't just coach women – we
      <strong>ARE women</strong> who've mastered every challenge you're facing.
    </p>
  </Content>

  <Services
    headline={servicesSection.headline}
    intro={servicesSection.intro}
    services={services}
    quizCta={quizCta}
    allServicesLink={servicesSection.allServicesLink}
  />
</BaseLayout>
