---
/**
 * Individual success story detail page.
 * Uses Astro Content Collection for data and MDX for story body.
 *
 * Sections:
 * 1. Back link — "← Back to Success Stories"
 * 2. Story header — Portrait, name, transformation, stats tiles (program, duration, coach)
 * 3. Before/After — Large responsive images (stacked mobile, side-by-side desktop)
 * 4. Pull quote — Client testimonial quote
 * 5. Story body — MDX content rendered with prose styling
 * 6. CTA — "Ready to Write Your Success Story?"
 * 7. Prev/Next navigation — Links to adjacent stories + "View all stories"
 */
import { render } from 'astro:content';
import BeforeAfterImages from '~/components/sections/successStories/BeforeAfterImages.astro';
import StoryHeader from '~/components/sections/successStories/StoryHeader.astro';
import StoryNavigation from '~/components/sections/successStories/StoryNavigation.astro';
import Cta from '~/components/ui/CTA.astro';
import PullQuote from '~/components/ui/PullQuote.astro';
import { getCoachById } from '~/data/coaches';
import { getSortedStories } from '~/data/successStories';
import BaseLayout from '~/layouts/BaseLayout.astro';

// Generate static paths for all stories
export async function getStaticPaths() {
  const stories = await getSortedStories();

  return stories.map((story, index) => ({
    params: { slug: story.id },
    props: {
      story,
      previousStory: stories[index - 1] ?? null,
      nextStory: stories[index + 1] ?? null,
    },
  }));
}

const { story, previousStory, nextStory } = Astro.props;
const { Content } = await render(story);

const coach = getCoachById(story.data.coach);
---

<BaseLayout
  title={`${story.data.name} — ${story.data.transformation}`}
  description={story.data.quote}
>
  <article class="bg-background dark:bg-background-dark">
    {/* 1. Back link — pt-24 clears the absolute-positioned header */}
    <div class="mx-auto max-w-4xl px-6 pt-24 lg:px-8" data-animate="fade-left">
      <a
        href="/success-stories"
        class="text-foreground-950 hover:text-foreground-700 text-sm/6 font-semibold transition-colors dark:text-white dark:hover:text-gray-300"
      >
        <span aria-hidden="true">&larr;</span> Back to Success Stories
      </a>
    </div>

    {/* 2. Story header */}
    <section class="mx-auto max-w-4xl px-6 pt-10 pb-12 lg:px-8" data-animate="fade-up">
      <StoryHeader
        name={story.data.name}
        transformation={story.data.transformation}
        program={story.data.program}
        duration={story.data.duration}
        coachName={coach.name}
        portrait={story.data.portrait}
      />
    </section>

    {/* 3. Before/After large */}
    <section
      class="bg-background-muted dark:bg-background-dark-muted px-6 py-16 lg:px-8"
      aria-label="Before and after transformation"
    >
      <div class="mx-auto max-w-5xl" data-animate="fade-up">
        <BeforeAfterImages
          name={story.data.name}
          beforeImage={story.data.beforeImage}
          afterImage={story.data.afterImage}
          width={800}
          height={1000}
          layout="full"
        />
      </div>
    </section>

    {/* 4. Pull quote */}
    <section class="mx-auto max-w-3xl px-6 py-16 lg:px-8" data-animate="scale">
      <PullQuote variant="large" cite={story.data.name}>
        {story.data.quote}
      </PullQuote>
    </section>

    {/* 5. Story body (MDX) */}
    <section class="mx-auto max-w-3xl px-6 pb-16 lg:px-8" data-animate="fade-up">
      <div
        class="prose prose-lg dark:prose-invert prose-headings:font-serif prose-headings:text-foreground-950 dark:prose-headings:text-white prose-p:text-foreground-600 dark:prose-p:text-gray-400 prose-a:text-accent-600 dark:prose-a:text-accent-400 prose-strong:text-foreground-950 dark:prose-strong:text-white max-w-none"
      >
        <Content />
      </div>
    </section>

    {/* 6. CTA */}
    <section class="bg-background-muted dark:bg-background-dark-muted px-6 py-24 sm:py-32 lg:px-8">
      <div class="mx-auto max-w-3xl">
        <Cta
          headline="Ready to Write Your Success Story?"
          description="Whether you're preparing for competition, building muscle, or transforming your lifestyle — we're here to guide every step of your journey."
          primaryCta={{ label: 'Start Your Transformation', href: '/contact' }}
          secondaryCta={{ label: 'Explore Services', href: '/services' }}
          size="compact"
          headingLevel="h2"
        />
      </div>
    </section>

    {/* 7. Prev/Next navigation */}
    <div class="mx-auto max-w-4xl px-6 pb-16 lg:px-8">
      <StoryNavigation
        previousStory={previousStory
          ? {
              slug: previousStory.id,
              name: previousStory.data.name,
              transformation: previousStory.data.transformation,
            }
          : undefined}
        nextStory={nextStory
          ? {
              slug: nextStory.id,
              name: nextStory.data.name,
              transformation: nextStory.data.transformation,
            }
          : undefined}
      />
    </div>
  </article>
</BaseLayout>
