---
import type { NavItem } from '~/data/navigation';
import NavLink from './NavLink.astro';

type Props = {
  /** Navigation items to display */
  items: NavItem[];
};

const { items } = Astro.props;
---

<div class="hidden lg:flex lg:gap-x-12">
  {
    items.map((item) => (
      <NavLink href={item.href} variant="desktop">
        {item.label}
      </NavLink>
    ))
  }
</div>
