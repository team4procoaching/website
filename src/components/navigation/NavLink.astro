---
/**
 * NavLink is the navigation-link primitive with automatic active-state
 * detection, supporting desktop / mobile and default / on-dark variants.
 *
 * @useWhen You are rendering a link inside DesktopMenu or MobileMenu and want
 *   `aria-current="page"` set automatically when the link's `href` matches the
 *   current URL.
 * @dontUseWhen You need a body-text link or a CTA — use a plain `<a>` or
 *   TextLink / Button; NavLink is navigation-specific and carries the
 *   active-underline treatment.
 * @relatedTo DesktopMenu — primary consumer for `variant="desktop"`.
 * @relatedTo MobileMenu — primary consumer for `variant="mobile"`.
 * @example
 * ```astro
 * <NavLink href="/services" variant="desktop" colorVariant="on-dark">Services</NavLink>
 * ```
 */
type Props = {
  /** Target URL */
  href: string;
  /** Visual variant */
  variant: 'desktop' | 'mobile';
  /** Color variant based on background */
  colorVariant?: 'default' | 'on-dark';
};

const { href, variant, colorVariant = 'default' } = Astro.props;
const isActive = Astro.url.pathname === href;

// Desktop classes based on color variant
const desktopClasses = {
  default:
    'animated-underline text-sm/6 font-semibold text-foreground-950 hover:text-foreground-700 dark:text-white dark:hover:text-gray-300 transition-colors',
  'on-dark':
    'animated-underline text-sm/6 font-semibold text-white hover:text-gray-300 transition-colors',
};

// Mobile classes (always in a panel with controlled background)
const mobileClasses =
  '-mx-3 block rounded-lg px-3 py-2 text-base/7 font-semibold text-foreground-950 hover:bg-foreground-50 dark:text-white dark:hover:bg-white/5';

const baseClasses = variant === 'desktop' ? desktopClasses[colorVariant] : mobileClasses;
---

<a href={href} class={baseClasses} aria-current={isActive ? 'page' : undefined}>
  <slot />
</a>
