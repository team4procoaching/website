---
/**
 * Navigation link with automatic active state detection.
 * Sets `aria-current="page"` when the link matches the current URL.
 * Supports desktop (inline) and mobile (block) visual variants.
 *
 * @example
 * ```astro
 * <!-- Desktop variant (inline, used in DesktopMenu) -->
 * <NavLink href="/services" variant="desktop">Services</NavLink>
 *
 * <!-- Mobile variant (block with hover background, used in MobileMenu) -->
 * <NavLink href="/services" variant="mobile">Services</NavLink>
 * ```
 */
type Props = {
  /** Target URL */
  href: string;
  /** Visual variant */
  variant: 'desktop' | 'mobile';
};

const { href, variant } = Astro.props;
const isActive = Astro.url.pathname === href;

const baseClasses =
  variant === 'desktop'
    ? 'text-sm/6 font-semibold text-foreground-950 hover:text-foreground-700 dark:text-white dark:hover:text-gray-300 transition-colors'
    : '-mx-3 block rounded-lg px-3 py-2 text-base/7 font-semibold text-foreground-950 hover:bg-foreground-50 dark:text-white dark:hover:bg-white/5';
---

<a href={href} class={baseClasses} aria-current={isActive ? 'page' : undefined}>
  <slot />
</a>
