---
import type { NavItem } from '~/data/navigation';
import type { LogoConfig } from '~/data/site';
import Logo from '../ui/Logo.astro';
import NavLink from './NavLink.astro';

type Props = {
  /** Site or brand name */
  siteName: string;
  /** Logo URLs for light/dark mode */
  logo: LogoConfig;
  /** Navigation items to display */
  items: NavItem[];
};

const { siteName, logo, items } = Astro.props;
---

<el-dialog>
  <dialog id="mobile-menu" aria-label="Main menu" class="backdrop:bg-transparent lg:hidden">
    <div tabindex="0" class="fixed inset-0 focus:outline-none">
      <el-dialog-panel
        class="bg-background sm:ring-primary-950/10 dark:bg-background-dark fixed inset-y-0 right-0 z-50 w-full overflow-y-auto p-6 sm:max-w-sm sm:ring-1 dark:sm:ring-gray-100/10"
      >
        <div class="flex items-center justify-between">
          <Logo name={siteName} logo={logo} />
          <button
            type="button"
            command="close"
            commandfor="mobile-menu"
            class="text-primary-950 hover:text-primary-700 -m-2.5 rounded-md p-2.5 transition-colors dark:text-gray-400 dark:hover:text-white"
          >
            <span class="sr-only">Close menu</span>
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
              class="size-6"
            >
              <path d="M6 18 18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>
        </div>
        <div class="mt-6 flow-root">
          <div class="divide-primary-950/10 -my-6 divide-y dark:divide-white/10">
            <div class="space-y-2 py-6">
              {
                items.map((item) => (
                  <NavLink href={item.href} variant="mobile">
                    {item.label}
                  </NavLink>
                ))
              }
            </div>
          </div>
        </div>
      </el-dialog-panel>
    </div>
  </dialog>
</el-dialog>
