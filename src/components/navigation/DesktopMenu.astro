---
/**
 * DesktopMenu is the horizontal large-screen navigation menu, hidden on mobile
 * via `hidden lg:flex`.
 *
 * @useWhen You are composing the site header and need a horizontal nav-link row
 *   for large screens (`lg:` and up).
 * @dontUseWhen You need the mobile slide-in menu variant — use MobileMenu,
 *   which renders inside a `<dialog>` and is hidden on `lg:` and up.
 * @alternativeTo MobileMenu — picked by breakpoint; both are typically rendered
 *   inside Header.
 * @relatedTo Header — primary consumer; Header pairs DesktopMenu with
 *   MobileMenu in the same nav.
 * @relatedTo NavLink — DesktopMenu renders one NavLink per item in
 *   `variant="desktop"`.
 * @example
 * ```astro
 * <DesktopMenu items={navigation} colorVariant="on-dark" />
 * ```
 */
import type { NavItem } from '~/data/navigation';
import NavLink from './NavLink.astro';

type Props = {
  /** Navigation items to display */
  items: readonly NavItem[];
  /** Color variant based on background */
  colorVariant?: 'default' | 'on-dark';
};

const { items, colorVariant = 'default' } = Astro.props;
---

<div class="hidden lg:flex lg:gap-x-12">
  {
    items.map((item) => (
      <NavLink href={item.href} variant="desktop" colorVariant={colorVariant}>
        {item.label}
      </NavLink>
    ))
  }
</div>
