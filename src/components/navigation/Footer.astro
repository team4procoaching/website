---
/**
 * Footer is the centered site-footer primitive with flat navigation links,
 * social icons, and copyright, on the charcoal section background.
 *
 * @useWhen You are composing the site layout and need the bottom-of-page footer
 *   with social-icon row and copyright line.
 * @dontUseWhen You need a section-level CTA panel — use CTA, which has the
 *   headline / description / action chrome; Footer is for site-wide bottom
 *   content.
 * @relatedTo BaseLayout — primary consumer; Footer is rendered at the bottom of
 *   every page from the `src/layouts/BaseLayout.astro` shell.
 * @source tailwindplus
 *
 * Based on Tailwind UI "Simple centered" footer block.
 *
 * @example
 * ```astro
 * <Footer
 *   social={siteConfig.social}
 *   footerLinks={navigationConfig.footer}
 *   copyright={siteConfig.copyright}
 * />
 * ```
 */
import type { NavItem } from '~/data/navigation';
import type { SocialLink } from '~/data/site';
import { sectionBackground } from '~/styles/sectionStyles';

type Props = {
  /** Social media links */
  social: readonly SocialLink[];
  /** Footer navigation links (flat list) */
  footerLinks: readonly NavItem[];
  /** Copyright text */
  copyright: string;
};

const { social, footerLinks, copyright } = Astro.props;

// Filter out social links with placeholder href (e.g. '#' for upcoming YouTube channel)
const activeSocial = social.filter((s) => s.href !== '#');
---

<footer class:list={[sectionBackground.charcoal]}>
  <div class="mx-auto max-w-7xl overflow-hidden px-6 py-20 sm:py-24 lg:px-8">
    {/* Navigation links */}
    <nav aria-label="Footer" class="-mb-6 flex flex-wrap justify-center gap-x-12 gap-y-3 text-sm/6">
      {
        footerLinks.map((link) => (
          <a
            href={link.href}
            class="text-white/70 transition-colors hover:text-white dark:text-gray-400 dark:hover:text-white"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    {/* Social icons */}
    {
      activeSocial.length > 0 && (
        <div class="mt-16 flex justify-center gap-x-10">
          {activeSocial.map((item) => (
            <a
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-white/70 transition-colors hover:text-white dark:text-gray-400 dark:hover:text-white"
            >
              <span class="sr-only">{item.name}</span>
              {/* SAFETY: icon SVG path is statically defined in ~/data/site.ts via ~/data/icons.ts */}
              <svg
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
                class="size-6"
                set:html={item.icon}
              />
            </a>
          ))}
        </div>
      )
    }

    {/* Copyright */}
    <p class="mt-10 text-center text-sm/6 text-white/50 dark:text-gray-400">
      {copyright}
    </p>
  </div>
</footer>
