---
/**
 * Site header with logo and responsive navigation.
 * Renders DesktopMenu (hidden on mobile) and MobileMenu (dialog-based, hidden on desktop).
 * Positioned absolutely over page content for overlay-style hero sections.
 *
 * @example
 * ```astro
 * <!-- On light background (default, e.g., HeroSplit) -->
 * <Header
 *   siteName={siteConfig.name}
 *   logo={siteConfig.logo}
 *   navigation={navigation}
 * />
 *
 * <!-- On dark background (e.g., HeroFullscreen with video) -->
 * <Header
 *   siteName={siteConfig.name}
 *   logo={siteConfig.logo}
 *   navigation={navigation}
 *   variant="on-dark"
 * />
 * ```
 */
import DesktopMenu from '~/components/navigation/DesktopMenu.astro';
import MobileMenu from '~/components/navigation/MobileMenu.astro';
import Logo from '~/components/ui/Logo.astro';
import type { NavItem } from '~/data/navigation';
import type { LogoConfig } from '~/data/site';

type Props = {
  /** Site or brand name */
  siteName: string;
  /** Logo URLs for light/dark mode */
  logo: LogoConfig;
  /** Navigation items */
  navigation: readonly NavItem[];
  /** Color variant based on page background */
  variant?: 'default' | 'on-dark';
};

const { siteName, logo, navigation, variant = 'default' } = Astro.props;

// Mobile menu button classes based on variant
const mobileButtonClasses = {
  default:
    '-m-2.5 inline-flex items-center justify-center rounded-md p-2.5 text-foreground-950 hover:text-foreground-700 transition-colors dark:text-gray-400 dark:hover:text-white',
  'on-dark':
    '-m-2.5 inline-flex items-center justify-center rounded-md p-2.5 text-white hover:text-gray-300 transition-colors',
};
---

<header class="absolute inset-x-0 top-0 z-50">
  <nav aria-label="Global" class="mx-auto flex max-w-7xl items-center justify-between p-6 lg:px-8">
    <Logo name={siteName} logo={logo} variant={variant} />
    <div class="flex lg:hidden">
      <button
        type="button"
        command="show-modal"
        commandfor="mobile-menu"
        class={mobileButtonClasses[variant]}
      >
        <span class="sr-only">Open main menu</span>
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
          class="size-6"
        >
          <path
            d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>
    <DesktopMenu items={navigation} colorVariant={variant} />
  </nav>
  <MobileMenu siteName={siteName} logo={logo} items={navigation} />
</header>
