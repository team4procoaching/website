---
/**
 * TestimonialCard is the single-quote testimonial card for grid layouts, with
 * featured variant (larger text, border separator) controlled by
 * `testimonial.featured`.
 *
 * @useWhen You are rendering a testimonial inside a grid, list, or single-card
 *   surface and need the consistent card chrome with quote + name + title +
 *   avatar.
 * @dontUseWhen You need a hero-scale testimonial section with a side image —
 *   use Testimonial, which has the overlapping client image and decorative
 *   quote-marks.
 * @alternativeTo Testimonial — pick Testimonial for a single high-impact
 *   section; TestimonialCard is for grid contexts.
 * @relatedTo TestimonialGrid — primary consumer.
 * @relatedTo ServiceSocialProof — secondary consumer.
 * @relatedTo FeaturedTestimonial — secondary consumer (renders one card for the
 *   homepage bridge section).
 * @adr ADR-0010
 * @example
 * ```astro
 * <TestimonialCard testimonial={testimonial} />
 * ```
 */
import type { Testimonial } from '~/data/testimonials';

type Props = {
  /** Testimonial data */
  testimonial: Testimonial;
};

const { testimonial } = Astro.props;
const isFeatured = testimonial.featured === true;
---

<figure
  class="ring-foreground-950/5 rounded-2xl bg-white shadow-lg ring-1 dark:bg-white/5 dark:shadow-none dark:ring-white/10"
>
  <blockquote
    class:list={[
      'text-foreground-950 dark:text-white',
      isFeatured ? 'p-6 text-lg font-semibold tracking-tight sm:p-12 sm:text-xl/8' : 'p-6',
    ]}
  >
    <p>&ldquo;{testimonial.quote}&rdquo;</p>
  </blockquote>
  <figcaption
    class:list={[
      'flex items-center gap-x-4 px-6 py-4',
      isFeatured
        ? 'border-foreground-950/10 flex-wrap gap-y-4 border-t sm:flex-nowrap dark:border-white/10'
        : 'mt-2',
    ]}
  >
    {/* Small decorative avatar (≤ 64px) — plain <img> per ADR-0010 */}
    <img
      src={testimonial.avatar}
      alt=""
      width="40"
      height="40"
      loading="lazy"
      decoding="async"
      class="bg-foreground-50 size-10 flex-none rounded-full dark:bg-white/10"
    />
    <div class="flex-auto">
      <div class="text-foreground-950 font-semibold dark:text-white">
        {testimonial.name}
      </div>
      <div class="text-foreground-600 dark:text-gray-400">
        {testimonial.title}
      </div>
    </div>
  </figcaption>
</figure>
