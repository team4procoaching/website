---
/**
 * Before/after image comparison grid with labeled overlays.
 * Shared by SuccessStoryCard (homepage slider) and SuccessStoryGridCard
 * (overview grid). Always renders side-by-side in a compact 2-column layout.
 *
 * Uses SmartImage to support both remote URLs and local imported assets
 * via the ImageSource discriminated union (ADR-0010).
 *
 * @example
 * ```astro
 * <BeforeAfterImages
 *   name="Sarah M."
 *   beforeImage={remoteImage('https://...', 800, 1000)}
 *   afterImage={remoteImage('https://...', 800, 1000)}
 * />
 * ```
 */
import SmartImage from '~/components/ui/SmartImage.astro';
import type { ImageSource } from '~/types/components';

type Props = {
  /** Client name for alt text */
  name: string;
  /** Before transformation image */
  beforeImage: ImageSource;
  /** After transformation image */
  afterImage: ImageSource;
};

const { name, beforeImage, afterImage } = Astro.props;
---

<div class="grid grid-cols-2">
  <div class="relative">
    <SmartImage
      src={beforeImage}
      alt={`${name} before transformation`}
      loading="lazy"
      class="aspect-4/5 w-full object-cover"
    />
    <span
      class="bg-foreground-950/70 absolute bottom-2 left-2 rounded px-2 py-1 text-xs font-medium text-white"
    >
      Before
    </span>
  </div>
  <div class="relative">
    <SmartImage
      src={afterImage}
      alt={`${name} after transformation`}
      loading="lazy"
      class="aspect-4/5 w-full object-cover"
    />
    <span
      class="bg-accent-600 absolute right-2 bottom-2 rounded px-2 py-1 text-xs font-medium text-white"
    >
      After
    </span>
  </div>
</div>
