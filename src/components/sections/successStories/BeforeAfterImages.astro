---
/**
 * BeforeAfterImages is the side-by-side before / after image grid with labelled
 * overlay tags, shared by every success-story card variant.
 *
 * @useWhen You are composing a success-story card or detail-page hero and need
 *   the 2-column before/after pair with "Before" / "After" overlay labels.
 * @dontUseWhen You need a single image — use SmartImage; BeforeAfterImages is
 *   paired-image-specific.
 * @relatedTo SmartImage — internal renderer for both image slots.
 * @relatedTo SuccessStoryGridCard — primary consumer.
 * @relatedTo SuccessStoryOverviewCard — primary consumer.
 * @relatedTo SuccessStoryHero — composes the larger variant for the detail-page
 *   hero.
 * @adr ADR-0010
 *
 * Always renders side-by-side in a compact 2-column layout.
 *
 * Uses SmartImage to support both remote URLs and local imported assets
 * via the ImageSource discriminated union (ADR-0010).
 *
 * @example
 * ```astro
 * <BeforeAfterImages
 *   name="Sarah M."
 *   beforeImage={remoteImage('https://...', 800, 1000)}
 *   afterImage={remoteImage('https://...', 800, 1000)}
 * />
 * ```
 */
import SmartImage from '~/components/ui/SmartImage.astro';
import type { ImageSource } from '~/types/components';

type Props = {
  /** Client name for alt text */
  name: string;
  /** Before transformation image */
  beforeImage: ImageSource;
  /** After transformation image */
  afterImage: ImageSource;
};

const { name, beforeImage, afterImage } = Astro.props;
---

<div class="grid grid-cols-2">
  <div class="relative">
    <SmartImage
      src={beforeImage}
      alt={`${name} before transformation`}
      loading="lazy"
      class="aspect-4/5 w-full object-cover"
    />
    <span
      class="bg-foreground-950/70 absolute bottom-2 left-2 rounded px-2 py-1 text-xs font-medium text-white"
    >
      Before
    </span>
  </div>
  <div class="relative">
    <SmartImage
      src={afterImage}
      alt={`${name} after transformation`}
      loading="lazy"
      class="aspect-4/5 w-full object-cover"
    />
    <span
      class="bg-accent-600 absolute right-2 bottom-2 rounded px-2 py-1 text-xs font-medium text-white"
    >
      After
    </span>
  </div>
</div>
