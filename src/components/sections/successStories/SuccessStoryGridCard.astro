---
import { getCoachById } from '~/data/coaches';
/**
 * Success story card for the overview grid on /success-stories.
 * Shows before/after thumbnails, transformation headline, quote snippet,
 * and coach badge. Static display card — no link to a detail page.
 *
 * Distinct from SuccessStoryCard.astro (homepage slider) — this card
 * includes a quote preview, duration, and coach attribution, and is
 * designed for a responsive grid (not a horizontal scroll container).
 *
 * @example
 * ```astro
 * <SuccessStoryGridCard story={story} />
 * ```
 */
import type { SuccessStory } from '~/data/successStories';
import { programLabels } from '~/data/successStories';
import { getImageUrl } from '~/types/components';
import BeforeAfterImages from './BeforeAfterImages.astro';

type Props = {
  /** Success story data */
  story: SuccessStory;
};

const { story } = Astro.props;

const coach = getCoachById(story.coach);
const programLabel = programLabels[story.program];
---

<article
  class="ring-foreground-950/5 flex flex-col overflow-hidden rounded-2xl bg-white shadow-lg ring-1 dark:bg-white/5 dark:shadow-none dark:ring-white/10"
>
  {/* Before / After images */}
  <BeforeAfterImages
    name={story.name}
    beforeImage={story.beforeImage}
    afterImage={story.afterImage}
  />

  {/* Content */}
  <div class="flex flex-1 flex-col p-6">
    {/* Program badge */}
    <span
      class="mb-3 inline-flex w-fit rounded-full bg-teal-100 px-2.5 py-1 text-xs font-medium text-teal-700 dark:bg-teal-900/30 dark:text-teal-300"
    >
      {programLabel}
    </span>

    {/* Name & transformation */}
    <h3 class="text-foreground-950 text-base/7 font-semibold dark:text-white">
      {story.name}
    </h3>
    <p class="text-accent-600 dark:text-accent-400 mt-1 text-sm/6 font-medium">
      {story.transformation}
      <span class="text-foreground-500 dark:text-gray-500"> · {story.duration}</span>
    </p>

    {/* Quote snippet */}
    <p class="text-foreground-600 mt-3 line-clamp-3 flex-1 text-sm/6 dark:text-gray-400">
      &ldquo;{story.quote}&rdquo;
    </p>

    {/* Coach badge */}
    <div
      class="border-foreground-950/5 mt-4 flex items-center gap-x-3 border-t pt-4 dark:border-white/10"
    >
      {/* Small decorative avatar (≤ 64px) — plain <img> per ADR-0010 */}
      <img
        src={getImageUrl(coach.image)}
        alt={coach.name}
        width="32"
        height="32"
        loading="lazy"
        decoding="async"
        class="size-8 rounded-full object-cover"
      />
      <div class="text-sm">
        <span class="text-foreground-950 font-medium dark:text-white">{coach.name}</span>
        <span class="text-foreground-500 dark:text-gray-500"> · Coach</span>
      </div>
    </div>
  </div>
</article>
