---
/**
 * Success-story card for the related-stories row on
 * `/success-stories/[slug]`.
 *
 * Five-zone layout (top to bottom):
 * 1. Before/after images (via {@link BeforeAfterImages})
 * 2. Service-discovery pill (via {@link SuccessStoryServiceBadge}) —
 *    routes to the service detail page when
 *    {@link hasCompleteDetailContent} returns true, else to the
 *    service's contact-form prefill.
 * 3. Client name + transformation summary
 * 4. Quote teaser (`line-clamp-3`)
 * 5. Coach attribution + primary foot button — the button renders only
 *    when {@link hasDetailPage} returns true; legacy stories without
 *    detail content display the card without the button (the static
 *    variant). The visible label personalises on the client first name
 *    via {@link getFirstName}, falling back to a generic template
 *    when the helper returns null so the rendered output stays
 *    grammatical for every input shape.
 *
 * Two precision targets per card: the pill (top, navigates to the
 * service) and the foot button (bottom, navigates to the story detail
 * page). No card-level click-anywhere surface — the previous stretched
 * link via the `::before` pseudo has been removed in favour of explicit
 * affordances.
 *
 * Distinct from {@link SuccessStoryOverviewCard} (homepage slider and
 * `/success-stories` overview grid): the overview card carries the
 * read-more popup trigger and suppresses the detail-page link, while
 * this grid card is the inverse — detail-page link, no popup. Two
 * surfaces, two card components per ADR-0034.
 *
 * @example
 * ```astro
 * <SuccessStoryGridCard story={story} />
 * ```
 */
import Button from '~/components/ui/Button.astro';
import { getCoachById } from '~/data/coaches';
import type { SuccessStory } from '~/data/successStories';
import { hasDetailPage, successStoryDetailHref } from '~/data/successStories';
import { getFirstName } from '~/utils/getFirstName';
import BeforeAfterImages from './BeforeAfterImages.astro';
import SuccessStoryCardBody from './SuccessStoryCardBody.astro';

type Props = {
  /** Success story data */
  story: SuccessStory;
};

const { story } = Astro.props;

const coach = getCoachById(story.coach);
const detailHref = hasDetailPage(story) ? successStoryDetailHref(story.slug) : null;

const firstName = getFirstName(story.name);
const buttonLabel =
  firstName !== null ? `Read ${firstName}'s full story →` : 'Read the full story →';
---

<article
  class="hover-scale ring-foreground-950/5 flex flex-col overflow-hidden rounded-2xl bg-white shadow-lg ring-1 dark:bg-white/5 dark:shadow-none dark:ring-white/10"
>
  <BeforeAfterImages
    name={story.name}
    beforeImage={story.beforeImage}
    afterImage={story.afterImage}
  />

  <SuccessStoryCardBody story={story} attribution={{ name: coach.name, image: coach.image }}>
    {
      detailHref && (
        <div class="mt-4">
          <Button
            as="a"
            href={detailHref}
            variant="primary"
            class="relative z-10 w-full justify-center"
          >
            {buttonLabel}
          </Button>
        </div>
      )
    }
  </SuccessStoryCardBody>
</article>
