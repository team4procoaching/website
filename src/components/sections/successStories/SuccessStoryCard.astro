---
/**
 * Success story card with before/after images and transformation details.
 * Designed for use in horizontal slider layouts.
 *
 * @example
 * ```astro
 * <SuccessStoryCard story={story} />
 * <SuccessStoryCard story={story} darkBackground />
 * ```
 */
import type { SuccessStory } from '~/data/successStories';
import { programLabels } from '~/data/successStories';
import BeforeAfterImages from './BeforeAfterImages.astro';

type Props = {
  /** Success story data */
  story: SuccessStory;
  /** Whether the card sits on a dark section background */
  darkBackground?: boolean;
};

const { story, darkBackground = false } = Astro.props;

const cardClasses = darkBackground
  ? 'bg-white shadow-xl w-80 shrink-0 snap-start scroll-ml-6 overflow-hidden rounded-2xl sm:w-96 lg:scroll-ml-8 dark:bg-white/5 dark:shadow-none dark:ring-1 dark:ring-white/10'
  : 'bg-foreground-950/5 w-80 shrink-0 snap-start scroll-ml-6 overflow-hidden rounded-2xl sm:w-96 lg:scroll-ml-8 dark:bg-white/5';
---

<article class={cardClasses}>
  <BeforeAfterImages
    name={story.name}
    beforeImage={story.beforeImage}
    afterImage={story.afterImage}
  />

  <div class="p-6">
    <h3 class="text-foreground-950 text-base/7 font-semibold dark:text-white">
      {story.name}
    </h3>
    <p class="text-accent-600 dark:text-accent-400 mt-1 text-sm/6 font-medium">
      {story.transformation}
    </p>
    <p class="text-foreground-600 mt-1 text-sm/6 dark:text-gray-400">
      {programLabels[story.program]}
    </p>
  </div>
</article>
