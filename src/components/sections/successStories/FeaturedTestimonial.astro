---
/**
 * FeaturedTestimonial is the single-voice testimonial section for the homepage
 * bridge position between the success-stories slider and the final CTA.
 *
 * @useWhen You are composing the homepage and need a bridge section that does
 *   not visually collapse while `ClientChatScreenshots` is empty (chat assets
 *   pending).
 * @dontUseWhen The chat-screenshot assets have landed and ClientChatScreenshots
 *   renders — FeaturedTestimonial is the bridge; remove it when the real
 *   surface is live.
 * @alternativeTo ClientChatScreenshots — sibling bridge-section; one or the
 *   other ships on the homepage at a time.
 * @alternativeTo TestimonialGrid — pick TestimonialGrid for the 7-quote
 *   balanced layout on a standalone testimonials page; FeaturedTestimonial is
 *   the single-card homepage variant.
 * @relatedTo Content — composition base.
 * @relatedTo TestimonialCard — renders the picked testimonial.
 *
 * The wording — headline "One client, in her own words" and CTA
 * "Read more client voices" — frames the section as a deliberate
 * single-voice curation, not a generic filler. The single-card layout
 * over a multi-card slider is a deliberate conversion-led choice: a
 * second slider directly under the success-stories slider would
 * compete with it. Do not migrate this to a slider on reflex.
 *
 * Picks the testimonial via the existing `featured: true` flag on
 * `~/data/testimonials.ts` (Tina R. today). Falls back to
 * `testimonials[0]` if no featured pick is set, defending against a
 * future rotation that drops the flag without choosing a successor.
 * When real screenshot assets land, the call-site removes this
 * invocation from `index.astro`; the component stays available for
 * any future surface that wants the same one-voice shape.
 *
 * @example
 * ```astro
 * <FeaturedTestimonial background="muted" />
 * ```
 */
import Content from '~/components/sections/Content.astro';
import TextLink from '~/components/ui/TextLink.astro';
import { routes } from '~/data/routes';
import { testimonials } from '~/data/testimonials';
import { isDarkBackground, type SectionBackground } from '~/styles/sectionStyles';
import TestimonialCard from './TestimonialCard.astro';

type Props = {
  /** Background color variant — defaults to `muted` to seam with the slider above. */
  background?: SectionBackground;
};

const { background = 'muted' } = Astro.props;

// `as const satisfies readonly Testimonial[]` narrows each entry to a
// distinct literal type, so the optional `featured` field is absent on
// entries that don't carry it. Use the property-presence check rather
// than `t.featured === true`, which TypeScript rejects on the narrow
// types.
const featuredTestimonial =
  testimonials.find((t) => 'featured' in t && t.featured === true) ?? testimonials[0];
const isDark = isDarkBackground(background);
---

{
  featuredTestimonial && (
    <Content headline="One client, in her own words" background={background}>
      <p>
        The voice we keep coming back to — for the full picture, see all client voices on the
        success-stories page.
      </p>

      <Fragment slot="content">
        <div class="mx-auto mt-12 max-w-3xl" data-animate="fade-up">
          <TestimonialCard testimonial={featuredTestimonial} />
        </div>

        <div class="mt-10 text-center">
          <TextLink href={routes.successStories} variant={isDark ? 'light' : 'default'}>
            Read more client voices
          </TextLink>
        </div>
      </Fragment>
    </Content>
  )
}
