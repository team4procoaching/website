---
/**
 * Service-discovery pill rendered at the top of every success-story card.
 *
 * One typed component owns the pill markup, the routing derivation, the
 * `aria-label`, and the dark-mode tokens for both
 * {@link SuccessStoryOverviewCard} and {@link SuccessStoryGridCard}.
 * Routing branches on `hasCompleteDetailContent(service)` — eligible
 * services link to `serviceDetailHref(service.id)`, others fall back to
 * `service.contactHref` so visitors who tap the pill always land on a
 * useful page.
 *
 * The accessible name (`Read more about {name} coaching`) primes the
 * destination intent for screen readers; the visible label
 * `{name} ›` is the discovery affordance for sighted readers.
 *
 * @example
 * ```astro
 * <SuccessStoryServiceBadge service={getServiceById(story.serviceId)} />
 * ```
 */
import { hasCompleteDetailContent, type Service, serviceDetailHref } from '~/data/services';
import { SUCCESS_STORY_SERVICE_BADGE_CLASS } from './successStoryServiceBadgeClasses';

type Props = {
  /** The service this story is associated with — full record, not just an id. */
  service: Service;
};

const { service } = Astro.props;

const href = hasCompleteDetailContent(service)
  ? serviceDetailHref(service.id)
  : service.contactHref;
---

<a
  href={href}
  aria-label={`Read more about ${service.name} coaching`}
  class={SUCCESS_STORY_SERVICE_BADGE_CLASS}
>
  {service.name}
  <span aria-hidden="true">›</span>
</a>
