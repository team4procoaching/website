---
/**
 * SuccessStoryResultsGrid is the "what changed" results section on the
 * success-story detail page, wrapping Content with a StatsGrid for before /
 * after metrics.
 *
 * @useWhen You are composing a success-story detail page and need the results
 *   section with the before/after metrics in a stats grid.
 * @dontUseWhen You need generic stats inline inside another section — use
 *   StatsGrid directly; SuccessStoryResultsGrid is the standalone section
 *   wrapper for the results zone.
 * @relatedTo Content — composition base.
 * @relatedTo StatsGrid — rendered in Content's `content` slot.
 * @relatedTo SuccessStoryHero — sibling on the same detail page, with the
 *   process-strip metrics (no overlap per the three-zone numeric discipline
 *   rule).
 *
 * Wraps Content (headline landmark) around a StatsGrid carrying the
 * before/after metrics for the story. Callers pass the headline as a
 * resolved string (typically `sectionLabels.results`) so the component
 * is not coupled to the data module.
 *
 * Part of the three-zone numeric discipline: this grid carries
 * before/after metrics; the hero carries transformation + duration;
 * the hero footer carries process metrics. No metric appears in two
 * zones.
 *
 * @example
 * ```astro
 * <SuccessStoryResultsGrid
 *   headline={sectionLabels.results}
 *   results={story.detail.results}
 * />
 * ```
 */
import Content from '~/components/sections/Content.astro';
import StatsGrid from '~/components/ui/StatsGrid.astro';
import type { Stat } from '~/data/stats';

type Props = {
  /** Section headline (callers typically pass sectionLabels.results) */
  headline: string;
  /** Before/after comparison metrics */
  results: readonly Stat[];
};

const { headline, results } = Astro.props;
---

{
  /*
  Row 7 of the success-story detail rhythm relies on Content's 'default'
  background propagating here unchanged. Adding a background prop to this
  invocation silently moves row 7 off 'default' and breaks the rhythm
  invariant — the result grid would render on a different surface than
  the rhythm prescribes.
*/
}
<Content headline={headline}>
  <Fragment slot="content">
    <StatsGrid stats={results} class="mt-12" />
  </Fragment>
</Content>
