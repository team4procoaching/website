---
/**
 * Prev/next navigation for success story detail pages.
 * Based on Tailwind Plus "Pagination > Simple with border" block.
 *
 * Three-column layout: previous story (left), "View all stories" (center),
 * next story (right). On mobile, only arrows + labels without story details.
 * Empty space when no prev/next story exists (first/last story).
 *
 * @example
 * ```astro
 * <StoryNavigation
 *   previousStory={{ slug: 'sarah-m', name: 'Sarah M.', transformation: 'Lost 30lbs' }}
 *   nextStory={{ slug: 'amanda-r', name: 'Amanda R.', transformation: 'Gained 12lbs' }}
 * />
 * ```
 */

type StoryLink = {
  slug: string;
  name: string;
  transformation: string;
};

type Props = {
  /** Previous story in sequence (undefined if first story) */
  previousStory?: StoryLink;
  /** Next story in sequence (undefined if last story) */
  nextStory?: StoryLink;
};

const { previousStory, nextStory } = Astro.props;
---

<nav
  class="border-foreground-950/10 flex items-center justify-between border-t px-4 sm:px-0 dark:border-white/10"
  aria-label="Story navigation"
  data-animate="fade-up"
>
  {/* Previous story */}
  <div class="-mt-px flex w-0 flex-1">
    {
      previousStory && (
        <a
          href={`/success-stories/${previousStory.slug}`}
          class="text-foreground-500 hover:border-foreground-300 hover:text-foreground-700 group inline-flex items-center border-t-2 border-transparent pt-4 pr-1 text-sm font-medium transition-colors dark:text-gray-400 dark:hover:border-white/20 dark:hover:text-gray-200"
        >
          <svg
            viewBox="0 0 20 20"
            fill="currentColor"
            aria-hidden="true"
            class="text-foreground-400 mr-3 size-5 dark:text-gray-500"
          >
            <path
              d="M18 10a.75.75 0 0 1-.75.75H4.66l2.1 1.95a.75.75 0 1 1-1.02 1.1l-3.5-3.25a.75.75 0 0 1 0-1.1l3.5-3.25a.75.75 0 1 1 1.02 1.1l-2.1 1.95h12.59A.75.75 0 0 1 18 10Z"
              clip-rule="evenodd"
              fill-rule="evenodd"
            />
          </svg>
          <span>
            <span class="block">Previous</span>
            <span class="text-foreground-700 mt-0.5 hidden text-xs md:block dark:text-gray-300">
              {previousStory.name} · {previousStory.transformation}
            </span>
          </span>
        </a>
      )
    }
  </div>

  {/* Center: View all stories */}
  <div class="hidden md:-mt-px md:flex">
    <a
      href="/success-stories"
      class="text-foreground-500 hover:border-accent-400 hover:text-foreground-700 dark:hover:border-accent-400 inline-flex items-center border-t-2 border-transparent px-4 pt-4 text-sm font-medium transition-colors dark:text-gray-400 dark:hover:text-gray-200"
    >
      View all stories
    </a>
  </div>

  {/* Next story */}
  <div class="-mt-px flex w-0 flex-1 justify-end">
    {
      nextStory && (
        <a
          href={`/success-stories/${nextStory.slug}`}
          class="text-foreground-500 hover:border-foreground-300 hover:text-foreground-700 group inline-flex items-center border-t-2 border-transparent pt-4 pl-1 text-sm font-medium transition-colors dark:text-gray-400 dark:hover:border-white/20 dark:hover:text-gray-200"
        >
          <span class="text-right">
            <span class="block">Next</span>
            <span class="text-foreground-700 mt-0.5 hidden text-xs md:block dark:text-gray-300">
              {nextStory.name} · {nextStory.transformation}
            </span>
          </span>
          <svg
            viewBox="0 0 20 20"
            fill="currentColor"
            aria-hidden="true"
            class="text-foreground-400 ml-3 size-5 dark:text-gray-500"
          >
            <path
              d="M2 10a.75.75 0 0 1 .75-.75h12.59l-2.1-1.95a.75.75 0 1 1 1.02-1.1l3.5 3.25a.75.75 0 0 1 0 1.1l-3.5 3.25a.75.75 0 1 1-1.02-1.1l2.1-1.95H2.75A.75.75 0 0 1 2 10Z"
              clip-rule="evenodd"
              fill-rule="evenodd"
            />
          </svg>
        </a>
      )
    }
  </div>
</nav>
