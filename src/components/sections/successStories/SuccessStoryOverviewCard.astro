---
/**
 * Overview card for a success story — the homepage slider and the
 * `/success-stories` overview grid both render this component.
 *
 * Five-zone layout (top to bottom):
 * 1. Before/after images (via {@link BeforeAfterImages})
 * 2. Service-discovery pill (via {@link SuccessStoryServiceBadge}) —
 *    routes to the service detail page when
 *    {@link hasCompleteDetailContent} returns true, else to the
 *    service's contact-form prefill.
 * 3. Client name + transformation summary
 * 4. Quote teaser (`line-clamp-3`)
 * 5. Read-more button — renders only when `story.longTestimony` is set,
 *    triggering the shared read-more modal via the Invokers API
 *    (`command="show-modal" commandfor={MODAL_IDS.successStoryReadMore}`).
 *    The modal controller resolves the story payload via
 *    `data-success-story-id`. Visible label personalises on the client's
 *    first name (`Hear Sarah's full story →`) when the helper resolves
 *    one, falling back to a generic template (`Hear the full story →`)
 *    when it cannot — guaranteed grammatical for every input shape.
 *
 * Two precision targets per card: the pill (top, navigates to the
 * service) and the foot button (bottom, opens the long-form modal). No
 * card-level click-anywhere surface; the affordances are deliberately
 * distinguishable for sighted readers and tab-order users alike.
 *
 * Distinct from {@link SuccessStoryGridCard} (still used by the
 * `[slug]` related-stories row): this card carries the popup trigger
 * and suppresses the detail-page link, while the grid card is the
 * inverse — detail-page link, no popup. Two surfaces, two card
 * components per ADR-0034 (the differences are behavioural, not stylistic).
 *
 * @example
 * ```astro
 * <SuccessStoryOverviewCard story={story} />
 * <SuccessStoryOverviewCard story={story} darkBackground />
 * ```
 */
import Button from '~/components/ui/Button.astro';
import { MODAL_IDS } from '~/data/ids';
import type { SuccessStory } from '~/data/successStories';
import { getFirstName } from '~/utils/getFirstName';
import BeforeAfterImages from './BeforeAfterImages.astro';
import SuccessStoryCardBody from './SuccessStoryCardBody.astro';

type Props = {
  /** Success story data */
  story: SuccessStory;
  /** Whether the card sits on a dark section background (homepage slider) */
  darkBackground?: boolean;
};

const { story, darkBackground = false } = Astro.props;

const hasReadMore = story.longTestimony !== undefined;

const firstName = getFirstName(story.name);
const buttonLabel =
  firstName !== null ? `Hear ${firstName}'s full story →` : 'Hear the full story →';
const buttonAriaLabel =
  firstName !== null ? `Read ${firstName}'s full story` : 'Read the full story';

// Surface styling depends only on background context, not on layout
// (slider vs grid). Width is controlled by the parent: the slider's
// `<div data-card>` wrapper sets `w-80 sm:w-96`; the grid's `<li>` cell
// fills the column. The card itself fills its parent (`w-full`,
// `h-full`).
const cardClasses = darkBackground
  ? 'hover-scale flex flex-col w-full h-full overflow-hidden rounded-2xl bg-white shadow-xl dark:bg-white/5 dark:shadow-none dark:ring-1 dark:ring-white/10'
  : 'hover-scale flex flex-col w-full h-full overflow-hidden rounded-2xl bg-white shadow-lg ring-1 ring-foreground-950/5 dark:bg-white/5 dark:shadow-none dark:ring-white/10';
---

<article class={cardClasses}>
  <BeforeAfterImages
    name={story.name}
    beforeImage={story.beforeImage}
    afterImage={story.afterImage}
  />

  <SuccessStoryCardBody story={story}>
    {
      hasReadMore && (
        <div class="mt-4">
          <Button
            as="button"
            variant="primary"
            command="show-modal"
            commandfor={MODAL_IDS.successStoryReadMore}
            data-success-story-id={story.id}
            aria-label={buttonAriaLabel}
            class="relative z-10 w-full justify-center"
          >
            {buttonLabel}
          </Button>
        </div>
      )
    }
  </SuccessStoryCardBody>
</article>
