---
/**
 * Phone-frame screenshot card — single chat screenshot wrapped in a
 * device-style bezel, with a caption strip below.
 *
 * Used inside `ClientChatScreenshots.astro` to render each entry from
 * `~/data/clientChatScreenshots.ts`. The image is treated as a content
 * image (≥ 64px) — `SmartImage` wraps it via `ImageSource` per ADR-0010,
 * not a plain `<img>`.
 *
 * Aspect ratio is 9:19.5 portrait, matching modern smartphone screen
 * proportions. The phone bezel is purely decorative — `aria-hidden`
 * on the bezel container keeps the screenshot itself as the only
 * meaningful element for assistive tech.
 *
 * @example
 * ```astro
 * <ChatScreenshotCard screenshot={screenshot} />
 * ```
 */
import SmartImage from '~/components/ui/SmartImage.astro';
import type { ClientChatScreenshot } from '~/data/clientChatScreenshots';

type Props = {
  /** Screenshot data */
  screenshot: ClientChatScreenshot;
};

const { screenshot } = Astro.props;
---

<figure class="flex w-64 shrink-0 flex-col items-center sm:w-72">
  <div
    class="ring-foreground-950/10 relative w-full overflow-hidden rounded-[2rem] bg-white p-2 shadow-xl ring-1 dark:bg-white/5 dark:shadow-none dark:ring-white/10"
  >
    {/* Phone bezel notch — decorative */}
    <div
      class="bg-foreground-950/80 absolute top-2 left-1/2 z-10 h-5 w-24 -translate-x-1/2 rounded-b-2xl"
      aria-hidden="true"
    >
    </div>
    <div class="aspect-[9/19.5] w-full overflow-hidden rounded-[1.5rem]">
      <SmartImage
        src={screenshot.screenshotImage}
        alt={screenshot.screenshotAlt}
        widths={[360, 720]}
        sizes="(max-width: 640px) 256px, 288px"
        loading="lazy"
        class="h-full w-full object-cover"
      />
    </div>
  </div>
  <figcaption class="text-foreground-700 mt-4 text-center text-sm dark:text-gray-300">
    <span class="font-semibold">{screenshot.captionFirstName}</span>, {screenshot.captionContext}
  </figcaption>
</figure>
