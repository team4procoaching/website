---
/**
 * Category filter for success stories by program type.
 * Shows a dropdown on mobile and pill-style filter buttons on desktop.
 * Filters story cards by toggling visibility of data-program attributes.
 *
 * Uses `role="toolbar"` with `aria-pressed` (not tabs pattern) since this
 * controls a filter, not tab panels. See WAI-ARIA toolbar pattern.
 *
 * Adapted from ServiceCategoryTabs pattern.
 * TODO: Extract shared CategoryTabs/FilterTabs component if a third consumer appears.
 *
 * @example
 * ```astro
 * <StoryCategoryFilter />
 * ```
 */
import { programLabels } from '~/data/successStories';

const categories = [
  { id: 'all', label: 'All' },
  ...Object.entries(programLabels).map(([id, label]) => ({ id, label })),
] as const;

const defaultCategory = 'all';
---

<div data-story-filter>
  {/* Mobile: Dropdown select */}
  <div class="grid grid-cols-1 sm:hidden">
    <select
      aria-label="Filter by program type"
      class="text-foreground-950 outline-foreground-200 focus:outline-accent-600 dark:focus:outline-accent-500 col-start-1 row-start-1 w-full appearance-none rounded-lg bg-white py-3 pr-10 pl-4 text-base font-medium outline-1 -outline-offset-1 focus:outline-2 focus:-outline-offset-2 dark:bg-white/5 dark:text-white dark:outline-white/10"
      data-filter-select
    >
      {
        categories.map((category) => (
          <option value={category.id} selected={category.id === defaultCategory}>
            {category.label}
          </option>
        ))
      }
    </select>
    <svg
      viewBox="0 0 16 16"
      fill="currentColor"
      aria-hidden="true"
      class="fill-foreground-500 pointer-events-none col-start-1 row-start-1 mr-3 size-5 self-center justify-self-end dark:fill-gray-400"
    >
      <path
        d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z"
        clip-rule="evenodd"
        fill-rule="evenodd"></path>
    </svg>
  </div>

  {/* Desktop: Filter buttons (toolbar pattern) */}
  <div class="hidden sm:block">
    <div
      role="toolbar"
      aria-label="Filter success stories by program type"
      class="flex justify-center space-x-2"
    >
      {
        categories.map((category) => {
          const isActive = category.id === defaultCategory;
          return (
            <button
              type="button"
              aria-pressed={isActive ? 'true' : 'false'}
              tabindex={isActive ? 0 : -1}
              class:list={[
                'focus-visible:outline-accent-600 cursor-pointer rounded-lg px-4 py-2.5 text-sm font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2',
                isActive
                  ? 'bg-accent-600 dark:bg-accent-500 text-white'
                  : 'text-foreground-600 hover:bg-foreground-100 hover:text-foreground-950 dark:text-gray-400 dark:hover:bg-white/10 dark:hover:text-white',
              ]}
              data-filter-tab={category.id}
            >
              {category.label}
            </button>
          );
        })
      }
    </div>
  </div>
</div>

<script>
  // Constants for CSS class toggling
  const ACTIVE_CLASSES = ['bg-accent-600', 'text-white', 'dark:bg-accent-500'];
  const INACTIVE_CLASSES = [
    'text-foreground-600',
    'hover:bg-foreground-100',
    'hover:text-foreground-950',
    'dark:text-gray-400',
    'dark:hover:bg-white/10',
    'dark:hover:text-white',
  ];

  /**
   * StoryCategoryFilter Controller
   * Handles filter switching and card visibility based on program type.
   * TODO: Extract shared filter logic with ServiceCategoryTabs if a third consumer appears.
   */
  function initStoryFilter() {
    const container = document.querySelector('[data-story-filter]');
    if (!container || container.getAttribute('data-initialized') === 'true') return;
    container.setAttribute('data-initialized', 'true');

    const select = container.querySelector<HTMLSelectElement>('[data-filter-select]');
    const buttons = container.querySelectorAll<HTMLButtonElement>('[data-filter-tab]');
    const cards = document.querySelectorAll<HTMLElement>('[data-story-card]');

    const switchFilter = (categoryId: string) => {
      // Update filter buttons
      buttons.forEach((btn) => {
        const btnId = btn.getAttribute('data-filter-tab');
        const isActive = btnId === categoryId;

        ACTIVE_CLASSES.forEach((cls) => btn.classList.toggle(cls, isActive));
        INACTIVE_CLASSES.forEach((cls) => btn.classList.toggle(cls, !isActive));

        btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        btn.setAttribute('tabindex', isActive ? '0' : '-1');
      });

      // Update card visibility
      cards.forEach((card) => {
        const program = card.getAttribute('data-program');
        const shouldShow = categoryId === 'all' || program === categoryId;
        card.classList.toggle('hidden', !shouldShow);
      });

      // Scroll to top of stories section so filtered results are visible.
      // Important on mobile where users may have scrolled past now-hidden cards.
      // We target the parent section, not the sticky filter container itself,
      // because scrollIntoView on a sticky element doesn't produce useful results.
      const section = container.closest('section');
      if (section) {
        section.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      // Sync mobile select
      if (select) {
        select.value = categoryId;
      }
    };

    // Mobile: select change
    select?.addEventListener('change', () => {
      if (select.value) switchFilter(select.value);
    });

    // Desktop: button clicks
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const categoryId = btn.getAttribute('data-filter-tab');
        if (categoryId) switchFilter(categoryId);
      });
    });

    // Keyboard navigation (WAI-ARIA toolbar pattern)
    buttons.forEach((btn, index) => {
      btn.addEventListener('keydown', (e: KeyboardEvent) => {
        let newIndex = index;

        if (e.key === 'ArrowRight') {
          newIndex = (index + 1) % buttons.length;
        } else if (e.key === 'ArrowLeft') {
          newIndex = (index - 1 + buttons.length) % buttons.length;
        } else if (e.key === 'Home') {
          newIndex = 0;
        } else if (e.key === 'End') {
          newIndex = buttons.length - 1;
        } else {
          return;
        }

        e.preventDefault();
        const newBtn = buttons[newIndex];
        newBtn.focus();
        const categoryId = newBtn.getAttribute('data-filter-tab');
        if (categoryId) switchFilter(categoryId);
      });
    });
  }

  // Support both initial load and View Transitions
  document.addEventListener('DOMContentLoaded', initStoryFilter);
  document.addEventListener('astro:page-load', initStoryFilter);
</script>
