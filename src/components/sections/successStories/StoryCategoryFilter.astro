---
/**
 * Category filter for success stories by program type.
 * Shows a dropdown on mobile and pill-style filter buttons on desktop.
 * Filters story cards by toggling visibility of data-program attributes.
 *
 * Uses {@link PillSwitcher} for the shared tab/select template.
 * Uses `role="toolbar"` with `aria-pressed` (not tabs pattern) since this
 * controls a filter, not tab panels. See WAI-ARIA toolbar pattern.
 *
 * @example
 * ```astro
 * <StoryCategoryFilter />
 * ```
 */
import PillSwitcher from '~/components/ui/PillSwitcher.astro';
import { programLabels } from '~/data/successStories';

const items = [
  { id: 'all', label: 'All' },
  ...Object.entries(programLabels).map(([id, label]) => ({ id, label })),
];
---

<div data-story-filter>
  <PillSwitcher
    items={items}
    defaultValue="all"
    ariaLabel="Filter success stories by program type"
    name="filter"
    variant="toolbar"
  />
</div>

<script>
  // Constants for CSS class toggling
  const ACTIVE_CLASSES = ['bg-accent-600', 'text-white', 'dark:bg-accent-500'];
  const INACTIVE_CLASSES = [
    'text-foreground-600',
    'hover:bg-foreground-100',
    'hover:text-foreground-950',
    'dark:text-gray-400',
    'dark:hover:bg-white/10',
    'dark:hover:text-white',
  ];

  /**
   * StoryCategoryFilter Controller
   * Handles filter switching and card visibility based on program type.
   */
  function initStoryFilter() {
    const container = document.querySelector('[data-story-filter]');
    if (!container || container.getAttribute('data-initialized') === 'true') return;
    container.setAttribute('data-initialized', 'true');

    const select = container.querySelector<HTMLSelectElement>('[data-filter-select]');
    const buttons = container.querySelectorAll<HTMLButtonElement>('[data-filter-tab]');
    const cards = document.querySelectorAll<HTMLElement>('[data-story-card]');

    const switchFilter = (categoryId: string) => {
      // Update filter buttons
      buttons.forEach((btn) => {
        const isActive = btn.getAttribute('data-filter-tab') === categoryId;

        ACTIVE_CLASSES.forEach((cls) => btn.classList.toggle(cls, isActive));
        INACTIVE_CLASSES.forEach((cls) => btn.classList.toggle(cls, !isActive));

        btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        btn.setAttribute('tabindex', isActive ? '0' : '-1');
      });

      // Update card visibility
      cards.forEach((card) => {
        card.classList.toggle(
          'hidden',
          categoryId !== 'all' && card.getAttribute('data-program') !== categoryId,
        );
      });

      // Scroll to top of stories section so filtered results are visible.
      const section = container.closest('section');
      if (section) {
        section.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      // Sync mobile select
      if (select) {
        select.value = categoryId;
      }
    };

    // Mobile: select change
    select?.addEventListener('change', () => {
      if (select.value) switchFilter(select.value);
    });

    // Desktop: button clicks
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const categoryId = btn.getAttribute('data-filter-tab');
        if (categoryId) switchFilter(categoryId);
      });
    });

    // Keyboard navigation (WAI-ARIA toolbar pattern)
    buttons.forEach((btn, index) => {
      btn.addEventListener('keydown', (e: KeyboardEvent) => {
        let newIndex = index;

        if (e.key === 'ArrowRight') {
          newIndex = (index + 1) % buttons.length;
        } else if (e.key === 'ArrowLeft') {
          newIndex = (index - 1 + buttons.length) % buttons.length;
        } else if (e.key === 'Home') {
          newIndex = 0;
        } else if (e.key === 'End') {
          newIndex = buttons.length - 1;
        } else {
          return;
        }

        e.preventDefault();
        const newBtn = buttons[newIndex];
        newBtn.focus();
        const categoryId = newBtn.getAttribute('data-filter-tab');
        if (categoryId) switchFilter(categoryId);
      });
    });
  }

  // Support both initial load and View Transitions
  document.addEventListener('DOMContentLoaded', initStoryFilter);
  document.addEventListener('astro:page-load', initStoryFilter);
</script>
