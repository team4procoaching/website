---
/**
 * Coaches is the homepage / about-page coach grid section, wrapping Content
 * with a coach-specific grid and CoachCard rendering.
 *
 * @useWhen You are composing a page that needs a "meet your coaches" grid with
 *   either compact (homepage) or expanded (about) card variants.
 * @dontUseWhen You need a single-coach surface (e.g., a hero spotlight) —
 *   render CoachCardExpanded directly; Coaches is the grid-of-three section.
 * @relatedTo Content — composition base; Coaches passes the headline /
 *   heading-level / background through.
 * @relatedTo CoachCardCompact — rendered for `variant="compact"`.
 * @relatedTo CoachCardExpanded — rendered for `variant="expanded"`.
 * @example
 * ```astro
 * <Coaches headline="Meet Your Coaches" coaches={coaches} variant="expanded">
 *   <p>Three legends united for your success.</p>
 * </Coaches>
 * ```
 */
import Content from '~/components/sections/Content.astro';
import type { CoachExpanded } from '~/data/coaches';
import { isDarkBackground, type SectionBackground } from '~/styles/sectionStyles';
import CoachCardCompact from './coaches/CoachCardCompact.astro';
import CoachCardExpanded from './coaches/CoachCardExpanded.astro';

type Props = {
  /** Optional ID for the section (defaults to slugified headline) */
  id?: string;
  /** Section headline */
  headline: string;
  /** Semantic heading level */
  headingLevel?: 'h1' | 'h2' | 'h3' | 'h4';
  /** Coaches to display */
  coaches: readonly CoachExpanded[];
  /** Background color variant */
  background?: SectionBackground;
  /** Card display variant */
  variant?: 'compact' | 'expanded';
};

const {
  id,
  headline,
  headingLevel = 'h2',
  coaches,
  background = 'default',
  variant = 'compact',
} = Astro.props;

const isDark = isDarkBackground(background);

// Explicit per-card delays for scroll reveal (more robust than CSS stagger).
// Length must match coachIds — if a coach is added, add a delay value here.
const cardDelays = ['0', '200', '400'] as const;

// Adjust grid gap based on variant
const gridClasses =
  variant === 'expanded'
    ? 'mx-auto mt-16 grid max-w-2xl grid-cols-1 gap-8 sm:grid-cols-2 lg:mx-0 lg:max-w-none lg:grid-cols-3'
    : 'mx-auto mt-20 grid max-w-2xl grid-cols-1 gap-x-8 gap-y-16 sm:grid-cols-2 lg:mx-0 lg:max-w-none lg:grid-cols-3';
---

<Content id={id} headline={headline} headingLevel={headingLevel} background={background}>
  <slot />

  <Fragment slot="content">
    <ul role="list" class={gridClasses}>
      {
        coaches.map((coach, index) => (
          <li
            data-animate="fade-up"
            {...(cardDelays[index] !== '0' ? { 'data-animate-delay': cardDelays[index] } : {})}
          >
            <div class="hover-scale">
              {variant === 'expanded' ? (
                <CoachCardExpanded coach={coach as CoachExpanded} darkBackground={isDark} />
              ) : (
                <CoachCardCompact coach={coach} darkBackground={isDark} />
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </Fragment>
</Content>
