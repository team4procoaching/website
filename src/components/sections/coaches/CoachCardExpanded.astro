---
/**
 * CoachCardExpanded is the expanded coach-profile card with large image,
 * gradient overlay, achievement badges, and button CTA for the about page.
 *
 * @useWhen You need the detailed coach-introduction card for the about-page
 *   `<Coaches variant="expanded">` row.
 * @dontUseWhen You need the compact homepage variant — use CoachCardCompact for
 *   the brief introduction; CoachCardExpanded is the detailed about-page
 *   variant.
 * @alternativeTo CoachCardCompact — pick CoachCardCompact for the homepage
 *   compact layout.
 * @alternativeTo SuccessStoryCoachCard — pick SuccessStoryCoachCard for the
 *   in-page coach trust signal on success-story detail pages.
 * @relatedTo Button — renders Button for the modal trigger.
 * @relatedTo CoachDetailModal — opened via `command="show-modal"
 *   commandfor={MODAL_IDS.coachDetail}` with `data-coach-id`.
 * @relatedTo SmartImage — renders the coach portrait.
 * @adr ADR-0027
 * @example
 * ```astro
 * <CoachCardExpanded coach={coachExpanded} darkBackground />
 * ```
 */
import Button from '~/components/ui/Button.astro';
import SmartImage from '~/components/ui/SmartImage.astro';
import type { CoachExpanded } from '~/data/coaches';
import { MODAL_IDS } from '~/data/ids';

type Props = {
  /** Expanded coach data with achievements and detailed bio */
  coach: CoachExpanded;
  /** Whether the card sits on a dark section background */
  darkBackground?: boolean;
};

const { coach, darkBackground = false } = Astro.props;

const hasAchievements = coach.achievements.length > 0;
const bio = coach.shortBio;

// On dark backgrounds, wrap in a white card for contrast
const articleClasses = darkBackground
  ? 'group relative flex flex-col bg-white rounded-2xl p-4 shadow-lg dark:bg-white/5 dark:shadow-none dark:ring-1 dark:ring-white/10'
  : 'group relative flex flex-col';
---

<article class={articleClasses}>
  <div class="relative overflow-hidden rounded-2xl">
    <SmartImage
      src={coach.image}
      alt={coach.name}
      widths={[400, 600, 800]}
      sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
      class="aspect-4/5 w-full rounded-2xl object-cover"
    />
    {/* Gradient overlay */}
    <div
      class="from-foreground-950/80 via-foreground-950/40 absolute inset-0 bg-linear-to-t to-transparent"
    >
    </div>
    {/* Name overlay */}
    <div class="absolute inset-x-0 bottom-0 p-6">
      <h3 class="font-serif text-2xl font-bold text-white">{coach.name}</h3>
      <p class="text-accent-400 mt-1 text-sm font-medium">{coach.title}</p>
    </div>
  </div>

  {/* Achievement badges */}
  {
    hasAchievements && (
      <ul class="mt-4 flex flex-wrap gap-2">
        {coach.achievements.slice(0, 3).map((achievement) => (
          <li class="bg-accent-100 text-accent-800 dark:bg-accent-900/30 dark:text-accent-300 rounded-full px-3 py-1 text-xs font-medium">
            {achievement}
          </li>
        ))}
      </ul>
    )
  }

  {/* Bio */}
  <p class="text-foreground-600 mt-4 flex-1 text-sm/6 dark:text-gray-400">{bio}</p>

  {/* CTA Button — triggers CoachDetailModal */}
  <div class="mt-4">
    {
      /* Invisible stretched button — makes entire card clickable.
        Separate from visible Button because Button's hover-shine
        sets position:relative + overflow:hidden which would clip a
        stretched span inside it. */
    }
    <button
      type="button"
      command="show-modal"
      commandfor={MODAL_IDS.coachDetail}
      data-coach-id={coach.id}
      class="absolute inset-0 z-0 cursor-pointer"
      aria-hidden="true"
      tabindex="-1"></button>
    <Button
      as="button"
      variant="primary"
      class="relative z-10 w-full justify-center"
      command="show-modal"
      commandfor={MODAL_IDS.coachDetail}
      data-coach-id={coach.id}
    >
      Meet {coach.firstName}
    </Button>
  </div>
</article>
