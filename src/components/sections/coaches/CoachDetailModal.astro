---
/**
 * Dynamic coach detail modal that displays expanded coach information.
 * A single modal instance whose content updates based on the selected coach.
 *
 * **Trigger from CoachCard or any element:**
 * ```astro
 * <button command="show-modal" commandfor={MODAL_IDS.coachDetail} data-coach-id="helle">
 *   Meet Helle
 * </button>
 * ```
 *
 * The `data-coach-id` attribute on the trigger determines which coach to display.
 * The `el-dialog` wrapper provides enter/exit transitions, scroll-lock, and
 * focus-management around the native `<dialog>` target — orthogonal to the
 * Invokers API, not a fallback for it.
 *
 * @example
 * ```astro
 * <CoachDetailModal coaches={coachesExpanded} />
 * ```
 */
import Modal from '~/components/ui/Modal.astro';
import type { CoachExpanded, SerializedCoachDetail } from '~/data/coaches';
import { MODAL_IDS } from '~/data/ids';
import { routes } from '~/data/routes';
import { getImageUrl } from '~/types/components';

type Props = {
  /** Expanded coach data array */
  coaches: readonly CoachExpanded[];
};

const { coaches } = Astro.props;

// Serialize coach data for the controller. Typed via SerializedCoachDetail
// so producer (this frontmatter) and consumer (coachDetailModalController)
// share a single shape. getImageUrl extracts the URL string from
// ImageSource since ImageMetadata is not available at runtime.
const serializedCoaches: readonly SerializedCoachDetail[] = coaches.map((c) => ({
  id: c.id,
  name: c.name,
  firstName: c.firstName,
  title: c.title,
  fullBio: c.fullBio ?? c.bio,
  image: getImageUrl(c.image),
  achievements: c.achievements ?? [],
  specialties: c.specialties ?? [],
  coachingYears: c.coachingYears ?? 0,
  competingYears: c.competingYears ?? 0,
}));
const coachDataJson = JSON.stringify(serializedCoaches);
---

<Modal id={MODAL_IDS.coachDetail} ariaLabelledby="coach-detail-name" size="wide">
  <article data-coach-detail-content>
    {/* Coach image */}
    <div class="mb-6 overflow-hidden rounded-xl">
      <img
        src=""
        alt=""
        loading="lazy"
        decoding="async"
        class="aspect-3/2 w-full object-cover"
        data-coach-image
      />
    </div>

    {/* Name and title */}
    <h3
      id="coach-detail-name"
      class="text-foreground-950 font-serif text-2xl font-bold sm:text-3xl dark:text-white"
      data-coach-name
    >
    </h3>
    <p class="text-accent-600 dark:text-accent-400 mt-1 text-sm font-medium" data-coach-title></p>

    {/* Experience stats */}
    <div class="mt-4 flex gap-6" data-coach-stats>
      <div>
        <span
          class="text-foreground-950 font-serif text-xl font-bold dark:text-white"
          data-coach-competing-years></span>
        <span class="text-foreground-600 ml-1 text-sm dark:text-gray-400">Years Competing</span>
      </div>
      <div>
        <span
          class="text-foreground-950 font-serif text-xl font-bold dark:text-white"
          data-coach-coaching-years></span>
        <span class="text-foreground-600 ml-1 text-sm dark:text-gray-400">Years Coaching</span>
      </div>
    </div>

    {/* Bio */}
    <div class="text-foreground-600 mt-6 space-y-4 text-base/7 dark:text-gray-400" data-coach-bio>
    </div>

    {/* Achievements */}
    <div class="mt-6" data-coach-achievements-section>
      <h4 class="text-foreground-950 text-sm font-semibold dark:text-white">Achievements</h4>
      <ul class="mt-2 flex flex-wrap gap-2" data-coach-achievements></ul>
    </div>

    {/* Specialties */}
    <div class="mt-4" data-coach-specialties-section>
      <h4 class="text-foreground-950 text-sm font-semibold dark:text-white">Specialties</h4>
      <ul class="mt-2 flex flex-wrap gap-2" data-coach-specialties></ul>
    </div>

    {/* CTA */}
    <div class="mt-8">
      <a
        href={routes.contact}
        class="bg-accent-600 hover:bg-accent-700 focus-visible:outline-accent-600 dark:bg-accent-500 dark:hover:bg-accent-400 inline-flex w-full justify-center rounded-lg px-4 py-3 text-sm font-semibold text-white shadow-sm transition-colors focus-visible:outline-2 focus-visible:outline-offset-2"
        data-coach-cta
      >
        Start Your Journey
      </a>
    </div>
  </article>
</Modal>

{/* Coach data passed via hidden template element (survives Astro script bundling) */}
<template id="coach-detail-data" data-json={coachDataJson}></template>

<script>
  import { MODAL_IDS } from '~/data/ids';
  import { initCoachDetailModal } from '~/scripts/coachDetailModalController';
  import { bootstrapOnLoad } from '~/utils/bootstrap';

  // Dual-dispatch init — see ADR-0026. bootstrapOnLoad handles both the
  // cold-load fallback and the View Transitions re-run; initCoachDetailModal
  // is idempotent via a data-initialized guard, so the overlap on initial
  // load when View Transitions are active is a no-op.
  bootstrapOnLoad(() => {
    const modal = document.getElementById(MODAL_IDS.coachDetail);
    if (modal) initCoachDetailModal(modal);
  });
</script>
