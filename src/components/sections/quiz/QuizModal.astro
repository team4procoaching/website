---
import QuizStepPanel from '~/components/sections/quiz/QuizStepPanel.astro';
/**
 * QuizModal is the 4-step interactive quiz modal that recommends a service
 * based on category / service / experience / timeline answers.
 *
 * @useWhen You are composing a page with a "find your fit" affordance and need
 *   the 4-step quiz flow with category-driven dynamic step 2 and a
 *   recommendation panel.
 * @dontUseWhen You need a static FAQ or a single-question form — use Accordion
 *   or a plain form; QuizModal is the recommendation-flow specialist.
 * @relatedTo Modal — composition base.
 * @relatedTo QuizStepPanel — renders steps 1, 3, 4 (server-rendered); step 2 is
 *   JS-populated.
 * @relatedTo ContactForm — quiz answers persist via sessionStorage and are
 *   consumed by ContactForm.
 * @adr ADR-0019
 * @adr ADR-0020
 * @adr ADR-0021
 * @adr ADR-0026
 * @adr ADR-0027
 *
 * Uses a 4-step flow:
 *   1. Category selection (determines service pool) — {@link QuizStepPanel}
 *   2. Specific service selection (determines recommendation) — dynamic JS
 *   3. Experience level (context for coaches) — {@link QuizStepPanel}
 *   4. Timeline (context for coaches) — {@link QuizStepPanel}
 *   → Result with recommendation + contact link carrying quiz answers
 *
 * Steps 1/3/4 are server-rendered via QuizStepPanel. Step 2 is dynamically
 * populated by the client-side script based on the Step 1 category selection.
 *
 * Built on the generic Modal component. Migrated to module script per ADR-0020.
 *
 * @example
 * ```astro
 * <QuizModal />
 *
 * <!-- Trigger button anywhere on the page -->
 * <button command="show-modal" commandfor={MODAL_IDS.quiz}>Find Your Fit</button>
 * ```
 */
import Modal from '~/components/ui/Modal.astro';
import { MODAL_IDS } from '~/data/ids';
import { results, step1, step2, step3, step4, stepLabels } from '~/data/quiz';
import { routes } from '~/data/routes';

// Serialize data for client-side JavaScript
const quizDataJson = JSON.stringify({
  step1,
  step2,
  step3,
  step4,
  stepLabels,
  results,
  contactRoute: routes.contact,
});

// Shared button classes for Step 2 (dynamic) and Result panel
const primaryBtnClasses =
  'bg-accent-600 hover:bg-accent-700 focus-visible:outline-accent-600 dark:bg-accent-500 dark:hover:bg-accent-400 inline-flex w-full justify-center rounded-lg px-4 py-3 text-sm font-semibold text-white shadow-sm transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 disabled:cursor-not-allowed disabled:opacity-50';
const secondaryBtnClasses =
  'border-foreground-300 text-foreground-950 hover:bg-foreground-50 inline-flex flex-1 justify-center rounded-lg border bg-white px-4 py-3 text-sm font-semibold shadow-sm transition-colors dark:border-white/10 dark:bg-white/5 dark:text-white dark:hover:bg-white/10';
---

<Modal id={MODAL_IDS.quiz} ariaLabelledby="quiz-title">
  {/* Progress indicator — 4 steps */}
  <nav aria-label="Progress" class="mb-6" data-quiz-progress>
    <ol role="list" class="flex space-x-2 sm:space-x-4">
      {
        stepLabels.map((step, i) => (
          <li class="flex-1">
            <div
              class:list={[
                'flex flex-col border-t-4 pt-3 sm:pt-4',
                i === 0
                  ? 'border-accent-600 dark:border-accent-500'
                  : 'border-foreground-200 dark:border-white/10',
              ]}
              data-step-indicator={i + 1}
            >
              <span
                class:list={[
                  'text-xs font-medium sm:text-sm',
                  i === 0
                    ? 'text-accent-600 dark:text-accent-400'
                    : 'text-foreground-500 dark:text-gray-400',
                ]}
              >
                Step {i + 1}
              </span>
              <span class="text-foreground-950 hidden text-sm font-medium sm:block dark:text-white">
                {step.label}
              </span>
              <span class="text-foreground-950 block text-xs font-medium sm:hidden dark:text-white">
                {step.shortLabel}
              </span>
            </div>
          </li>
        ))
      }
    </ol>
  </nav>

  {/* Quiz content */}
  <div data-quiz-content>
    {/* Step 1: Category selection (server-rendered) */}
    <QuizStepPanel
      stepNumber={1}
      question={step1.question}
      radioName="quiz-category"
      options={step1.options}
      headingId="quiz-title"
    />

    {/* Step 2: Service selection (dynamically populated by JS) */}
    <div data-quiz-step="2" class="hidden">
      <h3
        class="text-foreground-950 text-center font-serif text-2xl font-bold sm:text-3xl dark:text-white"
        data-dynamic-question
      >
      </h3>

      <fieldset class="mt-6">
        <legend class="sr-only" data-dynamic-legend></legend>
        <div class="space-y-3" data-dynamic-options></div>
      </fieldset>

      <div class="mt-8 flex gap-3">
        <button type="button" class={secondaryBtnClasses} data-quiz-nav="back">
          {/* Chevron left */}
          <svg
            class="mr-2 size-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"></path>
          </svg>
          Back
        </button>
        <button type="button" class={`${primaryBtnClasses} flex-1`} data-quiz-nav="next" disabled>
          Next
          {/* Chevron right */}
          <svg
            class="ml-2 size-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"></path>
          </svg>
        </button>
      </div>
    </div>

    {/* Step 3: Experience level (server-rendered) */}
    <QuizStepPanel
      stepNumber={3}
      question={step3.question}
      radioName="quiz-experience"
      options={step3.options}
      showBack
    />

    {/* Step 4: Timeline (server-rendered) */}
    <QuizStepPanel
      stepNumber={4}
      question={step4.question}
      radioName="quiz-timeline"
      options={step4.options}
      showBack
      isLastStep
    />

    {/* Result */}
    <div data-quiz-step="result" class="hidden">
      <div class="bg-accent-50 dark:bg-accent-500/10 rounded-xl p-6">
        <div class="flex">
          <div class="shrink-0">
            {/* Checkmark circle */}
            <svg
              class="text-accent-600 dark:text-accent-400 size-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path>
            </svg>
          </div>
          <div class="ml-4">
            <h3 class="text-accent-800 dark:text-accent-200 font-semibold">We recommend:</h3>
            <p
              class="text-foreground-950 mt-1 text-xl font-bold dark:text-white"
              data-result-service
            >
            </p>
            <p
              class="text-foreground-600 mt-1 text-sm italic dark:text-gray-400"
              data-result-tagline
            >
            </p>
          </div>
        </div>
      </div>

      <div class="mt-8 flex flex-col gap-3">
        <a href="#" class={primaryBtnClasses} data-result-service-link>
          See This Program
          {/* Chevron right */}
          <svg
            class="ml-2 size-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"></path>
          </svg>
        </a>
        <a href="#" class={secondaryBtnClasses + ' w-full'} data-result-contact-link>
          Get in Touch
        </a>
        <button
          type="button"
          class="text-foreground-500 hover:text-foreground-700 mt-2 text-sm transition-colors dark:text-gray-400 dark:hover:text-gray-300"
          data-quiz-nav="restart"
        >
          Start Over
        </button>
      </div>
    </div>
  </div>
</Modal>

{/* Quiz data passed via hidden template element (survives Astro script bundling) */}
<template id="quiz-data" data-json={quizDataJson}></template>

<script>
  import { initQuizModal } from '~/scripts/quizModalController';
  import { MODAL_IDS } from '~/data/ids';
  import { bootstrapOnLoad } from '~/utils/bootstrap';

  // Dual-dispatch init — see ADR-0026. bootstrapOnLoad handles both the
  // cold-load fallback and the View Transitions re-run; initQuizModal is
  // idempotent via a data-initialized guard, so the overlap on initial
  // load when View Transitions are active is a no-op.
  bootstrapOnLoad(() => {
    const modal = document.getElementById(MODAL_IDS.quiz);
    if (modal) initQuizModal(modal);
  });
</script>
