---
/**
 * UspCard is the unique-selling-point card with icon, title, and description,
 * designed for use inside USP grid layouts with light and dark background
 * variants.
 *
 * @useWhen You are composing a Usps section (or any USP grid) and need the
 *   icon-title-description card chrome with light or dark background styling.
 * @dontUseWhen You need a USP card outside a grid layout — UspCard is
 *   grid-row-specific; for a single highlight, render the icon / title /
 *   description inline.
 * @relatedTo Usps — primary consumer; renders one UspCard per USP entry.
 * @example
 * ```astro
 * <UspCard usp={usp} headingLevel="h3" darkBackground />
 * ```
 */
import type { Usp } from '~/data/usps';

type Props = {
  /** USP data */
  usp: Usp;
  /** Heading level for the title */
  headingLevel?: 'h3' | 'h4' | 'h5';
  /** Whether the card sits on a dark section background */
  darkBackground?: boolean;
};

const { usp, headingLevel = 'h3', darkBackground = false } = Astro.props;

const HeadingTag = headingLevel;

const iconClass = darkBackground
  ? 'text-white mx-auto size-12 sm:size-14 lg:size-16'
  : 'text-foreground-950 mx-auto size-12 sm:size-14 lg:size-16 dark:text-white';

const headingClass = darkBackground
  ? 'mt-6 text-base/7 font-semibold tracking-tight text-white'
  : 'mt-6 text-base/7 font-semibold tracking-tight text-foreground-950 dark:text-white';

const descClass = darkBackground
  ? 'text-white/90 mt-4 text-base/7'
  : 'text-foreground-600 mt-4 text-base/7 dark:text-gray-400';
---

<div class="text-center">
  {/* SAFETY: icon SVG path is statically defined in ~/data/usps.ts */}
  <svg
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"
    class={iconClass}
    set:html={usp.icon}
  />
  <HeadingTag class={headingClass}>{usp.title}</HeadingTag>
  {/* SAFETY: description is statically defined in ~/data/usps.ts */}
  <p class={descClass} set:html={usp.description} />
</div>
