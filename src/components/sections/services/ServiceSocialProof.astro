---
/**
 * ServiceSocialProof is the testimonials section for the service detail page,
 * resolving `service.testimonialIds` against the global testimonials record
 * with graceful empty-state.
 *
 * @useWhen You are composing a service detail page and need a "what clients
 *   say" section that renders only when `service.testimonialIds` resolves to
 *   one or more testimonials.
 * @dontUseWhen You need the homepage testimonial grid — use TestimonialGrid,
 *   which expects 1 featured + 6 regular; ServiceSocialProof is the per-service
 *   variant.
 * @alternativeTo TestimonialGrid — pick TestimonialGrid for the curated 7-quote
 *   balanced layout on a generic surface; ServiceSocialProof is service-scoped
 *   and degrades gracefully.
 * @relatedTo TestimonialCard — renders one card per resolved testimonial.
 * @relatedTo testimonialsById — reads the global testimonials record
 *   (`src/data/testimonials.ts`) and looks up entries by
 *   `service.testimonialIds`.
 *
 * Maps each `service.testimonialIds` entry through {@link testimonialsById}
 * and renders the results as a simple stacked list. **Renders nothing** when
 * `testimonialIds` is absent or empty — the graceful-degradation gate the
 * requirements doc explicitly calls out for services without curated quotes
 * (e.g. `competition-prep` at launch).
 *
 * Every ID in `service.testimonialIds` resolves by the type contract:
 * `Service.testimonialIds` is `readonly TestimonialId[]` and
 * `testimonialsById` is `Record<TestimonialId, Testimonial>`, so the lookup
 * is total. No runtime guard is necessary — typo'd IDs are rejected at
 * compile time (ADR-0017).
 *
 * Reuses {@link TestimonialCard} so the visual rendering of a quote stays
 * consistent with `/success-stories`. The grid component is not reused
 * because it expects 1 featured + 6 regular quotes; the detail page
 * typically has one or two quotes per service.
 *
 * @example
 * ```astro
 * <ServiceSocialProof service={service} />
 * ```
 */
import TestimonialCard from '~/components/sections/successStories/TestimonialCard.astro';
import type { ServiceWithCompleteDetailContent } from '~/data/services';
import { testimonialsById } from '~/data/testimonials';
import { sectionBackground } from '~/styles/sectionStyles';

type Props = {
  /** Detail-eligible service rendered on this page. */
  service: ServiceWithCompleteDetailContent;
};

const { service } = Astro.props;

/**
 * Resolved testimonials for this service. Each `TestimonialId` maps directly
 * to a `Testimonial` via {@link testimonialsById} — the lookup is total by
 * the `Record<TestimonialId, Testimonial>` contract. An absent or empty
 * `testimonialIds` collapses to an empty array; the section returns null
 * below.
 */
const resolvedTestimonials = service.testimonialIds?.map((id) => testimonialsById[id]) ?? [];

const headingId = `service-social-proof-${service.id}`;
---

{
  resolvedTestimonials.length > 0 && (
    <section
      class:list={['px-6 py-16 sm:py-24 lg:px-8', sectionBackground.muted]}
      aria-labelledby={headingId}
    >
      <div class="mx-auto max-w-5xl">
        <h2
          id={headingId}
          class="text-foreground-950 font-serif text-3xl font-bold tracking-tight sm:text-4xl dark:text-white"
          data-animate="fade-up"
        >
          What clients say
        </h2>

        <ul role="list" class="mt-12 grid grid-cols-1 gap-8 sm:grid-cols-2" data-animate-stagger>
          {resolvedTestimonials.map((testimonial) => (
            <li data-animate="fade-up">
              <TestimonialCard testimonial={testimonial} />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
