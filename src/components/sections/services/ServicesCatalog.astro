---
/**
 * Full services catalog with mission block, FilterBar toolbar, pricing toggle,
 * and service cards. Used on the /services page to display all services
 * organized by category.
 *
 * Combines MissionBlock (mission-driven introduction), FilterBar
 * (toolbar-pattern category filter driven by
 * {@link src/scripts/servicesFilterController.ts}), SegmentedControl (CSS-only
 * billing period toggle), and ServiceCard grids per category.
 *
 * Note: Uses `<div>` with `group/tiers` class (not `<form>`) because there is
 * no form submission — the radio buttons only drive CSS visibility via `:has()`.
 *
 * Coupling note: renders a mid-page CTA that opens the quiz modal via the
 * Invokers API, using `MODAL_IDS.quiz` as the target id. Consumers embedding
 * this component are expected to render a `<QuizModal />` with
 * `id={MODAL_IDS.quiz}` on the same page. Without it the CTA is a no-op
 * click.
 *
 * @example
 * ```astro
 * <ServicesCatalog id="categories" missionContent={servicesMission} />
 * ```
 *
 * `missionContent` is the content rendered by the embedded `<MissionBlock />`.
 * The page is the source of the configuration; this component forwards it.
 */
import MissionBlock from '~/components/sections/services/MissionBlock.astro';
import ServiceCard from '~/components/sections/services/ServiceCard.astro';
import FilterBar from '~/components/ui/FilterBar.astro';
import Section from '~/components/ui/Section.astro';
import SectionHeader from '~/components/ui/SectionHeader.astro';
import SegmentedControl from '~/components/ui/SegmentedControl.astro';
import { MODAL_IDS } from '~/data/ids';
import {
  billingPeriods,
  type CategoryInfo,
  categories,
  defaultPeriod,
  getServicesByCategory,
  type ServiceCategory,
  services,
} from '~/data/services';
import type { MissionBlockContent } from '~/data/servicesMission';
import { ALL_CATEGORIES_SENTINEL } from '~/scripts/servicesFilterController';

type Props = {
  /** Section ID — anchors the section element and the aria-labelledby target. */
  readonly id: string;
  /** Mission block content rendered by the embedded `<MissionBlock />`. */
  readonly missionContent: MissionBlockContent;
};

const { id, missionContent } = Astro.props;
const headingId = id;

// Inline service→category lookup serialized to the DOM as a data attribute;
// the filter controller reads this to resolve `?service=<id>` deep-links
// without a second data-module import. See {@link servicesFilterController}.
const serviceToCategoryMap: Record<string, ServiceCategory> = Object.fromEntries(
  services.map((s) => [s.id, s.category]),
);

const filterItems = [
  { id: ALL_CATEGORIES_SENTINEL, label: 'All' },
  ...categories.map((c) => ({ id: c.id, label: c.name })),
];

// Shorter per-category framing rendered on mobile in place of the long
// atmospheric `category.description`. Each line keeps the "list of three
// things + differentiator" shape so the framing survives the compression.
// The named-group descendant selector below hides this sentence when the
// catalog is filtered to a single category — the heading still anchors the
// section, the visitor's own choice already implies the framing.
const categoryShortDescriptions = {
  bodybuilding:
    "Competition prep, off-season, and posing — coached by women who've competed at the highest level.",
  athletic:
    'Training for sport — combat, lifting, endurance — built around your competition calendar and weight class.',
  wellness:
    'Building muscle, losing fat, or finding a sustainable routine — IFBB-Pro expertise without the stage pressure.',
} as const satisfies Record<ServiceCategory, string>;
---

<Section
  background="default"
  id={headingId}
  ariaLabelledby={`${headingId}-heading`}
  class="group/catalog px-6 py-16"
  data-services-filter
  data-service-map={JSON.stringify(serviceToCategoryMap)}
>
  <div class="mx-auto max-w-7xl">
    <MissionBlock content={missionContent} />

    {/* Section Header — dominant catalog h2 sourced from missionContent.catalogHeading */}
    <div class="mt-24" data-animate="fade-up">
      <SectionHeader headline={missionContent.catalogHeading} headingId={`${headingId}-heading`} />
    </div>

    {
      /* Category Filter — Accessible Name via ariaLabelledBy: the visible
         "Choose your focus" over-label is the DOM-id anchor. See FilterBar's
         JSDoc for the path-selection heuristic. */
    }
    <div class="mt-16 flex flex-col items-center" data-animate="fade" data-animate-delay="200">
      <p
        id={`${headingId}-filter-label`}
        class="text-foreground-600 mb-2 text-center text-sm dark:text-gray-500"
      >
        Choose your focus
      </p>
      <FilterBar
        items={filterItems}
        defaultValue={ALL_CATEGORIES_SENTINEL}
        ariaLabelledBy={`${headingId}-filter-label`}
        name="category"
      />
    </div>

    {
      /* Mid-Page Quiz CTA — subtle help-if-undecided fallback positioned
        below the FilterBar so the filter is offered first and the quiz
        reads as the third-option safety net. Uses a raw <button> (not the
        <Cta /> component) because the trigger is inline within a sentence
        of body copy; the Cta variants are block-level with their own
        padding/background, which would break the inline flow. The Invoker
        API pair (command/commandfor) is the project's modal-trigger
        standard — see ADR-0027. */
    }
    <p
      class="text-foreground-600 mt-6 text-center text-sm text-pretty dark:text-gray-500"
      data-animate="fade"
      data-animate-delay="250"
    >
      Still weighing the options?
      <button
        type="button"
        command="show-modal"
        commandfor={MODAL_IDS.quiz}
        class="text-accent-700 dark:text-accent-400 focus-visible:outline-accent-600 cursor-pointer rounded-sm underline underline-offset-2 focus-visible:outline-2 focus-visible:outline-offset-2"
      >
        Take the quiz
      </button>&nbsp;— it narrows things down in under two minutes.
    </p>

    {/* Pricing Toggle - Sticky */}
    <div class="group/tiers" data-animate="fade" data-animate-delay="300">
      <div
        class="bg-background/95 supports-backdrop-filter:bg-background/80 dark:bg-background-dark/95 dark:supports-backdrop-filter:bg-background-dark/80 sticky top-0 z-40 mt-16 py-4 backdrop-blur"
      >
        <div class="flex flex-col items-center">
          <p
            id={`${headingId}-toggle-label`}
            class="text-foreground-600 mb-2 text-center text-sm dark:text-gray-500"
          >
            Show pricing for
          </p>
          <SegmentedControl
            name="frequency"
            options={billingPeriods}
            defaultValue={defaultPeriod}
            ariaLabelledBy={`${headingId}-toggle-label`}
          />
          {
            /* Toggle scope caption — quiet clarification that the billing-period
              control governs the subscription cards only; the session-based
              Posing card sits out the toggle (ADR-0047). Plain muted text, no
              banner styling, so it reads as a safety net rather than a signpost. */
          }
          <p
            class="text-foreground-600 mt-4 mb-12 text-center text-sm text-pretty dark:text-gray-500"
          >
            Applies to ongoing coaching plans. Session-based services are priced per session.
          </p>
        </div>
      </div>

      {
        /* Category Groups — flex + gap puts spacing on visible children only;
          display:none siblings don't count, which is why we use this instead
          of per-child top margins (filter would leave the sole visible
          non-first group with a 64px margin it shouldn't have). */
      }
      <div class="flex flex-col gap-16">
        {
          categories.map((category: CategoryInfo) => {
            const categoryServices = getServicesByCategory(category.id);
            return (
              <div data-category-group={category.id}>
                {/* Category Header */}
                <div class="mx-auto max-w-2xl">
                  <h3
                    id={`${headingId}-category-${category.id}-heading`}
                    class="text-foreground-950 scroll-mt-24 font-serif text-2xl font-bold tracking-tight sm:text-3xl dark:text-white"
                  >
                    {category.name}
                  </h3>
                  <hr role="presentation" class="border-foreground-200 mt-3 dark:border-white/10" />
                  {/* Dual-rendering the category framing: the long
                      atmospheric paragraph stays on desktop; mobile gets a
                      one-sentence summary. The mobile sentence is further
                      hidden under the named-group scope when the catalog
                      reports `data-view-mode="single"` — the heading and
                      the visitor's own filter choice already carry the
                      framing, the short sentence would be redundant copy.
                      The "all" state keeps it visible. See ADR-0017 on the
                      `as const satisfies Record<>` constant above. */}
                  <p class="text-foreground-700 mt-6 hidden text-base/7 sm:block sm:text-lg/7 dark:text-gray-400">
                    {category.description}
                  </p>
                  <p class="text-foreground-700 mt-6 text-base/7 group-data-[view-mode=single]/catalog:hidden sm:hidden dark:text-gray-400">
                    {categoryShortDescriptions[category.id]}
                  </p>
                </div>

                {/* Service Cards Grid — columns adapt to service count per category:
                     2 services → max-w-4xl, 2 cols; 3 → max-w-6xl, 3 cols; 4+ → full width, 4 cols */}
                <ul
                  role="list"
                  data-animate-stagger
                  class:list={[
                    'mx-auto mt-10 grid gap-8',
                    categoryServices.length === 2
                      ? 'max-w-4xl grid-cols-1 md:grid-cols-2'
                      : categoryServices.length === 3
                        ? 'max-w-6xl grid-cols-1 md:grid-cols-2 lg:grid-cols-3'
                        : 'grid-cols-1 md:grid-cols-2 lg:grid-cols-4',
                  ]}
                >
                  {categoryServices.map((service) => (
                    <li data-animate="fade-up">
                      <ServiceCard service={service} />
                    </li>
                  ))}
                </ul>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</Section>

<script>
  import { initServicesFilter } from '~/scripts/servicesFilterController';
  import { bootstrapOnLoad } from '~/utils/bootstrap';

  // Dual-dispatch init — see ADR-0026. bootstrapOnLoad handles both the
  // cold-load fallback and the View Transitions re-run; initServicesFilter
  // is idempotent via a data-initialized guard, so the overlap on initial
  // load when View Transitions are active is a no-op.
  bootstrapOnLoad(() => {
    document.querySelectorAll<HTMLElement>('[data-services-filter]').forEach(initServicesFilter);
  });
</script>
