---
/**
 * Full services catalog with stats grid, FilterBar toolbar, pricing toggle,
 * and service cards. Used on the /services page to display all services
 * organized by category.
 *
 * Combines FilterBar (toolbar-pattern category filter driven by
 * {@link src/scripts/servicesFilterController.ts}), SegmentedControl (CSS-only
 * billing period toggle), and ServiceCard grids per category.
 *
 * Note: Uses `<div>` with `group/tiers` class (not `<form>`) because there is
 * no form submission — the radio buttons only drive CSS visibility via `:has()`.
 *
 * Coupling note: renders a mid-page CTA that opens the quiz modal via the
 * Invokers API, using `MODAL_IDS.quiz` as the target id. Consumers embedding
 * this component are expected to render a `<QuizModal />` with
 * `id={MODAL_IDS.quiz}` on the same page. Without it the CTA is a no-op
 * click.
 *
 * @example
 * ```astro
 * <ServicesCatalog headline="Our Services">
 *   <p slot="intro-primary" class="text-foreground-700 text-left text-lg text-pretty sm:text-xl/8 dark:text-gray-400">
 *     Long-form primary paragraph with left alignment. Sits above the
 *     stats grid and anchors the claim the stats quantify.
 *   </p>
 *   <p slot="intro-secondary" class="text-foreground-700 text-center text-lg font-medium text-pretty sm:text-xl/8 dark:text-gray-400">
 *     Short editorial bridge below the stats grid, centered and weighted
 *     to lead into the filter.
 *   </p>
 * </ServicesCatalog>
 * ```
 */
import ServiceCard from '~/components/sections/services/ServiceCard.astro';
import FilterBar from '~/components/ui/FilterBar.astro';
import SegmentedControl from '~/components/ui/SegmentedControl.astro';
import SmartImage from '~/components/ui/SmartImage.astro';
import StatsGrid from '~/components/ui/StatsGrid.astro';
import { coachesExpanded } from '~/data/coaches';
import { MODAL_IDS } from '~/data/ids';
import {
  billingPeriods,
  type CategoryInfo,
  categories,
  defaultPeriod,
  getServicesByCategory,
  type ServiceCategory,
  services,
} from '~/data/services';
import { statsSection } from '~/data/stats';
import { ALL_CATEGORIES_SENTINEL } from '~/scripts/servicesFilterController';
import { slugify } from '~/utils/slugify';

type Props = {
  /** Optional section ID (defaults to slugified headline) */
  id?: string;
  /** Section headline */
  headline: string;
};

const { id, headline } = Astro.props;
const headingId = id ?? `catalog-${slugify(headline)}`;

// `intro-primary` / `intro-secondary` are non-forwarded today — Astro.slots.has is safe here.
// See ADR-0036 for the forwardable-slot rule.
const hasPrimaryIntro = Astro.slots.has('intro-primary');
const hasSecondaryIntro = Astro.slots.has('intro-secondary');

// Evidence stats for the claim in intro-primary: a deliberate two-tile
// editorial selection of the year-based quantitative numbers, not a
// mirror of the catalog minus outliers. `personalized` is excluded
// because it is a qualitative claim, not a countable figure that sits
// naturally alongside year counts; `proCoaches` is excluded because the
// coach avatar strip immediately above already communicates that count
// visually, and restating it here would be duplication next to its own
// source. Coupled to stats.ts by record key — dropping `yearsCoaching`
// or `yearsCompeting` from `statIds` is a compile error on the access
// expressions below.
const servicesStats = [statsSection.stats.yearsCoaching, statsSection.stats.yearsCompeting];

// Inline service→category lookup serialized to the DOM as a data attribute;
// the filter controller reads this to resolve `?service=<id>` deep-links
// without a second data-module import. See {@link servicesFilterController}.
const serviceToCategoryMap: Record<string, ServiceCategory> = Object.fromEntries(
  services.map((s) => [s.id, s.category]),
);

const filterItems = [
  { id: ALL_CATEGORIES_SENTINEL, label: 'All' },
  ...categories.map((c) => ({ id: c.id, label: c.name })),
];
---

<section
  id={headingId}
  class="bg-background dark:bg-background-dark px-6 py-16"
  aria-labelledby={`${headingId}-heading`}
  data-services-filter
  data-service-map={JSON.stringify(serviceToCategoryMap)}
>
  <div class="mx-auto max-w-7xl">
    {/* Section Header */}
    <div class="mx-auto max-w-2xl text-center" data-animate="fade-up">
      <h2
        id={`${headingId}-heading`}
        class="text-foreground-950 font-serif text-4xl font-bold tracking-tight sm:text-5xl dark:text-white"
      >
        {headline}
      </h2>
      {
        hasPrimaryIntro && (
          <div class="mt-6">
            <slot name="intro-primary" />
          </div>
        )
      }

      {
        /* Coach strip — faces before numbers. Uses fade-up (not StatsGrid's
           scale-up) so portraits drift in while the neighbouring stat tiles
           pop: two reveal verbs, two information types. */
      }
      <ul
        data-animate-stagger
        class="mx-auto mt-10 grid max-w-2xl grid-cols-1 gap-6 text-center sm:grid-cols-3"
      >
        {
          coachesExpanded.map((coach) => (
            <li data-animate="fade-up">
              <SmartImage
                src={coach.image}
                alt={coach.name}
                widths={[96, 192]}
                sizes="96px"
                class="mx-auto size-24 rounded-full object-cover"
              />
              <p class="text-foreground-950 mt-4 text-sm font-semibold dark:text-white">
                {coach.firstName}
              </p>
              <p class="text-foreground-600 mt-1 text-xs dark:text-gray-400">
                {coach.credentialLine}
              </p>
            </li>
          ))
        }
      </ul>

      <StatsGrid stats={servicesStats} columns={2} class="mt-10" />

      {
        hasSecondaryIntro && (
          <div class="mt-10">
            <slot name="intro-secondary" />
          </div>
        )
      }
    </div>

    {
      /* Category Filter — Accessible Name via ariaLabel: no visible label
         element is positioned as a DOM-id anchor for aria-labelledby in this
         composition. See ADR-0028 for the path-selection heuristic. */
    }
    <div class="mt-12 flex justify-center" data-animate="fade" data-animate-delay="200">
      <FilterBar
        items={filterItems}
        defaultValue={ALL_CATEGORIES_SENTINEL}
        ariaLabel="Filter services by goal"
        name="category"
      />
    </div>

    {
      /* Mid-Page Quiz CTA — subtle third option for undecided visitors.
        Uses a raw <button> (not the <Cta /> component) because the trigger
        is inline within a sentence of body copy; the Cta variants are
        block-level with their own padding/background, which would break
        the inline flow. The Invoker API pair (command/commandfor) is the
        project's modal-trigger standard — see ADR-0027. */
    }
    <p
      class="text-foreground-600 mt-10 text-center text-sm text-pretty dark:text-gray-500"
      data-animate="fade"
      data-animate-delay="300"
    >
      Still weighing the options?
      <button
        type="button"
        command="show-modal"
        commandfor={MODAL_IDS.quiz}
        class="text-accent-700 dark:text-accent-400 focus-visible:outline-accent-600 cursor-pointer rounded-sm underline underline-offset-2 focus-visible:outline-2 focus-visible:outline-offset-2"
      >
        Take the quiz
      </button>&nbsp;— it narrows things down in under two minutes.
    </p>

    {/* Pricing Toggle - Sticky */}
    <div class="group/tiers">
      <div
        class="bg-background/95 supports-backdrop-filter:bg-background/80 dark:bg-background-dark/95 dark:supports-backdrop-filter:bg-background-dark/80 sticky top-0 z-40 mt-8 py-4 backdrop-blur"
      >
        <div class="flex justify-center">
          <SegmentedControl
            name="frequency"
            options={billingPeriods}
            defaultValue={defaultPeriod}
            ariaLabel="Select billing period"
          />
        </div>
      </div>

      {
        /* Category Groups — flex + gap puts spacing on visible children only;
          display:none siblings don't count, which is why we use this instead
          of per-child top margins (filter would leave the sole visible
          non-first group with a 64px margin it shouldn't have). */
      }
      <div class="flex flex-col gap-16">
        {
          categories.map((category: CategoryInfo) => {
            const categoryServices = getServicesByCategory(category.id);
            return (
              <div data-category-group={category.id}>
                {/* Category Header */}
                <div class="mx-auto max-w-2xl">
                  <h3
                    id={`${headingId}-category-${category.id}-heading`}
                    class="text-foreground-950 scroll-mt-24 font-serif text-2xl font-bold tracking-tight sm:text-3xl dark:text-white"
                  >
                    {category.name}
                  </h3>
                  <hr role="presentation" class="border-foreground-200 mt-3 dark:border-white/10" />
                  <p class="text-foreground-700 mt-6 text-base/7 sm:text-lg/7 dark:text-gray-400">
                    {category.description}
                  </p>
                </div>

                {/* Service Cards Grid — columns adapt to service count per category:
                     2 services → max-w-4xl, 2 cols; 3 → max-w-6xl, 3 cols; 4+ → full width, 4 cols */}
                <ul
                  role="list"
                  data-animate-stagger
                  class:list={[
                    'mx-auto mt-10 grid gap-8',
                    categoryServices.length === 2
                      ? 'max-w-4xl grid-cols-1 md:grid-cols-2'
                      : categoryServices.length === 3
                        ? 'max-w-6xl grid-cols-1 md:grid-cols-2 lg:grid-cols-3'
                        : 'grid-cols-1 md:grid-cols-2 lg:grid-cols-4',
                  ]}
                >
                  {categoryServices.map((service) => (
                    <li data-animate="fade-up">
                      <ServiceCard service={service} />
                    </li>
                  ))}
                </ul>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { initServicesFilter } from '~/scripts/servicesFilterController';
  import { bootstrapOnLoad } from '~/utils/bootstrap';

  // Dual-dispatch init — see ADR-0026. bootstrapOnLoad handles both the
  // cold-load fallback and the View Transitions re-run; initServicesFilter
  // is idempotent via a data-initialized guard, so the overlap on initial
  // load when View Transitions are active is a no-op.
  bootstrapOnLoad(() => {
    document.querySelectorAll<HTMLElement>('[data-services-filter]').forEach(initServicesFilter);
  });
</script>
