---
/**
 * ServicePricingModelPill is the neutral descriptive pill labelling a service's
 * pricing model, currently used on session-based cards per ADR-0047.
 *
 * @useWhen You are composing ServiceCard and need to surface the session-based
 *   pricing model with a non-interactive descriptor pill at the top of the
 *   card.
 * @dontUseWhen You need an interactive routing affordance — use
 *   SuccessStoryServiceBadge for the navigation-pill pattern;
 *   ServicePricingModelPill is a plain `<span>` with no anchor.
 * @alternativeTo SuccessStoryServiceBadge — same visual grammar (`inline-flex
 *   w-fit items-center rounded-md px-1.5 py-0.5 text-xs font-medium`), opposite
 *   interaction model (interactive vs. descriptive).
 * @relatedTo ServiceCard — primary consumer.
 * @adr ADR-0047
 *
 * Rendered at the top of a service card whose pricing logic differs from the
 * subscription default — currently the session-based Posing & Stage Presence
 * card. It is the visual sibling of {@link SuccessStoryServiceBadge}: same
 * layout grammar (`inline-flex w-fit items-center rounded-md px-1.5 py-0.5
 * text-xs font-medium`), but non-interactive — a plain `<span>`, no anchor, no
 * routing, no chevron, no hover/focus link states — and a deliberately quieter
 * neutral palette so it reads as a descriptor, not a marketing badge.
 *
 * @example
 * ```astro
 * <ServicePricingModelPill label="Session-based" />
 * ```
 */
import { SERVICE_PRICING_MODEL_PILL_CLASS } from './servicePricingModelPillClasses';

type Props = {
  /** The pricing-model descriptor shown inside the pill, e.g. `Session-based`. */
  label: string;
};

const { label } = Astro.props;
---

<span class={SERVICE_PRICING_MODEL_PILL_CLASS}>{label}</span>
