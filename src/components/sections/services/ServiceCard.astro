---
/**
 * Service pricing card with dynamic pricing display.
 * Works with SegmentedControl for CSS-only price switching.
 *
 * **Important:** Must be used within a container with `group/tiers` class
 * for the pricing toggle to work correctly. Ensure SegmentedControl has
 * a default checked option, otherwise all prices will be hidden.
 *
 * @example
 * ```astro
 * <div class="group/tiers">
 *   <SegmentedControl name="frequency" options={billingPeriods} defaultValue="monthly" />
 *   <div class="grid grid-cols-3 gap-8">
 *     {services.map((service) => (
 *       <ServiceCard service={service} />
 *     ))}
 *   </div>
 * </div>
 * ```
 */

import Button from '~/components/ui/Button.astro';
import Card from '~/components/ui/Card.astro';
import CheckIcon from '~/components/ui/CheckIcon.astro';
import {
  type BillingPeriod,
  hasCompleteDetailContent,
  type PricingOption,
  type Service,
  serviceDetailHref,
} from '~/data/services';
import ServicePricingModelPill from './ServicePricingModelPill.astro';
import { formatSessionConfigurationCopy } from './sessionConfigurationCopy';

type Props = {
  /** Service data */
  service: Service;
  /** Custom CTA button label (defaults to "Get Started") */
  ctaLabel?: string;
  /** Whether the card sits on a dark section background */
  darkBackground?: boolean;
  /**
   * Call-site classification used to scope every `id` the card emits so
   * that catalog and homepage renderings of the same service can coexist
   * in one document without duplicate-id collisions. The `'catalog'`
   * default preserves the bare `service-${id}` shape that
   * `servicesFilterController` deep-links into via `getElementById`; the
   * `'homepage'` value adds a consumer prefix to every emitted id.
   */
  consumer?: 'catalog' | 'homepage';
};

const {
  service,
  ctaLabel = 'Get Started',
  darkBackground = false,
  consumer = 'catalog',
} = Astro.props;

// Scope every emitted id by consumer so catalog + homepage co-occurrence
// in a single document does not produce duplicate ids. The catalog default
// keeps the bare `service-${id}` shape required by the filter controller's
// deep-link contract (`getElementById('service-${id}')`).
const idPrefix =
  consumer === 'catalog' ? `service-${service.id}` : `service-${consumer}-${service.id}`;
const cardDomId = idPrefix;
const headingId = `${idPrefix}-title`;
const descriptionId = `${idPrefix}-desc`;

/**
 * Style variants based on background context.
 *
 * On dark section backgrounds (e.g. teal), cards use white backgrounds
 * with teal-tinted titles. On light backgrounds, cards use the default
 * ring-bordered style with accent-colored check icons.
 */
const styles = darkBackground
  ? {
      title: 'text-teal-600 dark:text-teal-400',
      description: 'text-foreground-600 dark:text-gray-400',
      price: 'text-foreground-950 dark:text-white',
      priceSuffix: 'text-foreground-600 dark:text-gray-400',
      priceNote: 'text-foreground-500 dark:text-gray-500',
      features: 'text-foreground-600 dark:text-gray-400',
      checkIcon: 'text-teal-500 dark:text-teal-400',
    }
  : {
      title: 'text-foreground-950 dark:text-white',
      description: 'text-foreground-600 dark:text-gray-300',
      price: 'text-foreground-950 dark:text-white',
      priceSuffix: 'text-foreground-600 dark:text-gray-400',
      priceNote: 'text-foreground-500 dark:text-gray-500',
      features: 'text-foreground-600 dark:text-gray-300',
      checkIcon: 'text-accent-600 dark:text-accent-400',
    };

/**
 * CSS classes for pricing visibility based on selected billing period.
 * Uses :has() selector to show/hide prices based on radio button state.
 * Must be static strings for Tailwind to detect during build.
 */
const pricingVisibility = {
  monthly: 'group-not-has-[[name=frequency][value=monthly]:checked]/tiers:hidden',
  'six-months': 'group-not-has-[[name=frequency][value=six-months]:checked]/tiers:hidden',
  'twelve-months': 'group-not-has-[[name=frequency][value=twelve-months]:checked]/tiers:hidden',
} satisfies Record<BillingPeriod, string>;
---

<div id={cardDomId} data-service-card={service.id} class="group hover-scale relative h-full">
  <Card darkBackground={darkBackground} class="h-full">
    <div slot="header">
      {
        service.pricingModel === 'session' && (
          <div class="mb-3">
            <ServicePricingModelPill label="Session-based" />
          </div>
        )
      }
      <h3 id={headingId} class:list={['text-lg/8 font-semibold', styles.title]}>
        {
          hasCompleteDetailContent(service) ? (
            <a
              href={serviceDetailHref(service.id)}
              aria-label={`Read details about ${service.name}`}
            >
              {/* Stretch link over entire card */}
              <span class="absolute inset-0" aria-hidden="true" />
              {service.name}
            </a>
          ) : (
            <a href={service.contactHref}>
              {/* Stretch link over entire card */}
              <span class="absolute inset-0" aria-hidden="true" />
              {service.name}
            </a>
          )
        }
      </h3>
      <p id={descriptionId} class:list={['mt-4 text-sm/6', styles.description]}>
        {service.description}
      </p>
    </div>

    {
      /* Pricing display.
       Subscription services emit one toggle-coupled row per billing period
       (the `:has()` visibility mechanism driven by the SegmentedControl).
       Session-based services (ADR-0047) sit out the toggle entirely: a
       static `from €X / session` anchor plus a single line of micro-copy
       describing the package axes, derived from `service.configuration`.
       The `from` qualifier is session-only — on a subscription card it
       would wrongly imply a month-by-month commitment. */
    }
    {
      service.pricingModel === 'session' ? (
        <div class="mt-6">
          <p class="flex items-baseline gap-x-1">
            <span class:list={['text-sm/6 font-semibold', styles.priceSuffix]}>from</span>
            <span class:list={['text-2xl font-semibold tracking-tight', styles.price]}>
              {service.pricing[0].price}
            </span>
            <span class:list={['text-sm/6 font-semibold', styles.priceSuffix]}>
              / {service.pricing[0].suffix.replace('/', '')}
            </span>
          </p>
          <p class:list={['mt-1 text-xs', styles.priceNote]}>
            {formatSessionConfigurationCopy(service.configuration)}
          </p>
        </div>
      ) : (
        service.pricing.map((pricing: PricingOption) => (
          <p class:list={['mt-6 flex items-baseline gap-x-1', pricingVisibility[pricing.period]]}>
            <span class:list={['text-4xl font-semibold tracking-tight', styles.price]}>
              {pricing.price}
            </span>
            <span class:list={['text-sm/6 font-semibold', styles.priceSuffix]}>
              {pricing.suffix}
            </span>
            {pricing.note && (
              <span class:list={['ml-2 text-xs', styles.priceNote]}>({pricing.note})</span>
            )}
          </p>
        ))
      )
    }

    <ul role="list" class:list={['mt-8 space-y-3 text-sm/6', styles.features]}>
      {
        service.features.map((feature: string) => (
          <li class="flex gap-x-3">
            <CheckIcon class={styles.checkIcon} />
            {feature}
          </li>
        ))
      }
    </ul>

    <div slot="footer" class="flex flex-col gap-y-2">
      {
        hasCompleteDetailContent(service) ? (
          <>
            <Button
              href={serviceDetailHref(service.id)}
              variant="primary"
              aria-label={`Read details about ${service.name}`}
              class="relative z-10 w-full justify-center"
            >
              Read Details
              <span aria-hidden="true">→</span>
            </Button>
            <a
              href={service.contactHref}
              aria-label={`Contact us about ${service.name}`}
              class="text-foreground-500 relative z-10 inline-block self-center px-3 py-2 text-sm hover:underline dark:text-gray-400"
            >
              Skip ahead — contact us
            </a>
          </>
        ) : (
          <Button
            href={service.contactHref}
            variant="primary"
            class="relative z-10 w-full justify-center"
          >
            {ctaLabel}
          </Button>
        )
      }
    </div>
  </Card>
</div>
