---
/**
 * MissionBlock — mission-driven introduction for the Services overview.
 *
 * Renders content supplied by the page via the `content` prop: a
 * heading, a short paragraph, three per-coach mission-connected
 * sentences (one per coach in `coachesExpanded`), and a transition
 * line. The page chooses what to display; this component is the
 * presentation.
 *
 * The component DELIBERATELY does NOT render:
 *
 *   - per-coach specialisation labels (the `coach.credentialLine`
 *     field is rendered on success-story surfaces but not here)
 *   - a `<StatsGrid>` tile (the year-based stats appear as inline
 *     body text instead, derived in-component from `~/data/stats`)
 *
 * Adding either back is a brand-positioning change, not a tidy-up.
 * Consult the project owner before moving this surface toward a
 * conventional coach-card pattern. The project-wide rule that names
 * this surface is documented in
 * `docs/CONVENTIONS.md` § Services Overview Coach Presentation
 * (anchor: services-overview-coach-presentation).
 *
 * Placeholder-copy lifecycle protection: strings provided in
 * `content` that ship `[PLACEHOLDER]`-prefixed are visible in the
 * rendered DOM by design — a forgotten placeholder is a publicly
 * visible failure rather than a silent one. The content brief and
 * the placeholder strings live in `~/data/servicesMission.ts`.
 */
import SmartImage from '~/components/ui/SmartImage.astro';
import { coachesExpanded } from '~/data/coaches';
import type { MissionBlockContent } from '~/data/servicesMission';
import { statsSection } from '~/data/stats';

type Props = {
  readonly content: MissionBlockContent;
};

const { content } = Astro.props;

const yearsCoaching = statsSection.stats.yearsCoaching.target;
const yearsCompeting = statsSection.stats.yearsCompeting.target;
// Pulled from the canonical stats catalog (~/data/stats.ts) so the
// homepage Stats tiles and this block share a single source of truth.
const statsSentence = `Together, the team brings ${yearsCoaching}+ years of coaching and ${yearsCompeting} years of competing experience.`;
---

<div class="mx-auto mt-10 max-w-3xl" data-animate="fade-up">
  <h3
    class="text-foreground-950 font-serif text-2xl font-bold tracking-tight text-balance sm:text-3xl dark:text-white"
  >
    {content.heading}
  </h3>
  <p class="text-foreground-700 mt-4 text-left text-lg text-pretty sm:text-xl/8 dark:text-gray-400">
    {content.paragraph}
  </p>

  <ul data-animate-stagger class="mt-10 grid grid-cols-1 gap-8 text-left sm:grid-cols-3">
    {
      coachesExpanded.map((coach) => (
        <li
          data-animate="fade-up"
          class="flex flex-col items-center text-center sm:items-start sm:text-left"
        >
          <SmartImage
            src={coach.image}
            alt={coach.firstName}
            widths={[160, 320]}
            sizes="160px"
            class="size-32 rounded-full object-cover sm:size-36"
          />
          <p class="text-foreground-950 mt-4 text-base font-semibold dark:text-white">
            {coach.firstName}
          </p>
          <p class="text-foreground-700 mt-2 text-sm text-pretty sm:text-base dark:text-gray-400">
            {content.coachSentences[coach.id]}
          </p>
        </li>
      ))
    }
  </ul>

  <p
    class="text-foreground-700 mt-10 text-left text-base text-pretty sm:text-lg dark:text-gray-400"
  >
    {statsSentence}
  </p>

  <p
    class="text-foreground-700 mt-10 text-center text-lg font-medium text-pretty sm:text-xl/8 dark:text-gray-400"
  >
    {content.transitionLine}
  </p>
</div>
