---
/**
 * Category tabs for filtering services on the services page.
 * Shows a dropdown on mobile and pill-style tabs on desktop.
 * Switches visible content instead of scrolling to sections.
 *
 * Supports deep-linking via:
 * - URL parameter: `/services?category=bodybuilding` (from quiz results)
 * - Hash: `/services#bodybuilding` (category) or `/services#competition-prep` (service)
 *
 * Uses {@link PillSwitcher} for the shared tab/select template.
 *
 * @example
 * ```astro
 * <ServiceCategoryTabs />
 * ```
 */
import PillSwitcher from '~/components/ui/PillSwitcher.astro';
import { categories, services, type ServiceCategory } from '~/data/services';

type Props = {
  /** Initially active category */
  defaultCategory?: ServiceCategory;
};

const { defaultCategory = 'bodybuilding' } = Astro.props;

// Build service-to-category mapping for client-side use
const serviceToCategoryMap = Object.fromEntries(
  services.map((service) => [service.id, service.category]),
);
---

<div data-category-tabs data-service-map={JSON.stringify(serviceToCategoryMap)}>
  <PillSwitcher
    items={categories.map((c) => ({ id: c.id, label: c.name }))}
    defaultValue={defaultCategory}
    ariaLabel="Service categories"
    name="category"
    variant="tabs"
  />
</div>

<script>
  /**
   * ServiceCategoryTabs Controller
   * Handles tab switching, content visibility, and deep-linking to services.
   *
   * Deep-linking supports:
   * - URL parameter: /services?category=bodybuilding&service=competition-prep
   * - Hash: /services#bodybuilding (category) or /services#competition-prep (service)
   */

  // Tab style classes — coupled to PillSwitcher.astro's active/inactive styles.
  // If PillSwitcher changes its color tokens, these must be updated in sync.
  const ACTIVE_CLASSES = ['bg-accent-600', 'text-white', 'dark:bg-accent-500'];
  const INACTIVE_CLASSES = [
    'text-foreground-600',
    'hover:bg-foreground-100',
    'hover:text-foreground-950',
    'dark:text-gray-400',
    'dark:hover:bg-white/10',
    'dark:hover:text-white',
  ];

  /** Highlight delay — wait for tab panel to render before highlighting */
  const HIGHLIGHT_DELAY_MS = 400;
  /** Highlight duration — how long the pulse animation stays visible */
  const HIGHLIGHT_DURATION_MS = 3000;
  /** Scroll delay — wait for DOM update before scrolling */
  const SCROLL_DELAY_MS = 100;

  /** Initialize a single ServiceCategoryTabs instance. Must be idempotent. */
  function initCategoryTabs(container: HTMLElement): void {
    if (container.dataset.initialized === 'true') return;
    container.dataset.initialized = 'true';

    const select = container.querySelector<HTMLSelectElement>('[data-category-select]');
    const tabs = container.querySelectorAll<HTMLButtonElement>('[data-category-tab]');

    // Scope panel query to the enclosing ServicesCatalog to avoid cross-instance
    // interference if multiple catalogs exist on the same page.
    const catalog = container.closest<HTMLElement>('[data-services-catalog]');
    const panels = (catalog ?? document).querySelectorAll<HTMLElement>('[data-category-panel]');

    // Derive categoryIds from DOM instead of hardcoding
    const categoryIds = Array.from(tabs)
      .map((tab) => tab.getAttribute('data-category-tab'))
      .filter((id): id is string => id !== null);

    // Load service-to-category mapping
    const serviceMapData = container.dataset.serviceMap;
    const serviceToCategory: Record<string, string> = serviceMapData
      ? JSON.parse(serviceMapData)
      : {};

    function switchCategory(categoryId: string, scrollToServiceId: string | null): void {
      // Update tabs
      tabs.forEach((tab) => {
        const tabId = tab.getAttribute('data-category-tab');
        const isActive = tabId === categoryId;

        ACTIVE_CLASSES.forEach((cls) => tab.classList.toggle(cls, isActive));
        INACTIVE_CLASSES.forEach((cls) => tab.classList.toggle(cls, !isActive));

        tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
        tab.setAttribute('tabindex', isActive ? '0' : '-1');
      });

      // Update panels
      panels.forEach((panel) => {
        const panelId = panel.getAttribute('data-category-panel');
        const isActive = panelId === categoryId;

        panel.classList.toggle('hidden', !isActive);
        panel.setAttribute('aria-hidden', isActive ? 'false' : 'true');
        panel.setAttribute('tabindex', isActive ? '0' : '-1');
      });

      // Update mobile select
      if (select) {
        select.value = categoryId;
      }

      // Highlight specific service if provided (deep-link from quiz)
      if (scrollToServiceId) {
        setTimeout(() => {
          const serviceEl = document.getElementById(`service-${scrollToServiceId}`);
          if (serviceEl) {
            serviceEl.classList.add('quiz-highlight');
            setTimeout(() => {
              serviceEl.classList.remove('quiz-highlight');
            }, HIGHLIGHT_DURATION_MS);
          }
        }, HIGHLIGHT_DELAY_MS);
      }

      // Update URL hash
      const newHash = scrollToServiceId || categoryId;
      history.replaceState(null, '', `#${encodeURIComponent(newHash)}`);
    }

    // Mobile: Switch on select change
    select?.addEventListener('change', () => {
      if (select.value) switchCategory(select.value, null);
    });

    // Desktop: Switch on tab click
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const categoryId = tab.getAttribute('data-category-tab');
        if (categoryId) switchCategory(categoryId, null);
      });
    });

    // Keyboard navigation (WAI-ARIA tabs pattern)
    tabs.forEach((tab, index) => {
      tab.addEventListener('keydown', (e: KeyboardEvent) => {
        let newIndex = index;

        if (e.key === 'ArrowRight') {
          newIndex = (index + 1) % tabs.length;
        } else if (e.key === 'ArrowLeft') {
          newIndex = (index - 1 + tabs.length) % tabs.length;
        } else if (e.key === 'Home') {
          newIndex = 0;
        } else if (e.key === 'End') {
          newIndex = tabs.length - 1;
        } else {
          return;
        }

        e.preventDefault();
        const newTab = tabs[newIndex];
        newTab.focus();
        const categoryId = newTab.getAttribute('data-category-tab');
        if (categoryId) switchCategory(categoryId, null);
      });
    });

    // Deep-link handling: URL parameter (?category=&service=) or hash
    function handleDeepLink(): void {
      // 1. Check URL parameters (from quiz results)
      const params = new URLSearchParams(window.location.search);
      const categoryParam = params.get('category');
      const serviceParam = params.get('service');
      if (categoryParam && categoryIds.includes(categoryParam)) {
        switchCategory(categoryParam, serviceParam);
        // Scroll to service card if provided, otherwise to tabs container
        setTimeout(() => {
          if (serviceParam) {
            const serviceEl = document.getElementById(`service-${serviceParam}`);
            if (serviceEl) {
              serviceEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
              return;
            }
          }
          container.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, SCROLL_DELAY_MS);
        return;
      }

      // 2. Check hash (from on-page links)
      const hash = decodeURIComponent(window.location.hash.slice(1));
      if (!hash) return;

      // Check if it's a category
      if (categoryIds.includes(hash)) {
        switchCategory(hash, null);
        return;
      }

      // Check if it's a service
      const category = serviceToCategory[hash];
      if (category) {
        switchCategory(category, hash);
      }
    }

    // Run on load
    handleDeepLink();

    // Handle hash changes
    window.addEventListener('hashchange', handleDeepLink);
  }

  /** Find and initialize all ServiceCategoryTabs instances on the page. */
  function initAll(): void {
    document.querySelectorAll<HTMLElement>('[data-category-tabs]').forEach(initCategoryTabs);
  }

  // Executes once when the module loads. The listener persists and fires
  // on every View Transition navigation.
  document.addEventListener('astro:page-load', initAll);
</script>
