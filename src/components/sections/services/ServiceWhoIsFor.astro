---
/**
 * Single-column "Who this is for" eligibility list for the service detail
 * page (`/services/[slug]`).
 *
 * Reads `service.fitFor` (positive). The launch-gate predicate
 * ({@link hasCompleteDetailContent}: `fitFor.length >= 3`) guarantees the
 * array is populated, so this section relies on the page-level narrowing
 * and does not optional-chain at the consumption site.
 *
 * The previous two-column layout paired this list with a negative
 * "This isn't a fit if…" column sourced from `service.notFitFor`. The
 * negative surface was dropped from the schema; the eligibility-filter
 * load redistributes onto the Hero lead's filter half-sentence, fitFor
 * specificity, and the FAQ highlight above the accordion. The
 * single-column reading box (`max-w-3xl`) sits inside the `max-w-5xl`
 * outer container so the section's left edge aligns with
 * `ServiceWhatsIncluded` on desktop.
 *
 * The copy convention (Conversion-review guideline) requires entries to be
 * timing- or situation-framed, never identity statements. That contract
 * lives at the data level (per-service copy); this component only renders
 * what the data carries.
 *
 * Generates its own heading id (`service-who-is-for-<id>`) and wires it to
 * the section's `aria-labelledby` — caller-side prop unnecessary, the page
 * composition does not wrap this section in a shared landmark.
 *
 * @example
 * ```astro
 * <ServiceWhoIsFor service={service} />
 * ```
 */
import CheckIcon from '~/components/ui/CheckIcon.astro';
import type { SubscriptionServiceWithCompleteDetailContent } from '~/data/services';
import { sectionBackground } from '~/styles/sectionStyles';

type Props = {
  /**
   * Detail-eligible subscription-arm service rendered on this page. Pinned
   * to the subscription arm because the session-arm detail page composes
   * a configurator in place of the long-form sections (ADR-0051) — only
   * subscription-arm services carry the `fitFor` field this component
   * renders.
   */
  service: SubscriptionServiceWithCompleteDetailContent;
};

const { service } = Astro.props;

const headingId = `service-who-is-for-${service.id}`;
---

<section
  class:list={['px-6 py-16 sm:py-24 lg:px-8', sectionBackground.muted]}
  aria-labelledby={headingId}
>
  <div class="mx-auto max-w-5xl">
    <h2
      id={headingId}
      class="text-foreground-950 font-serif text-3xl font-bold tracking-tight sm:text-4xl dark:text-white"
      data-animate="fade-up"
    >
      Who this is for
    </h2>

    <div class="mt-12 max-w-3xl" data-animate="fade-up">
      <h3 class="text-foreground-950 text-xl font-semibold dark:text-white">This is a fit if…</h3>
      <ul role="list" class="text-foreground-700 mt-6 space-y-3 text-base/7 dark:text-gray-300">
        {
          service.fitFor.map((entry) => (
            <li class="flex gap-x-3">
              <CheckIcon class="text-accent-600 dark:text-accent-400 mt-1" />
              <span>{entry}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
