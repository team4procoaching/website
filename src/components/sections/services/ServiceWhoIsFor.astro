---
/**
 * Two-column "Who this is for" / "Who this isn't for" lists for the
 * service detail page (`/services/[slug]`).
 *
 * Reads `service.fitFor` (positive) and `service.notFitFor` (negative).
 * Both arrays are guaranteed populated by the launch-gate predicate
 * ({@link hasCompleteDetailContent}: `fitFor.length >= 3`,
 * `notFitFor.length >= 2`) — this section relies on the page-level
 * narrowing and does not optional-chain at the consumption site.
 *
 * The copy convention (Conversion-review guideline) requires entries to be
 * timing- or situation-framed, never identity statements. That contract
 * lives at the data level (commit 8 stub content + future per-service
 * copy); this component only renders what the data carries.
 *
 * Generates its own heading id (`service-who-is-for-<id>`) and wires it to
 * the section's `aria-labelledby` — caller-side prop unnecessary, the page
 * composition does not wrap this section in a shared landmark.
 *
 * @example
 * ```astro
 * <ServiceWhoIsFor service={service} />
 * ```
 */
import CheckIcon from '~/components/ui/CheckIcon.astro';
import type { ServiceWithCompleteDetailContent } from '~/data/services';
import { sectionBackground } from '~/styles/sectionStyles';

type Props = {
  /** Detail-eligible service rendered on this page. */
  service: ServiceWithCompleteDetailContent;
};

const { service } = Astro.props;

const headingId = `service-who-is-for-${service.id}`;
---

<section
  class:list={['px-6 py-16 sm:py-24 lg:px-8', sectionBackground.muted]}
  aria-labelledby={headingId}
>
  <div class="mx-auto max-w-5xl">
    <h2
      id={headingId}
      class="text-foreground-950 font-serif text-3xl font-bold tracking-tight sm:text-4xl dark:text-white"
      data-animate="fade-up"
    >
      Who this is for
    </h2>

    <div class="mt-12 grid grid-cols-1 gap-x-12 gap-y-10 lg:grid-cols-2" data-animate-stagger>
      <div data-animate="fade-up">
        <h3 class="text-foreground-950 text-xl font-semibold dark:text-white">This is a fit if…</h3>
        <ul role="list" class="text-foreground-700 mt-6 space-y-3 text-base/7 dark:text-gray-300">
          {
            service.fitFor.map((entry) => (
              <li class="flex gap-x-3">
                <CheckIcon class="text-accent-600 dark:text-accent-400 mt-1" />
                <span>{entry}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div data-animate="fade-up">
        <h3 class="text-foreground-950 text-xl font-semibold dark:text-white">
          This isn't a fit if…
        </h3>
        <ul role="list" class="text-foreground-700 mt-6 space-y-3 text-base/7 dark:text-gray-300">
          {
            service.notFitFor.map((entry) => (
              <li class="flex gap-x-3">
                {/* Decorative em-dash bullet — neutral negative marker without
                    introducing a new icon component. CheckIcon would imply a
                    positive item; an X-mark icon would be a new abstraction
                    not listed in the concept doc. */}
                <span
                  aria-hidden="true"
                  class="text-foreground-400 mt-1 flex-none dark:text-gray-500"
                >
                  —
                </span>
                <span>{entry}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
