---
/**
 * ServiceLockedLine is a read-only service-name display line, with
 * hidden-by-default visibility and a `data-locked-service-name`
 * placeholder populated by `contactFormController` after a Configurator
 * deep-link.
 *
 * @useWhen You are composing the contact form and the visitor arrived via
 *   a strong-intent deep-link — a Configurator triple
 *   (`?service=&duration=&package=`) or a subscription `?service=<id>`;
 *   the service is locked to the deep-link's pick and should not be
 *   editable on the form.
 * @dontUseWhen You need an editable service selector for non-strong-intent
 *   landings (bare `/contact`, bare session `?service=posing` with no
 *   configurator triple, quiz-only) — use FormSelect directly; it remains
 *   the visible default and the only editable surface for service selection.
 *   A bare session id only preselects the editable dropdown; it does not
 *   lock.
 * @alternativeTo FormSelect — FormSelect is the editable service picker;
 *   ServiceLockedLine is the read-only display the controller swaps in
 *   on the two strong-intent paths (Configurator triple, subscription
 *   `?service=<id>`). Exactly one of the two is visible at any time; the
 *   controller enforces this.
 * @relatedTo ContactForm — primary consumer; lives in
 *   `data-service-locked-wrapper` next to the `FormSelect` wrapper.
 * @relatedTo ConfiguratorContextBox — sibling under
 *   `contactFormController`; both unhide together on the configurator
 *   path and consume the same `parseConfiguratorParams` resolution.
 * @relatedTo SubscriptionContextBox — sibling under
 *   `contactFormController`; both unhide together on the subscription
 *   `?service=<id>` strong-intent path.
 * @relatedTo contactFormController — runtime owner; the controller
 *   populates `[data-locked-service-name]` via `.textContent` and
 *   removes `hidden` from the wrapper.
 * @adr ADR-0051
 * @adr ADR-0061
 *
 * Stays hidden by default so visitors who arrive without a valid
 * Configurator deep-link never see an empty line flash before
 * client-side init runs.
 *
 * @example
 * ```astro
 * <div data-service-locked-wrapper class="hidden">
 *   <ServiceLockedLine label={contactSection.lockedServiceLabel} />
 * </div>
 * ```
 */

type Props = {
  /** Static label literal rendered before the resolved service name (e.g. `'Service:'`) */
  label: string;
};

const { label } = Astro.props;

const labelClasses = 'block text-sm/6 font-semibold text-foreground-950 dark:text-white';
---

<div class="sm:col-span-2">
  <p class={labelClasses}>
    <span>{label}</span>
    <span class="text-foreground-700 ml-1 font-normal dark:text-gray-300" data-locked-service-name
    ></span>
  </p>
</div>
