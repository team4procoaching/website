---
/**
 * ContactForm is the Netlify-powered contact form with required service
 * dropdown, optional quiz / Configurator context summary cards, honeypot spam
 * protection, and GDPR privacy notice.
 *
 * @useWhen You are composing the contact page (or any page that needs a contact
 *   form) and want the full prefill flow — service dropdown, quiz /
 *   Configurator context, hidden quiz-answer fields, GDPR notice — out of the
 *   box.
 * @dontUseWhen You need only a generic form without the Netlify / quiz /
 *   Configurator wiring — write the form inline; ContactForm bundles the
 *   service-context resolution.
 * @relatedTo Contact — typical wrapper; Contact's `form` slot accepts
 *   ContactForm.
 * @relatedTo QuizContextBox — rendered above the fields when quiz context
 *   resolves.
 * @relatedTo ConfiguratorContextBox — rendered above the fields when a
 *   Configurator deep-link resolves; wins over quiz when both are present.
 * @relatedTo SubscriptionContextBox — rendered above the fields when a
 *   subscription `?service=<id>` deep-link resolves; the session-class
 *   sibling of ConfiguratorContextBox.
 * @relatedTo QuizModal — quiz context is persisted by QuizModal and consumed
 *   here.
 * @relatedTo PackageCard — Configurator deep-link source.
 * @relatedTo FormSelect — renders the service dropdown.
 * @relatedTo ServiceLockedLine — read-only service line swapped in by the
 *   controller on a Configurator deep-link; sits in
 *   `data-service-locked-wrapper` next to the `FormSelect` wrapper.
 * @relatedTo SubmitButton — renders the form submit button.
 * @adr ADR-0021
 * @adr ADR-0026
 * @adr ADR-0051
 *
 * Designed to be used inside Contact.astro via the `form` slot,
 * but can also be used standalone on other pages with different layouts.
 *
 * Features:
 * - Required service dropdown with a 'Not sure yet' escape option,
 *   preselected via URL parameter or sessionStorage
 * - Quiz summary card when arriving from the quiz flow
 * - Quiz answers included as hidden fields in Netlify form submission
 * - Configurator context card when arriving via a configurator
 *   deep-link (`?service=&duration=&package=`); when both Configurator
 *   and Quiz parameters are present, Configurator wins and quiz hidden
 *   fields are not injected
 * - GDPR privacy notice under the submit button linking to the Privacy
 *   Policy
 *
 * Quiz context is read from sessionStorage (persisted by QuizModal) with
 * URL parameter `?service=` as fallback for direct ServiceCard links.
 * See `~/utils/quizContext.ts` for the shared storage utility.
 *
 * @example
 * ```astro
 * <ContactForm
 *   slot="form"
 *   name={contactSection.form.name}
 *   action={contactSection.form.successRedirect}
 *   submitLabel={contactSection.form.submitLabel}
 *   lockedServiceLabel={contactSection.lockedServiceLabel}
 * />
 * ```
 */

import FormSelect from '~/components/ui/FormSelect.astro';
import SubmitButton from '~/components/ui/SubmitButton.astro';
import { routes } from '~/data/routes';
import { categories, getServicesByCategory } from '~/data/services';
import ConfiguratorContextBox from './ConfiguratorContextBox.astro';
import QuizContextBox from './QuizContextBox.astro';
import ServiceLockedLine from './ServiceLockedLine.astro';
import SubscriptionContextBox from './SubscriptionContextBox.astro';

type Props = {
  /** Netlify form name */
  name: string;
  /** Form action URL (redirect after successful submission) */
  action?: string;
  /** Submit button label */
  submitLabel: string;
  /**
   * Static label literal rendered before the resolved service name on the
   * locked service line shown after a Configurator deep-link (e.g.
   * `'Service:'`). Sourced from `contactSection.lockedServiceLabel`.
   */
  lockedServiceLabel: string;
  /**
   * Link text for the always-shown "ask about a different service" link in
   * the context-box shell, shared by the configurator and subscription
   * boxes. Sourced from `contactSection.subscriptionBoxDifferentServiceLabel`.
   */
  differentServiceLabel: string;
  /**
   * Uppercase label rendered above the subscription context box body.
   * Sourced from `contactSection.subscriptionBoxHeading`.
   */
  subscriptionBoxHeading: string;
  /**
   * Link text for the subscription box's conditional program-details link.
   * Sourced from `contactSection.subscriptionBoxDetailLabel`.
   */
  subscriptionBoxDetailLabel: string;
};

const {
  name,
  action,
  submitLabel,
  lockedServiceLabel,
  differentServiceLabel,
  subscriptionBoxHeading,
  subscriptionBoxDetailLabel,
} = Astro.props;

// Prefix field IDs with form name to prevent collision when
// multiple ContactForm instances exist on the same page.
const idPrefix = `${name}-`;

// Reusable input classes to avoid duplication
const inputClasses =
  'block w-full rounded-md bg-white px-3.5 py-2 text-base text-foreground-950 outline outline-1 -outline-offset-1 outline-foreground-300 placeholder:text-foreground-400 focus:outline-2 focus:-outline-offset-2 focus:outline-accent-600 dark:bg-white/5 dark:text-white dark:outline-white/10 dark:placeholder:text-gray-500 dark:focus:outline-accent-500';

const labelClasses = 'block text-sm/6 font-semibold text-foreground-950 dark:text-white';

// Build grouped service options for the dropdown
const serviceGroups = categories.map((category) => ({
  label: category.name,
  services: getServicesByCategory(category.id).map((s) => ({ id: s.id, name: s.name })),
}));

// Value emitted on the wire when the visitor explicitly selects "Not sure
// yet" instead of a service. Typed as a literal so future filter/routing
// logic that imports this constant inherits the narrowed type and
// TypeScript surfaces drift on rename. Symmetric with the loop-bound
// `value={s.id}` options — every option's value either flows from
// `servicesById` (the loop) or from this constant (the hardcoded
// option), both visible in the frontmatter.
const NOT_SURE_OPTION_VALUE = 'not-sure-yet' as const;
---

<form
  name={name}
  method="POST"
  action={action}
  data-netlify="true"
  netlify-honeypot="bot-field"
  class="px-6 pt-20 pb-24 sm:pb-32 lg:px-8 lg:py-48"
  aria-label="Contact form"
  data-contact-form
>
  <input type="hidden" name="form-name" value={name} />

  {/* Honeypot field for spam protection - hidden from users and assistive technology */}
  <p class="hidden" aria-hidden="true">
    <label>
      Don't fill this out if you're human:
      <input name="bot-field" tabindex="-1" autocomplete="off" aria-hidden="true" />
    </label>
  </p>

  <div class="mx-auto max-w-xl lg:mr-0 lg:max-w-lg">
    {/* Quiz summary — populated client-side when quiz context is available */}
    <QuizContextBox heading="Based on your quiz answers:" />
    {
      /* Configurator summary — populated client-side from URL parameters when a
        valid configurator deep-link landed the visitor here. Wins over
        the quiz branch when both sets of parameters are present. */
    }
    <ConfiguratorContextBox
      heading="Your selected package"
      differentServiceLabel={differentServiceLabel}
    />
    {
      /* Subscription summary — populated client-side from a subscription
        `?service=<id>` deep-link. The session-class sibling of the
        configurator box; exactly one of the two unhides per landing. */
    }
    <SubscriptionContextBox
      heading={subscriptionBoxHeading}
      detailLabel={subscriptionBoxDetailLabel}
      differentServiceLabel={differentServiceLabel}
    />

    <div class="grid grid-cols-1 gap-x-8 gap-y-6 sm:grid-cols-2">
      <div>
        <label for={`${idPrefix}first-name`} class={labelClasses}>First name</label>
        <div class="mt-2.5">
          <input
            id={`${idPrefix}first-name`}
            type="text"
            name="first-name"
            autocomplete="given-name"
            required
            class={inputClasses}
          />
        </div>
      </div>

      <div>
        <label for={`${idPrefix}last-name`} class={labelClasses}>Last name</label>
        <div class="mt-2.5">
          <input
            id={`${idPrefix}last-name`}
            type="text"
            name="last-name"
            autocomplete="family-name"
            required
            class={inputClasses}
          />
        </div>
      </div>

      <div class="sm:col-span-2">
        <label for={`${idPrefix}email`} class={labelClasses}>Email</label>
        <div class="mt-2.5">
          <input
            id={`${idPrefix}email`}
            type="email"
            name="email"
            autocomplete="email"
            required
            class={inputClasses}
          />
        </div>
      </div>

      <div class="sm:col-span-2">
        <label for={`${idPrefix}phone`} class={labelClasses}>
          Phone <span class="text-foreground-400 font-normal dark:text-gray-500">(optional)</span>
        </label>
        <div class="mt-2.5">
          <input
            id={`${idPrefix}phone`}
            type="tel"
            name="phone"
            autocomplete="tel"
            class={inputClasses}
          />
        </div>
      </div>

      <div data-service-select-wrapper class="sm:col-span-2">
        <FormSelect
          id={`${idPrefix}service`}
          name="service"
          label="Service"
          required
          data-service-select
        >
          <option value="">Select a service…</option>
          <option value={NOT_SURE_OPTION_VALUE}>Not sure yet</option>
          {
            serviceGroups.map((group) => (
              <optgroup label={group.label}>
                {group.services.map((s) => (
                  <option value={s.id}>{s.name}</option>
                ))}
              </optgroup>
            ))
          }
        </FormSelect>
      </div>
      <div data-service-locked-wrapper class="hidden sm:col-span-2">
        <ServiceLockedLine label={lockedServiceLabel} />
      </div>

      <div class="sm:col-span-2">
        <label for={`${idPrefix}message`} class={labelClasses}>Message</label>
        <div class="mt-2.5">
          <textarea id={`${idPrefix}message`} name="message" rows="4" required class={inputClasses}
          ></textarea>
        </div>
      </div>
    </div>

    <div class="mt-8 flex justify-end">
      <SubmitButton>{submitLabel}</SubmitButton>
    </div>

    <p class="text-foreground-500 mt-6 text-xs dark:text-gray-500">
      By submitting, you agree your data is processed by Team 4 Pro Coaching LLC (Florida, USA) and
      stored on US-based servers. See our <a
        href={routes.privacy}
        class="text-accent-700 dark:text-accent-400 focus-visible:outline-accent-600 rounded-sm underline underline-offset-2 focus-visible:outline-2 focus-visible:outline-offset-2"
        >Privacy Policy</a
      >.
    </p>
  </div>
</form>

<script>
  import { initSingleContactForm } from '~/scripts/contactFormController';
  import { bootstrapOnLoad } from '~/utils/bootstrap';

  bootstrapOnLoad(() => {
    document
      .querySelectorAll<HTMLFormElement>('[data-contact-form]')
      .forEach(initSingleContactForm);
  });
</script>
