---
import ContextBoxShell from './ContextBoxShell.astro';

/**
 * ConfiguratorContextBox is the configurator-summary card rendered above the
 * contact form, populated client-side from URL parameters with a price-anchor
 * visual treatment.
 *
 * @useWhen You are composing the contact form and want a summary card to appear
 *   above the fields when the visitor arrives via a Configurator deep-link
 *   (`?service=&duration=&package=`).
 * @dontUseWhen You need the quiz summary card with multiple Q/A rows — use
 *   QuizContextBox, which has the dl/dt/dd shape for quiz-answer pairs.
 * @alternativeTo QuizContextBox — Configurator wins over Quiz when both arrive;
 *   ContactForm's init script enforces this.
 * @relatedTo ContactForm — primary consumer; ContactForm's init script
 *   populates the `data-cfg-*` placeholders.
 * @relatedTo PackageCard — emits the URL params that trigger this box's render.
 * @relatedTo ServiceLockedLine — sibling under contactFormController;
 *   both unhide together on the configurator path.
 * @relatedTo ThanksSelectionSummary — paired post-submission restate;
 *   ThanksSelectionSummary is the read-only thanks-page counterpart to
 *   this pre-submission summary.
 * @relatedTo SubscriptionContextBox — the subscription-class sibling;
 *   exactly one of the two renders per landing (session vs. subscription).
 * @relatedTo ContextBoxShell — shared card chrome; this box supplies its
 *   config + price-matrix body and the change-package primary link, the
 *   shell owns the wrapper, label, and different-service link.
 * @relatedTo contactFormController — runtime owner; the controller
 *   populates the `data-cfg-*` placeholders and removes `hidden` from
 *   `[data-configurator-summary]`.
 * @adr ADR-0021
 * @adr ADR-0051
 *
 * Holds the configurator-specific body (placeholder lines + change-package
 * affordance) declaratively in the template and delegates the shared chrome
 * (outer wrapper, neutral card, label, different-service link) to
 * {@link ContextBoxShell}; the form-init script in `ContactForm.astro`
 * populates the `data-cfg-*` placeholder elements with the parsed
 * Configurator selection (service display name, configuration line, total
 * price, change-package back-link href) and unhides the wrapper by removing
 * the `hidden` class on `[data-configurator-summary]`.
 *
 * The two action affordances split a previously single "change selection"
 * link into the visitor's two distinct intents: "Change package" routes
 * back to the configurator with the current selection pre-filled (href
 * populated client-side via `[data-cfg-href]`), while the shell's "ask about
 * a different service" link routes to the bare contact page so the visitor
 * can start over with a different service entirely.
 *
 * Stays hidden by default so visitors who arrive without a valid
 * Configurator deep-link never see an empty card flash before client-side
 * init runs. The transactional / price-anchor visual treatment intentionally
 * differs from the quiz summary's accent-tone informative treatment — the
 * Configurator box is the visual anchor for visitors who have already
 * configured and priced their selection.
 *
 * @example
 * ```astro
 * <ConfiguratorContextBox
 *   heading="Your selected package"
 *   differentServiceLabel="Ask about a different service"
 * />
 * ```
 */

type Props = {
  /** Small label rendered above the price-anchor block */
  heading: string;
  /** Link text for the shell's always-shown different-service link */
  differentServiceLabel: string;
};

const { heading, differentServiceLabel } = Astro.props;
---

<ContextBoxShell
  summaryAttr="data-configurator-summary"
  heading={heading}
  differentServiceLabel={differentServiceLabel}
>
  <p class="text-foreground-950 mt-2 text-lg font-semibold dark:text-white" data-cfg-service></p>
  <p class="text-foreground-700 mt-1 text-sm dark:text-gray-300" data-cfg-config></p>
  <p class="text-foreground-950 mt-3 text-3xl font-bold dark:text-white" data-cfg-price></p>
  <a
    slot="primary-link"
    href=""
    class="text-foreground-600 hover:text-foreground-900 dark:hover:text-foreground-100 text-sm underline-offset-2 hover:underline dark:text-gray-400"
    data-cfg-href
  >
    Change package ↗
  </a>
</ContextBoxShell>
