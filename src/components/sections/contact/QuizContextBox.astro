---
/**
 * QuizContextBox is the quiz-summary card rendered above the contact form,
 * populated client-side with quiz answers when the visitor arrives from the
 * quiz flow.
 *
 * @useWhen You are composing the contact form and want a summary card to appear
 *   above the fields when quiz context resolves from sessionStorage or URL
 *   params.
 * @dontUseWhen You need the Configurator summary card with price-anchor visual
 *   — use ConfiguratorContextBox; the two boxes have distinct visual treatments
 *   and resolution sources.
 * @alternativeTo ConfiguratorContextBox — Configurator wins when both arrive;
 *   ContactForm's init script enforces this.
 * @relatedTo ContactForm — primary consumer; ContactForm's init script
 *   populates the `data-quiz-summary-rows` dl element.
 * @relatedTo QuizModal — source of the quiz answers (persisted via
 *   sessionStorage).
 * @adr ADR-0021
 *
 * Holds the static chrome (outer wrapper, accent card, heading) declaratively
 * in the template; the form-init script in `ContactForm.astro` populates the
 * inner `<dl data-quiz-summary-rows>` with `<dt>`/`<dd>` rows derived from
 * the visitor's quiz answers and unhides the wrapper by removing the
 * `hidden` class on `[data-quiz-summary]`.
 *
 * Stays hidden by default so visitors who arrive without quiz context never
 * see an empty card flash before client-side init runs.
 *
 * @example
 * ```astro
 * <QuizContextBox heading="Based on your quiz answers:" />
 * ```
 */

type Props = {
  /** Heading rendered at the top of the accent card */
  heading: string;
};

const { heading } = Astro.props;
---

<div class="mb-8 hidden" data-quiz-summary>
  <div class="bg-accent-50 dark:bg-accent-500/10 rounded-xl p-5">
    <p class="text-accent-800 dark:text-accent-200 text-sm font-semibold">{heading}</p>
    <dl class="mt-3 space-y-2" data-quiz-summary-rows></dl>
  </div>
</div>
