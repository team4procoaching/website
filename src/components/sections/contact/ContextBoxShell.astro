---
import { routes } from '~/data/routes';

/**
 * ContextBoxShell is the shared card chrome for the contact-form context
 * boxes, with a hidden-by-default outer wrapper (whose `data-*-summary`
 * hook the controller toggles), a neutral card, an uppercase label, a
 * default slot for the box's divergent body, a named `primary-link` slot
 * for the box-specific action, and an always-present "ask about a different
 * service" link to the bare contact page.
 *
 * @useWhen You are building a contact-form context box (session/configurator
 *   or subscription) and need the shared card chrome plus the
 *   different-service affordance, supplying only the box's own body and its
 *   primary link through slots.
 * @dontUseWhen You need a general-purpose card — use the page card
 *   primitives; this shell carries the contact-context-box-specific
 *   different-service link and the `data-*-summary` hidden-wrapper contract.
 *   You need the quiz summary shape (multiple Q/A rows) — use QuizContextBox.
 * @relatedTo ConfiguratorContextBox — consumer; supplies the configurator
 *   config + price-matrix body and the change-package primary link.
 * @relatedTo SubscriptionContextBox — consumer; supplies the monthly-anchor
 *   body and the conditional program-details primary link.
 * @relatedTo contactFormController — runtime owner; the controller removes
 *   `hidden` from the `[data-*-summary]` wrapper this shell renders.
 * @adr ADR-0062
 *
 * @a11y The uppercase label `<p>` is a visual heading, not a semantic one.
 *   Promoting it to `<h2>`/`<h3>` would invert the page hierarchy because
 *   the box renders above the page heading. ConfiguratorContextBox and
 *   ThanksSelectionSummary use the same `<p>` shape on their heading-style
 *   line for the same reason.
 *
 * The shell holds the byte-identical chrome both context boxes share once,
 * so no mirrored markup forms between the two boxes (the duplication-gate
 * motivation, see ADR-0062). Visibility is a runtime `hidden`-toggle owned
 * by the controller — both slot positions render unconditionally, so no
 * markup is gated on slot presence and ADR-0036's render-and-trim does not
 * apply.
 *
 * @example
 * ```astro
 * <ContextBoxShell
 *   summaryAttr="data-subscription-summary"
 *   heading="Your selected program"
 *   differentServiceLabel="Ask about a different service"
 * >
 *   <p data-sub-service></p>
 *   <a slot="primary-link" href="" data-sub-detail-href hidden>See full program details ↗</a>
 * </ContextBoxShell>
 * ```
 */

type Props = {
  /**
   * The `data-*-summary` attribute the controller toggles to unhide the
   * whole box (e.g. `'data-configurator-summary'`,
   * `'data-subscription-summary'`).
   */
  summaryAttr: string;
  /** Uppercase label rendered above the box body. */
  heading: string;
  /** Link text for the always-shown "ask about a different service" link. */
  differentServiceLabel: string;
};

const { summaryAttr, heading, differentServiceLabel } = Astro.props;
---

<div class="mb-8 hidden" {...{ [summaryAttr]: true }}>
  <div class="bg-foreground-50 rounded-xl p-5 dark:bg-white/5">
    <p class="text-foreground-600 text-xs font-semibold tracking-wide uppercase dark:text-gray-400">
      {heading}
    </p>
    <slot />
    <div class="mt-3 flex flex-wrap gap-4">
      <slot name="primary-link" />
      <a
        href={routes.contact}
        class="text-foreground-600 hover:text-foreground-900 dark:hover:text-foreground-100 text-sm underline-offset-2 hover:underline dark:text-gray-400"
      >
        {differentServiceLabel} ↗
      </a>
    </div>
  </div>
</div>
