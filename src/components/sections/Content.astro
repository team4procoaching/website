---
/**
 * Flexible content section with headline, intro text, and optional content area.
 * Supports multiple layout options including pull-quote for storytelling sections.
 *
 * **Slots:**
 * - default: Main intro/body text
 * - content: Custom content below (grids, cards, etc.)
 * - aside: Side content for two-column layout (e.g., pull quotes)
 *
 * @example
 * ```astro
 * <!-- Simple content with image -->
 * <Content headline="About Us" image={{ src: aboutImage, alt: "Our team" }}>
 *   <p>We are a team of passionate professionals.</p>
 * </Content>
 *
 * <!-- Two-column with pull quote -->
 * <Content headline="Why Team Beats Individual" layout="two-column">
 *   <p>Your main content here...</p>
 *   <Fragment slot="aside">
 *     <blockquote>"Your inspiring quote here."</blockquote>
 *   </Fragment>
 * </Content>
 *
 * <!-- Content with custom grid -->
 * <Content headline="Meet Your Coaches" background="muted">
 *   <p>Our expert coaches are here to help.</p>
 *   <Fragment slot="content">
 *     <ul class="grid grid-cols-3 gap-8">...</ul>
 *   </Fragment>
 * </Content>
 * ```
 */
import SectionHeader from '~/components/ui/SectionHeader.astro';
import SmartImage from '~/components/ui/SmartImage.astro';
import type { ImageProp } from '~/types/components';
import { slugify } from '~/utils/slugify';
import {
  sectionBackground,
  sectionHeadline,
  sectionText,
  type SectionBackground,
} from '~/utils/styles';

type Props = {
  /** Optional ID for the section (defaults to slugified headline) */
  id?: string;
  /** Section headline */
  headline: string;
  /** Semantic heading level */
  headingLevel?: 'h1' | 'h2' | 'h3' | 'h4';
  /** Background color variant */
  background?: SectionBackground;
  /** Text alignment for header */
  align?: 'center' | 'left';
  /** Layout variant */
  layout?: 'default' | 'two-column';
  /** Optional image below the content */
  image?: ImageProp;
};

const {
  id,
  headline,
  headingLevel = 'h2',
  background = 'default',
  align = 'center',
  layout = 'default',
  image,
} = Astro.props;

// Use provided id or fall back to slugified headline
const headingId = id ?? `content-${slugify(headline)}`;

const hasContentSlot = Astro.slots.has('content');
const hasAsideSlot = Astro.slots.has('aside');
const isTwoColumn = layout === 'two-column' || hasAsideSlot;

// Dynamic heading tag for two-column layout (default layout uses SectionHeader)
const HeadingTag = headingLevel;

// Shared image classes
const imageClasses =
  'w-full rounded-2xl object-cover shadow-lg outline-1 -outline-offset-1 outline-foreground-950/5 dark:outline-white/10';
---

<section
  class:list={['px-6 py-24 sm:py-32 lg:px-8', sectionBackground[background]]}
  aria-labelledby={headingId}
>
  <div class="mx-auto max-w-7xl">
    {
      isTwoColumn ? (
        /* Two-column layout with aside slot */
        <div class="mx-auto max-w-2xl lg:mx-0 lg:max-w-none">
          <HeadingTag
            id={headingId}
            class:list={[
              'font-serif text-3xl font-bold tracking-tight sm:text-4xl',
              sectionHeadline[background],
            ]}
          >
            {headline}
          </HeadingTag>

          <div class="mt-10 grid grid-cols-1 gap-8 lg:grid-cols-2">
            {/* Main content */}
            <div class:list={['text-base/7', sectionText[background]]}>
              <slot />
            </div>

            {/* Aside content (pull quote, etc.) */}
            {hasAsideSlot && (
              <div class="lg:pl-8">
                <slot name="aside" />
              </div>
            )}
          </div>
        </div>
      ) : (
        /* Default centered layout */
        <Fragment>
          <SectionHeader
            headline={headline}
            headingLevel={headingLevel}
            align={align}
            headingId={headingId}
            background={background}
          >
            <slot />
          </SectionHeader>
        </Fragment>
      )
    }

    {hasContentSlot && <slot name="content" />}

    {
      image && (
        <figure class="mx-auto mt-16 max-w-4xl">
          <SmartImage
            src={image.src}
            alt={image.alt}
            widths={[640, 960, 1280]}
            sizes="(max-width: 640px) 100vw, (max-width: 1024px) 896px, 896px"
            loading={image.loading ?? 'lazy'}
            class={imageClasses}
          />
          {image.caption && (
            <figcaption class:list={['mt-4 text-center text-sm', sectionText[background]]}>
              {image.caption}
            </figcaption>
          )}
        </figure>
      )
    }
  </div>
</section>
