---
/**
 * Services/pricing section with billing period toggle and service cards grid.
 * Uses CSS-only SegmentedControl for price switching (no JavaScript required).
 * Optionally includes an embedded quiz CTA and a "browse all" link.
 *
 * Note: Wraps content in a `<div>` with `group/tiers` class to enable
 * CSS-based price switching via SegmentedControl's radio buttons.
 * Uses `<div>` instead of `<form>` because there is no form submission —
 * the radio buttons only drive CSS visibility via `:has()` selectors.
 *
 * @example
 * ```astro
 * <Services
 *   headline="Choose Your Coaching Plan"
 *   intro="Expert coaching tailored to your goals."
 *   services={services}
 *   quizCta={{
 *     headline: "Not Sure Which Plan?",
 *     description: "Take our quiz to find the perfect fit.",
 *     primaryCta: { label: "Find Your Fit", href: "/quiz" },
 *   }}
 *   allServicesLink={{ label: "Browse All Services", href: "/services" }}
 * />
 * ```
 */
import ServiceCard from '~/components/sections/services/ServiceCard.astro';
import Cta from '~/components/ui/CTA.astro';
import SegmentedControl from '~/components/ui/SegmentedControl.astro';
import TextLink from '~/components/ui/TextLink.astro';
import { billingPeriods, defaultPeriod, type Service } from '~/data/services';
import {
  isDarkBackground,
  type SectionBackground,
  sectionBackground,
  sectionHeadline,
  sectionText,
} from '~/styles/sectionStyles';
import type { CtaAction } from '~/types/components';
import { slugify } from '~/utils/slugify';

type Props = {
  /** Optional ID for the section (defaults to slugified headline) */
  id?: string;
  /** Section headline */
  headline: string;
  /** Intro text below headline */
  intro: string;
  /** Services to display */
  services: readonly Service[];
  /** Background color variant */
  background?: SectionBackground;
  /** Optional Quiz CTA between cards and browse link */
  quizCta?: {
    headline: string;
    description: string;
    primaryCta: CtaAction;
  };
  /** Link to all services page */
  allServicesLink?: {
    label: string;
    href: string;
  };
};

const {
  id,
  headline,
  intro,
  services,
  background = 'default',
  quizCta,
  allServicesLink,
} = Astro.props;

// Section id for anchor navigation; heading id for aria-labelledby
const headingId = id ? `${id}-heading` : `services-${slugify(headline)}`;
const isDark = isDarkBackground(background);
---

<section
  id={id}
  class:list={['group/tiers px-6 py-24 sm:py-32 lg:px-8', sectionBackground[background]]}
  aria-labelledby={headingId}
>
  <div class="mx-auto max-w-7xl">
    <!-- Header -->
    <div class="mx-auto max-w-2xl text-center" data-animate="fade-up">
      <h2
        id={headingId}
        class:list={[
          'font-serif text-4xl font-bold tracking-tight sm:text-5xl',
          sectionHeadline[background],
        ]}
      >
        {headline}
      </h2>
      <p
        class:list={['mt-6 text-lg font-medium text-pretty sm:text-xl/8', sectionText[background]]}
      >
        {intro}
      </p>
    </div>

    <!-- Pricing Toggle -->
    <div class="mt-12 flex justify-center" data-animate="fade" data-animate-delay="200">
      <SegmentedControl
        name="frequency"
        options={billingPeriods}
        defaultValue={defaultPeriod}
        ariaLabel="Select billing period"
        variant={isDark ? 'on-dark' : 'default'}
      />
    </div>

    <!-- Service Cards Grid -->
    {
      services.length > 0 && (
        <ul
          role="list"
          data-animate-stagger
          class="mx-auto mt-12 grid max-w-md grid-cols-1 gap-8 lg:mx-0 lg:max-w-none lg:grid-cols-3"
        >
          {services.map((service) => (
            <li data-animate="fade-up">
              <ServiceCard service={service} darkBackground={isDark} />
            </li>
          ))}
        </ul>
      )
    }

    <!-- Quiz CTA -->
    {
      quizCta && (
        <div class="mt-16">
          <Cta
            headline={quizCta.headline}
            description={quizCta.description}
            primaryCta={quizCta.primaryCta}
            headingLevel="h3"
            size="compact"
            variant={isDark ? 'glass' : 'dark'}
          />
        </div>
      )
    }

    <!-- Browse All Link -->
    {
      allServicesLink && (
        <div class="mt-12 text-center">
          <TextLink href={allServicesLink.href} variant={isDark ? 'light' : 'default'}>
            {allServicesLink.label}
          </TextLink>
        </div>
      )
    }
  </div>
</section>
