---
import ServiceCard from '~/components/sections/services/ServiceCard.astro';
import Cta from '~/components/ui/CTA.astro';
import SegmentedControl from '~/components/ui/SegmentedControl.astro';
import TextLink from '~/components/ui/TextLink.astro';
import { billingPeriods, type Service } from '~/data/services';
import { slugify } from '~/utils/slugify';

type Props = {
  /** Optional ID for the section (defaults to slugified headline) */
  id?: string;
  /** Section headline */
  headline: string;
  /** Intro text below headline */
  intro: string;
  /** Services to display */
  services: readonly Service[];
  /** Optional Quiz CTA between cards and browse link */
  quizCta?: {
    headline: string;
    description: string;
    primaryCta: {
      label: string;
      href: string;
    };
  };
  /** Link to all services page */
  allServicesLink?: {
    label: string;
    href: string;
  };
};

const { id, headline, intro, services, quizCta, allServicesLink } = Astro.props;

// Use provided id or fall back to slugified headline
const headingId = id ?? slugify(headline);
---

<form
  class="group/tiers bg-background dark:bg-background-dark px-6 py-24 sm:py-32 lg:px-8"
  aria-labelledby={headingId}
>
  <div class="mx-auto max-w-7xl">
    <!-- Header -->
    <div class="mx-auto max-w-2xl text-center">
      <h2
        id={headingId}
        class="text-foreground-950 font-serif text-4xl font-bold tracking-tight sm:text-5xl dark:text-white"
      >
        {headline}
      </h2>
      <p
        class="text-foreground-700 mt-6 text-lg font-medium text-pretty sm:text-xl/8 dark:text-gray-400"
      >
        {intro}
      </p>
    </div>

    <!-- Pricing Toggle -->
    <div class="mt-12 flex justify-center">
      <SegmentedControl
        name="frequency"
        options={billingPeriods}
        defaultValue="standard"
        ariaLabel="Select billing period"
      />
    </div>

    <!-- Service Cards Grid -->
    {
      services.length > 0 && (
        <ul
          role="list"
          class="mx-auto mt-12 grid max-w-md grid-cols-1 gap-8 lg:mx-0 lg:max-w-none lg:grid-cols-3"
        >
          {services.map((service) => (
            <li>
              <ServiceCard service={service} />
            </li>
          ))}
        </ul>
      )
    }

    <!-- Quiz CTA -->
    {
      quizCta && (
        <div class="mt-16">
          <Cta
            headline={quizCta.headline}
            description={quizCta.description}
            primaryCta={quizCta.primaryCta}
            headingLevel="h3"
            size="compact"
          />
        </div>
      )
    }

    <!-- Browse All Link -->
    {
      allServicesLink && (
        <div class="mt-12 text-center">
          <TextLink href={allServicesLink.href}>{allServicesLink.label}</TextLink>
        </div>
      )
    }
  </div>
</form>
