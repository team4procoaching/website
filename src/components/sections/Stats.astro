---
/**
 * Stats is the homepage stats section, wrapping Content with a StatsGrid in the
 * content slot.
 *
 * @useWhen You are composing the homepage and need the headlined stats-grid
 *   block with count-up animation.
 * @dontUseWhen You need stats inline inside another section (e.g., a hero
 *   footer) — use StatsGrid directly; Stats is the standalone section wrapper.
 * @relatedTo Content — composition base.
 * @relatedTo StatsGrid — rendered in Content's `content` slot.
 * @example
 * ```astro
 * <Stats headline="Proven Track Record" stats={stats}>
 *   <p>Real results from real clients.</p>
 * </Stats>
 * ```
 */
import Content from '~/components/sections/Content.astro';
import StatsGrid from '~/components/ui/StatsGrid.astro';
import type { Stat } from '~/data/stats';
import type { SectionBackground } from '~/styles/sectionStyles';

type Props = {
  /** Optional ID for the section (defaults to slugified headline) */
  id?: string;
  /** Section headline */
  headline: string;
  /** Semantic heading level */
  headingLevel?: 'h1' | 'h2' | 'h3' | 'h4';
  /** Stats to display */
  stats: readonly Stat[];
  /** Background color variant */
  background?: SectionBackground;
};

const { id, headline, headingLevel = 'h2', stats, background = 'default' } = Astro.props;
---

<Content id={id} headline={headline} headingLevel={headingLevel} background={background}>
  <slot />

  <StatsGrid slot="content" stats={stats} columns={4} class="mt-16" />
</Content>
