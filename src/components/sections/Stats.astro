---
/**
 * Statistics section displaying key metrics in a grid layout.
 * Wraps Content.astro with stats-specific grid.
 *
 * @example
 * ```astro
 * <Stats headline="Proven Track Record" stats={stats}>
 *   <p>Real results from real clients.</p>
 * </Stats>
 * ```
 */
import Content from '~/components/sections/Content.astro';
import type { Stat } from '~/data/stats';
import type { SectionBackground } from '~/styles/sectionStyles';
import { parseCounterValue } from '~/utils/counter';

type Props = {
  /** Optional ID for the section (defaults to slugified headline) */
  id?: string;
  /** Section headline */
  headline: string;
  /** Semantic heading level */
  headingLevel?: 'h1' | 'h2' | 'h3' | 'h4';
  /** Stats to display */
  stats: readonly Stat[];
  /** Background color variant */
  background?: SectionBackground;
};

const { id, headline, headingLevel = 'h2', stats, background = 'default' } = Astro.props;
---

<Content id={id} headline={headline} headingLevel={headingLevel} background={background}>
  <slot />

  <Fragment slot="content">
    <dl
      data-animate-stagger
      class="mt-16 grid grid-cols-1 gap-0.5 overflow-hidden rounded-2xl text-center sm:grid-cols-2 lg:grid-cols-4"
    >
      {
        stats.map((stat: Stat) => {
          const { target, suffix } = parseCounterValue(stat.value);
          return (
            <div
              data-animate="scale-up"
              class="bg-foreground-950/5 flex flex-col p-8 dark:bg-white/5"
            >
              <dt class="text-foreground-600 text-sm/6 font-semibold dark:text-gray-300">
                {stat.label}
              </dt>
              <dd
                data-countup
                data-countup-target={target}
                {...(suffix ? { 'data-countup-suffix': suffix } : {})}
                class="text-foreground-950 order-first font-serif text-3xl font-bold tracking-tight dark:text-white"
              >
                {stat.value}
              </dd>
            </div>
          );
        })
      }
    </dl>
  </Fragment>
</Content>
