---
/**
 * SuccessStories is the homepage success-stories section with horizontal-scroll
 * slider of overview cards and dot indicators on mobile.
 *
 * @useWhen You are composing the homepage and need the success-stories preview
 *   slider with link to the full overview.
 * @dontUseWhen You need the full success-stories grid — use the page route
 *   directly; SuccessStories is the homepage preview slider.
 * @relatedTo Content — composition base.
 * @relatedTo SuccessStoryOverviewCard — rendered inside the slider, one per
 *   story.
 * @example
 * ```astro
 * <SuccessStories
 *   headline="Real Transformations"
 *   stories={successStories}
 *   allStoriesLink={{ label: "See All Stories", href: routes.successStories }}
 * >
 *   <p>From the women who trained with us.</p>
 * </SuccessStories>
 * ```
 */
import Content from '~/components/sections/Content.astro';
import TextLink from '~/components/ui/TextLink.astro';
import type { SuccessStory } from '~/data/successStories';
import { isDarkBackground, type SectionBackground } from '~/styles/sectionStyles';
import SuccessStoryOverviewCard from './successStories/SuccessStoryOverviewCard.astro';

type Props = {
  /** Optional ID for the section */
  id?: string;
  /** Section headline */
  headline: string;
  /** Semantic heading level */
  headingLevel?: 'h1' | 'h2' | 'h3' | 'h4';
  /** Success stories to display */
  stories: readonly SuccessStory[];
  /** Link to all success stories page */
  allStoriesLink?: {
    label: string;
    href: string;
  };
  /** Background color variant */
  background?: SectionBackground;
};

const {
  id,
  headline,
  headingLevel = 'h2',
  stories,
  allStoriesLink,
  background = 'default',
} = Astro.props;

const hasStories = stories.length > 0;
const isDark = isDarkBackground(background);

// Slider nav button classes adapt to background context
const sliderBtnClasses = isDark
  ? 'bg-white/20 hover:bg-white/30 text-white absolute top-1/2 hidden cursor-pointer rounded-full p-2 shadow-md backdrop-blur transition-colors lg:block'
  : 'bg-background/80 hover:bg-background text-foreground-950 dark:bg-background-dark/80 dark:hover:bg-background-dark absolute top-1/2 hidden cursor-pointer rounded-full p-2 shadow-md backdrop-blur transition-colors lg:block dark:text-white';

// Dot indicator classes
const dotDefault = isDark ? 'bg-white/30' : 'bg-foreground-300 dark:bg-gray-600';
const dotActive = isDark ? 'bg-white' : 'bg-foreground-600 dark:bg-gray-300';
const dotInactive = dotDefault;
---

<Content id={id} headline={headline} headingLevel={headingLevel} background={background}>
  <slot />

  <Fragment slot="content">
    {
      hasStories && (
        <div
          class="mt-16"
          data-animate="fade-up"
          data-success-stories-slider
          data-dot-active={dotActive}
          data-dot-inactive={dotInactive}
        >
          {/* Slider container with Prev/Next buttons */}
          <div class="relative">
            <div
              class="scrollbar-hide flex snap-x snap-mandatory gap-6 overflow-x-auto scroll-smooth pb-4 lg:gap-8"
              role="region"
              aria-label="Success stories carousel"
              tabindex="0"
              data-slider
            >
              {stories.map((story) => (
                <div data-card class="w-80 shrink-0 snap-start scroll-ml-6 sm:w-96 lg:scroll-ml-8">
                  <SuccessStoryOverviewCard story={story} darkBackground={isDark} />
                </div>
              ))}
            </div>

            {/* Prev/Next buttons — hidden on mobile (swipe is natural there) */}
            <button
              type="button"
              class:list={[sliderBtnClasses, 'left-0 -translate-x-1/2 -translate-y-1/2']}
              aria-label="Previous story"
              data-slider-prev
            >
              <svg
                class="size-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M15.75 19.5 8.25 12l7.5-7.5"
                />
              </svg>
            </button>
            <button
              type="button"
              class:list={[sliderBtnClasses, 'right-0 translate-x-1/2 -translate-y-1/2']}
              aria-label="Next story"
              data-slider-next
            >
              <svg
                class="size-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="m8.25 4.5 7.5 7.5-7.5 7.5"
                />
              </svg>
            </button>
          </div>

          {/* Dot indicators — mobile only */}
          <div class="mt-8 flex justify-center gap-2 lg:hidden" aria-hidden="true">
            {stories.map((_, index) => (
              <span
                class:list={['size-2.5 rounded-full transition-colors', dotDefault]}
                data-dot={index}
              />
            ))}
          </div>

          {allStoriesLink && (
            <div class="mt-10 text-center">
              <TextLink href={allStoriesLink.href} variant={isDark ? 'light' : 'default'}>
                {allStoriesLink.label}
              </TextLink>
            </div>
          )}
        </div>
      )
    }
  </Fragment>
</Content>

<style>
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  // Constants for scroll position thresholds
  const SCROLL_END_THRESHOLD_PX = 10;
  const CARD_SNAP_THRESHOLD_PX = 50;

  /**
   * Initialize dot position indicators for success stories sliders.
   * Guards against multiple initialization via data-initialized attribute.
   */
  function initSuccessStoriesSliders() {
    const containers = document.querySelectorAll('[data-success-stories-slider]');

    containers.forEach((container) => {
      const slider = container.querySelector('[data-slider]');

      // Guard: skip if not HTMLElement, already initialized, or not found
      if (!(slider instanceof HTMLElement) || slider.dataset.initialized === 'true') return;
      slider.dataset.initialized = 'true';

      const cards = container.querySelectorAll('[data-card]');
      const dots = container.querySelectorAll('[data-dot]');
      const prevBtn = container.querySelector('[data-slider-prev]');
      const nextBtn = container.querySelector('[data-slider-next]');

      // Read dot class names from data attributes (supports dark/light backgrounds)
      const dotActiveClasses = (
        container.getAttribute('data-dot-active') || 'bg-foreground-600 dark:bg-gray-300'
      ).split(' ');
      const dotInactiveClasses = (
        container.getAttribute('data-dot-inactive') || 'bg-foreground-300 dark:bg-gray-600'
      ).split(' ');

      if (cards.length === 0) return;

      /**
       * Update active dot and Prev/Next button states based on scroll position.
       */
      const updateSliderState = () => {
        const scrollLeft = slider.scrollLeft;
        const maxScroll = slider.scrollWidth - slider.clientWidth;
        let activeIndex = 0;

        // If scrolled to the end, activate last dot
        if (scrollLeft >= maxScroll - SCROLL_END_THRESHOLD_PX) {
          activeIndex = cards.length - 1;
        } else {
          cards.forEach((card, index) => {
            if (!(card instanceof HTMLElement)) return;
            const cardLeft = card.offsetLeft - slider.offsetLeft;
            if (scrollLeft >= cardLeft - CARD_SNAP_THRESHOLD_PX) {
              activeIndex = index;
            }
          });
        }

        // Update dot styles
        dots.forEach((dot, index) => {
          if (index === activeIndex) {
            dot.classList.remove(...dotInactiveClasses);
            dot.classList.add(...dotActiveClasses);
          } else {
            dot.classList.remove(...dotActiveClasses);
            dot.classList.add(...dotInactiveClasses);
          }
        });

        // Disable Prev/Next buttons at scroll boundaries
        const atStart = scrollLeft <= SCROLL_END_THRESHOLD_PX;
        const atEnd = scrollLeft >= maxScroll - SCROLL_END_THRESHOLD_PX;

        if (prevBtn instanceof HTMLButtonElement) {
          prevBtn.disabled = atStart;
          prevBtn.classList.toggle('opacity-30', atStart);
          prevBtn.classList.toggle('pointer-events-none', atStart);
        }
        if (nextBtn instanceof HTMLButtonElement) {
          nextBtn.disabled = atEnd;
          nextBtn.classList.toggle('opacity-30', atEnd);
          nextBtn.classList.toggle('pointer-events-none', atEnd);
        }
      };

      // Throttle scroll handler with requestAnimationFrame
      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          updateSliderState();
          ticking = false;
        });
      };

      slider.addEventListener('scroll', onScroll, { passive: true });

      // Prev/Next button handlers — scroll by one card width
      const scrollByCard = (direction: 1 | -1) => {
        const firstCard = cards[0];
        if (!(firstCard instanceof HTMLElement)) return;
        const cardWidth = firstCard.offsetWidth;
        const gap = parseInt(getComputedStyle(slider).gap) || 0;
        slider.scrollBy({ left: direction * (cardWidth + gap), behavior: 'smooth' });
      };

      prevBtn?.addEventListener('click', () => scrollByCard(-1));
      nextBtn?.addEventListener('click', () => scrollByCard(1));

      updateSliderState(); // Initial state
    });
  }

  // Support both initial load and View Transitions
  // DOMContentLoaded: fires on initial page load
  // astro:page-load: fires after View Transitions navigation
  // The data-initialized guard prevents double initialization
  document.addEventListener('DOMContentLoaded', initSuccessStoriesSliders);
  document.addEventListener('astro:page-load', initSuccessStoriesSliders);
</script>
