---
/**
 * Contact is the split-layout contact section, with intro and contact methods
 * on the left and a form slot on the right.
 *
 * @useWhen You are composing the contact page or a page with a contact-form
 *   panel, and the form variant is injected via the `form` slot.
 * @dontUseWhen You need just the contact form without the surrounding
 *   split-layout chrome — render ContactForm directly; Contact's split layout
 *   assumes the surrounding context.
 * @relatedTo ContactForm — typical content for the `form` slot.
 * @relatedTo Section — composition base; Contact renders inside a `<Section
 *   background="default">`.
 *
 * The form is decoupled from this component via slots, allowing different
 * form variants (e.g., service inquiry with dropdown) without modifying
 * the Contact shell.
 *
 * The headline ships as three `<span data-contact-headline-mode>` siblings
 * inside the heading element. Per ADR-0060 (Decisions 1 and 5), the
 * conversational headline ships visible on load — it is the dominant case
 * and the no-JS render path, keeping the heading non-empty without
 * client JS — while the transactional and program headlines ship hidden.
 * The contact-form controller calls `applyHeadlineMode('conversational' |
 * 'transactional' | 'program')` from its branches (Configurator triple →
 * transactional; subscription `?service=<id>` → program; bare / quiz / bare
 * `?service=` landing → conversational), so exactly one variant is unhidden
 * after init regardless of which path populated the form.
 *
 * @example
 * ```astro
 * <Contact
 *   headlineConversational={contactSection.headlineConversational}
 *   headlineTransactional={contactSection.headlineTransactional}
 *   headlineProgram={contactSection.headlineProgram}
 *   intro={contactSection.intro}
 *   contactMethods={contactSection.contactMethods}
 * >
 *   <ContactForm
 *     slot="form"
 *     name={contactSection.form.name}
 *     action={contactSection.form.successRedirect}
 *     submitLabel={contactSection.form.submitLabel}
 *   />
 * </Contact>
 * ```
 */
import Section from '~/components/ui/Section.astro';
import type { ContactMethod } from '~/data/contact';
import { sectionBackground } from '~/styles/sectionStyles';
import { isExternal } from '~/utils/isExternal';

type Props = {
  /** Optional section ID for anchor links */
  id?: string;
  /**
   * Conversational headline unhidden on bare `/contact`, bare session
   * `?service=posing` (no configurator triple), and quiz-only landings —
   * the non-strong-intent branches in `contactFormController`.
   */
  headlineConversational: string;
  /**
   * Transactional headline unhidden after a Configurator deep-link
   * resolves; toggled in by the contact-form controller.
   */
  headlineTransactional: string;
  /**
   * Program headline unhidden after a subscription `?service=<id>`
   * deep-link resolves; toggled in by the contact-form controller.
   */
  headlineProgram: string;
  /** Semantic heading level */
  headingLevel?: 'h1' | 'h2' | 'h3' | 'h4';
  /** Intro text below headline */
  intro: string;
  /** Contact methods to display (Instagram, Email, etc.) */
  contactMethods: readonly ContactMethod[];
};

const {
  id = 'contact',
  headlineConversational,
  headlineTransactional,
  headlineProgram,
  headingLevel = 'h2',
  intro,
  contactMethods,
} = Astro.props;

const headingClasses =
  'font-serif text-4xl font-bold tracking-tight text-foreground-950 sm:text-5xl dark:text-white';

// Dynamic heading element - Astro supports this when variable starts with uppercase
const Heading = headingLevel;
---

<Section background="default" id={id} class="relative isolate">
  <div class="mx-auto grid max-w-7xl grid-cols-1 lg:grid-cols-2">
    <div class="relative px-6 pt-24 pb-20 sm:pt-32 lg:static lg:px-8 lg:py-48">
      <div class="mx-auto max-w-xl lg:mx-0 lg:max-w-lg">
        <div
          class:list={[
            'absolute inset-y-0 left-0 -z-10 w-full overflow-hidden lg:w-1/2',
            sectionBackground.muted,
          ]}
        >
        </div>

        <Heading class={headingClasses} data-animate="fade-left">
          <span data-contact-headline-mode="conversational">{headlineConversational}</span>
          <span data-contact-headline-mode="transactional" class="hidden"
            >{headlineTransactional}</span
          >
          <span data-contact-headline-mode="program" class="hidden">{headlineProgram}</span>
        </Heading>

        <p
          class="text-foreground-600 mt-6 text-lg font-medium text-pretty sm:text-xl/8 dark:text-gray-400"
          data-animate="fade-left"
          data-animate-delay="100"
        >
          {intro}
        </p>

        <dl
          class="text-foreground-600 mt-10 space-y-4 text-base/7 dark:text-gray-300"
          data-animate-stagger
        >
          {
            contactMethods.map((method) => (
              <div class="flex gap-x-4" data-animate="fade-left">
                <dt class="flex-none">
                  <span class="sr-only">{method.srLabel}</span>
                  {/* SAFETY: icon content is statically defined in ~/data/contact.ts */}
                  <svg
                    viewBox="0 0 24 24"
                    fill={method.iconType === 'fill' ? 'currentColor' : 'none'}
                    stroke={method.iconType === 'stroke' ? 'currentColor' : 'none'}
                    stroke-width={method.iconType === 'stroke' ? '1.5' : '0'}
                    aria-hidden="true"
                    class="text-foreground-400 size-6"
                    set:html={method.icon}
                  />
                </dt>
                <dd>
                  <a
                    href={method.href}
                    class="hover:text-foreground-950 transition-colors dark:hover:text-white"
                    target={isExternal(method.href) ? '_blank' : undefined}
                    rel={isExternal(method.href) ? 'noopener noreferrer' : undefined}
                  >
                    {method.label}
                  </a>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>

    <div data-animate="fade-right" data-animate-delay="200">
      <slot name="form" />
    </div>
  </div>
</Section>
