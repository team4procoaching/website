---
/**
 * Contact section with split layout.
 * Left side: headline, intro, contact methods with muted background.
 * Right side: Netlify-powered contact form with honeypot spam protection.
 *
 * @example
 * ```astro
 * <Contact
 *   headline={contactSection.headline}
 *   intro={contactSection.intro}
 *   contactMethods={contactSection.contactMethods}
 *   formName={contactSection.form.name}
 *   formAction={contactSection.form.successRedirect}
 *   submitLabel={contactSection.form.submitLabel}
 * />
 * ```
 */
import SubmitButton from '~/components/ui/SubmitButton.astro';
import type { ContactMethod } from '~/data/contact';

type Props = {
  /** Optional section ID for anchor links */
  id?: string;
  /** Section headline */
  headline: string;
  /** Semantic heading level */
  headingLevel?: 'h1' | 'h2' | 'h3' | 'h4';
  /** Intro text below headline */
  intro: string;
  /** Contact methods to display (Instagram, Email, etc.) */
  contactMethods: readonly ContactMethod[];
  /** Netlify form name */
  formName: string;
  /** Form action URL (redirect after successful submission) */
  formAction?: string;
  /** Submit button label */
  submitLabel: string;
};

const {
  id = 'contact',
  headline,
  headingLevel = 'h2',
  intro,
  contactMethods,
  formName,
  formAction,
  submitLabel,
} = Astro.props;

// Helper to check if a URL is external
const isExternal = (href: string) => href.startsWith('https://') || href.startsWith('http://');

// Reusable input classes to avoid duplication
const inputClasses =
  'block w-full rounded-md bg-white px-3.5 py-2 text-base text-foreground-950 outline outline-1 -outline-offset-1 outline-foreground-300 placeholder:text-foreground-400 focus:outline-2 focus:-outline-offset-2 focus:outline-accent-600 dark:bg-white/5 dark:text-white dark:outline-white/10 dark:placeholder:text-gray-500 dark:focus:outline-accent-500';

const labelClasses = 'block text-sm/6 font-semibold text-foreground-950 dark:text-white';

const headingClasses =
  'font-serif text-4xl font-bold tracking-tight text-foreground-950 sm:text-5xl dark:text-white';

// Dynamic heading element - Astro supports this when variable starts with uppercase
const Heading = headingLevel;
---

<section id={id} class="bg-background dark:bg-background-dark relative isolate">
  <div class="mx-auto grid max-w-7xl grid-cols-1 lg:grid-cols-2">
    <div class="relative px-6 pt-24 pb-20 sm:pt-32 lg:static lg:px-8 lg:py-48">
      <div class="mx-auto max-w-xl lg:mx-0 lg:max-w-lg">
        <div
          class="bg-background-muted dark:bg-background-dark-muted absolute inset-y-0 left-0 -z-10 w-full overflow-hidden lg:w-1/2"
        >
        </div>

        <Heading class={headingClasses}>
          {headline}
        </Heading>

        <p class="text-foreground-600 mt-6 text-lg/8 dark:text-gray-400">
          {intro}
        </p>

        <dl class="text-foreground-600 mt-10 space-y-4 text-base/7 dark:text-gray-300">
          {
            contactMethods.map((method) => (
              <div class="flex gap-x-4">
                <dt class="flex-none">
                  <span class="sr-only">{method.srLabel}</span>
                  {/* SAFETY: icon content is statically defined in ~/data/contact.ts */}
                  <svg
                    viewBox="0 0 24 24"
                    fill={method.iconType === 'fill' ? 'currentColor' : 'none'}
                    stroke={method.iconType === 'stroke' ? 'currentColor' : 'none'}
                    stroke-width={method.iconType === 'stroke' ? '1.5' : '0'}
                    aria-hidden="true"
                    class="text-foreground-400 size-6"
                    set:html={method.icon}
                  />
                </dt>
                <dd>
                  <a
                    href={method.href}
                    class="hover:text-foreground-950 transition-colors dark:hover:text-white"
                    target={isExternal(method.href) ? '_blank' : undefined}
                    rel={isExternal(method.href) ? 'noopener noreferrer' : undefined}
                  >
                    {method.label}
                  </a>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>

    <form
      name={formName}
      method="POST"
      action={formAction}
      data-netlify="true"
      netlify-honeypot="bot-field"
      class="px-6 pt-20 pb-24 sm:pb-32 lg:px-8 lg:py-48"
      aria-label="Contact form"
    >
      <input type="hidden" name="form-name" value={formName} />

      {/* Honeypot field for spam protection - hidden from users and assistive technology */}
      <p class="hidden" aria-hidden="true">
        <label>
          Don't fill this out if you're human:
          <input name="bot-field" tabindex="-1" autocomplete="off" aria-hidden="true" />
        </label>
      </p>

      <div class="mx-auto max-w-xl lg:mr-0 lg:max-w-lg">
        <div class="grid grid-cols-1 gap-x-8 gap-y-6 sm:grid-cols-2">
          <div>
            <label for="first-name" class={labelClasses}>First name</label>
            <div class="mt-2.5">
              <input
                id="first-name"
                type="text"
                name="first-name"
                autocomplete="given-name"
                required
                class={inputClasses}
              />
            </div>
          </div>

          <div>
            <label for="last-name" class={labelClasses}>Last name</label>
            <div class="mt-2.5">
              <input
                id="last-name"
                type="text"
                name="last-name"
                autocomplete="family-name"
                required
                class={inputClasses}
              />
            </div>
          </div>

          <div class="sm:col-span-2">
            <label for="email" class={labelClasses}>Email</label>
            <div class="mt-2.5">
              <input
                id="email"
                type="email"
                name="email"
                autocomplete="email"
                required
                class={inputClasses}
              />
            </div>
          </div>

          <div class="sm:col-span-2">
            <label for="message" class={labelClasses}>Message</label>
            <div class="mt-2.5">
              <textarea id="message" name="message" rows="4" required class={inputClasses}
              ></textarea>
            </div>
          </div>
        </div>

        <div class="mt-8 flex justify-end">
          <SubmitButton>{submitLabel}</SubmitButton>
        </div>
      </div>
    </form>
  </div>
</section>
