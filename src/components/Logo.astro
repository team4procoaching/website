---
import type { LogoConfig } from '~/data/site';

type Props = {
  /** Site or brand name for accessibility */
  name: string;
  /** Logo URLs for light/dark mode */
  logo: LogoConfig;
  /** Optional height class (Tailwind), defaults to h-8 */
  height?: string;
};

const { name, logo, height = 'h-8' } = Astro.props;
---

<a href="/" class="-m-1.5 p-1.5">
  <span class="sr-only">{name}</span>
  <img src={logo.light} alt="" role="presentation" class:list={[height, 'w-auto dark:hidden']} />
  <img src={logo.dark} alt="" role="presentation" class:list={[height, 'w-auto not-dark:hidden']} />
</a>
