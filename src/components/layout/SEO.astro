---
/**
 * SEO meta tags, Open Graph, and JSON-LD structured data fragment.
 * Automatically selects "WebSite" schema for the homepage and "WebPage" for all other pages.
 * Formats canonical URLs with consistent trailing slash handling.
 *
 * Typically used internally by BaseHead.astro rather than directly.
 *
 * @example
 * ```astro
 * <SEO
 *   name="Team 4 Pro Coaching"
 *   title="Contact | Team 4 Pro Coaching"
 *   description="Get in touch with our coaching team."
 *   locale="en_US"
 * />
 *
 * <!-- Prevent indexing (e.g., thank-you pages) -->
 * <SEO
 *   name="Team 4 Pro Coaching"
 *   title="Thank You"
 *   description="Message received."
 *   noindex
 * />
 * ```
 */
export type Props = {
  /** Site or brand name */
  name: string;
  /** Page title */
  title: string;
  /** Page description */
  description: string;
  /** Canonical URL for this page (defaults to current page URL) */
  canonicalURL?: URL | string;
  /** Language/locale code, e.g. `"en"` or `"de"` */
  locale?: string;
  /** Prevent search engines from indexing this page */
  noindex?: boolean;
};

const {
  name,
  title,
  description,
  canonicalURL = new URL(Astro.url.pathname, Astro.site),
  locale = 'en_US',
  noindex = false,
} = Astro.props;

/**
 * Enforce standard canonical URL formatting:
 * - URLs with query params: no trailing slash
 * - URLs without query params: trailing slash
 */
function formatCanonicalURL(url: string | URL): string {
  const path = url.toString();
  const hasQueryParams = path.includes('?');
  return path.replace(/\/?$/, hasQueryParams ? '' : '/');
}

const canonicalUrlString = formatCanonicalURL(canonicalURL);

const schemaType = Astro.url.pathname === '/' ? 'WebSite' : 'WebPage';

// Structured data for search engines
const schemaData = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  name,
  description,
  url: canonicalUrlString,
  inLanguage: locale,
};
---

<!-- Basic Meta Tags -->
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrlString} />

<!-- Robots Meta Tags -->
{noindex && <meta name="robots" content="noindex, nofollow" />}
{!noindex && <meta name="robots" content="max-image-preview:large" />}

<!-- Open Graph / Social Media -->
<meta property="og:type" content={schemaType} />
<meta property="og:site_name" content={name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrlString} />
<meta property="og:locale" content={locale} />

<!-- Structured Data (JSON-LD) -->
{/* SAFETY: schemaData is built from static config in this component's frontmatter */}
<script is:inline type="application/ld+json" set:html={JSON.stringify(schemaData)} />
