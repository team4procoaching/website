---
/**
 * SEO is the meta-tags-and-JSON-LD fragment for a single page, selecting
 * `WebSite` schema for the homepage and `WebPage` elsewhere.
 *
 * @useWhen You are composing a page-level `<head>` and need meta-description,
 *   canonical, Open Graph, and a `WebSite` / `WebPage` JSON-LD block in one
 *   place. Typically used internally by BaseHead.
 * @dontUseWhen You only need basic title / description tags without structured
 *   data — write them inline; SEO emits a JSON-LD payload that adds bytes to
 *   every page.
 * @relatedTo BaseHead — typical caller; SEO is the JSON-LD-bearing fragment,
 *   BaseHead is the surrounding `<head>` shell.
 * @example
 * ```astro
 * <SEO
 *   name="Team 4 Pro Coaching"
 *   title="Contact"
 *   description="Get in touch with our coaching team."
 * />
 * ```
 */
export type Props = {
  /** Site or brand name */
  name: string;
  /** Page title */
  title: string;
  /** Page description */
  description: string;
  /** Canonical URL for this page (defaults to current page URL) */
  canonicalURL?: URL | string;
  /** Language/locale code, e.g. `"en"` or `"de"` */
  locale?: string;
  /** Prevent search engines from indexing this page */
  noindex?: boolean;
  /**
   * Additional JSON-LD blocks emitted after the built-in `WebPage`/`WebSite`
   * schema. Each entry is rendered as its own `<script type="application/ld+json">`
   * tag in caller order. Pass an empty array or omit to render nothing extra.
   */
  additionalJsonLd?: readonly Record<string, unknown>[];
};

const {
  name,
  title,
  description,
  canonicalURL = new URL(Astro.url.pathname, Astro.site),
  locale = 'en_US',
  noindex = false,
  additionalJsonLd = [],
} = Astro.props;

/**
 * Enforce standard canonical URL formatting:
 * - URLs with query params: no trailing slash
 * - URLs without query params: trailing slash
 */
function formatCanonicalURL(url: string | URL): string {
  const path = url.toString();
  const hasQueryParams = path.includes('?');
  return path.replace(/\/?$/, hasQueryParams ? '' : '/');
}

const canonicalUrlString = formatCanonicalURL(canonicalURL);

const schemaType = Astro.url.pathname === '/' ? 'WebSite' : 'WebPage';

// Structured data for search engines
const schemaData = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  name,
  description,
  url: canonicalUrlString,
  inLanguage: locale,
};
---

<!-- Basic Meta Tags -->
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrlString} />

<!-- Robots Meta Tags -->
{noindex && <meta name="robots" content="noindex, nofollow" />}
{!noindex && <meta name="robots" content="max-image-preview:large" />}

<!-- Open Graph / Social Media -->
<meta property="og:type" content={schemaType} />
<meta property="og:site_name" content={name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrlString} />
<meta property="og:locale" content={locale} />

<!-- Structured Data (JSON-LD) -->
{/* SAFETY: schemaData is built from static config in this component's frontmatter */}
<script is:inline type="application/ld+json" set:html={JSON.stringify(schemaData)} />

{/* Additional JSON-LD blocks; iteration preserves caller order so consumers can rely on it. */}
{
  additionalJsonLd.map((entry) => (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(entry)} />
  ))
}
