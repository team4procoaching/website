---
/**
 * ScrollAnimations is the global scroll-triggered animation observer module —
 * include once in BaseLayout to drive `[data-animate]` reveals and
 * `[data-countup]` counters.
 *
 * @useWhen You are composing a page layout (`src/layouts/`) and need the global
 *   IntersectionObserver that toggles `.is-visible` on `[data-animate]`
 *   elements and animates `[data-countup]` counters.
 * @dontUseWhen You need an animation isolated to one component — write it
 *   inline in the component; ScrollAnimations is global by design and would
 *   over-fire.
 * @relatedTo StatsGrid — primary `[data-countup]` consumer; ScrollAnimations
 *   drives the count-up via `~/scripts/counterController`.
 * @relatedTo BaseLayout — sole intended host; ScrollAnimations is mounted once
 *   per page from the `src/layouts/BaseLayout.astro` shell.
 * @adr ADR-0015
 * @adr ADR-0020
 * @adr ADR-0026
 * @example
 * ```astro
 * <!-- in BaseLayout.astro, mounted once per page -->
 * <ScrollAnimations />
 * ```
 *
 * Observes all elements with [data-animate] and toggles .is-visible
 * when they enter the viewport (threshold 15%, 50px bottom margin).
 *
 * Also handles:
 * - Counter animations for [data-countup] elements — delegated to
 *   {@link ~/scripts/counterController} so the behavior is unit-testable
 * - Re-initialization after View Transition navigation
 *
 * Idempotent: disconnects previous observers before re-initializing.
 */
---

<script>
  import { initCounters } from '~/scripts/counterController';

  const REVEAL_OPTIONS: IntersectionObserverInit = {
    threshold: 0.15,
    rootMargin: '0px 0px -50px 0px',
  };

  // Module-level observer reference — disconnected before re-init
  // to prevent duplicate observers after View Transition navigation.
  let revealObserver: IntersectionObserver | undefined;

  function initScrollAnimations(): void {
    // Disconnect previous observer to prevent duplicates
    revealObserver?.disconnect();

    // --- Scroll Reveal ---
    const revealElements = document.querySelectorAll('[data-animate]:not(.is-visible)');

    if (revealElements.length > 0) {
      revealObserver = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            revealObserver?.unobserve(entry.target);
          }
        }
      }, REVEAL_OPTIONS);

      revealElements.forEach((el) => revealObserver?.observe(el));
    }

    // --- Counter Animations ---
    // initCounters is idempotent via the per-element `data-counted` marker,
    // so the dual dispatch below is safe without further guards here.
    initCounters(document);
  }

  // Call directly — module scripts are deferred (run after DOM parsing),
  // so the DOM is ready. DOMContentLoaded may have already fired by now.
  initScrollAnimations();

  // Re-initialize after View Transition navigation.
  // astro:page-load fires on initial load AND after each navigation
  // when View Transitions are enabled. The disconnect() call at the
  // top of initScrollAnimations() ensures idempotency.
  document.addEventListener('astro:page-load', initScrollAnimations);
</script>
