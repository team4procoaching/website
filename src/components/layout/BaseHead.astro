---
/**
 * Document `<head>` fragment with metadata, font preloads, SEO, and View Transitions.
 * Constructs the page title as "Page Title | Site Name" unless overridden.
 * Uses smartypants for typographic quotes in titles.
 *
 * @example
 * ```astro
 * <head>
 *   <BaseHead
 *     siteName="Team 4 Pro Coaching"
 *     title="Contact"
 *     description="Get in touch with our coaching team."
 *     fontPreloads={[{ href: "/fonts/manrope.woff2" }]}
 *   />
 * </head>
 *
 * <!-- Override full title -->
 * <BaseHead
 *   siteName="Team 4 Pro Coaching"
 *   overrideTitle="Custom Page Title"
 *   description="Page description."
 * />
 * ```
 */
import { ClientRouter } from 'astro:transitions';
import smartypants from 'smartypants';
import SEO from './SEO.astro';

type FontPreload = {
  href: string;
  type?: string;
};

type Props = {
  /** Site or brand name for title construction */
  siteName: string;

  /** Page-specific title (combined with site name) */
  title?: string;
  /** Complete title override (ignores automatic title construction) */
  overrideTitle?: string;

  /** Brief site description for meta tags */
  description: string;

  /** Canonical URL for this page (defaults to current page URL) */
  canonicalURL?: URL | string;
  /** Prevent search engines from indexing this page */
  noindex?: boolean;

  /** Font files to preload */
  fontPreloads?: FontPreload[];
};

const {
  siteName,
  title,
  overrideTitle,
  description,
  canonicalURL = new URL(Astro.request.url, Astro.site),
  noindex,
  fontPreloads = [],
} = Astro.props;

const finalTitle = overrideTitle ?? [title, siteName].filter(Boolean).join(' | ');
---

<!-- High Priority Global Metadata -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title set:html={smartypants(finalTitle, 1)} />

<!-- Font preloads -->
{
  fontPreloads.map((font) => (
    <link rel="preload" href={font.href} as="font" type={font.type ?? 'font/woff2'} crossorigin />
  ))
}

<!-- Low Priority Global Metadata -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<!-- View Transitions -->
<ClientRouter />

<SEO
  name={siteName}
  title={finalTitle}
  description={description}
  canonicalURL={canonicalURL}
  noindex={noindex}
/>
