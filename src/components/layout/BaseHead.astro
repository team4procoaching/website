---
/**
 * BaseHead is the document `<head>` fragment that composes site metadata, font
 * preloads, SEO meta tags, and View Transitions in one place.
 *
 * @useWhen You are composing a page-level `<head>` and want a single component
 *   to own title construction, font preloads, SEO meta tags, JSON-LD, and the
 *   View Transitions ClientRouter mount.
 * @dontUseWhen You need only basic meta tags without the SEO / JSON-LD payload
 *   — but in practice every page uses BaseHead; the layout's structural
 *   integrity depends on its View Transitions and SEO contracts.
 * @relatedTo SEO — BaseHead renders SEO internally for the meta-description /
 *   Open Graph / JSON-LD fragment.
 * @adr ADR-0031
 *
 * Constructs the page title as "Page Title | Site Name" unless overridden.
 *
 * @example
 * ```astro
 * <head>
 *   <BaseHead
 *     siteName="Team 4 Pro Coaching"
 *     title="Contact"
 *     description="Get in touch with our coaching team."
 *     fontPreloads={[{ href: "/fonts/manrope.woff2" }]}
 *   />
 * </head>
 *
 * <!-- Override full title -->
 * <BaseHead
 *   siteName="Team 4 Pro Coaching"
 *   overrideTitle="Custom Page Title"
 *   description="Page description."
 * />
 * ```
 */
import { ClientRouter } from 'astro:transitions';
import SEO from './SEO.astro';

type FontPreload = {
  href: string;
  type?: string;
};

type Props = {
  /** Site or brand name for title construction */
  siteName: string;

  /** Page-specific title (combined with site name) */
  title?: string;
  /** Complete title override (ignores automatic title construction) */
  overrideTitle?: string;

  /** Brief site description for meta tags */
  description: string;

  /** Canonical URL for this page (defaults to current page URL) */
  canonicalURL?: URL | string;
  /** Prevent search engines from indexing this page */
  noindex?: boolean;

  /** Font files to preload */
  fontPreloads?: FontPreload[];

  /**
   * Additional JSON-LD blocks forwarded to `SEO`. Each entry is emitted as its
   * own `<script type="application/ld+json">` tag in caller order.
   */
  additionalJsonLd?: readonly Record<string, unknown>[];
};

const {
  siteName,
  title,
  overrideTitle,
  description,
  canonicalURL = new URL(Astro.request.url, Astro.site),
  noindex,
  fontPreloads = [],
  additionalJsonLd,
} = Astro.props;

const finalTitle = overrideTitle ?? [title, siteName].filter(Boolean).join(' | ');

// Deduplicate font preloads by href to prevent duplicate <link> tags
// when multiple sources contribute preload entries.
const uniqueFontPreloads = Array.from(
  new Map(fontPreloads.map((font) => [font.href, font])).values(),
);
---

<!-- High Priority Global Metadata -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{finalTitle}</title>

<!-- Font preloads -->
{
  uniqueFontPreloads.map((font) => (
    <link rel="preload" href={font.href} as="font" type={font.type ?? 'font/woff2'} crossorigin />
  ))
}

<!-- Low Priority Global Metadata -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- View Transitions -->
<ClientRouter />

<SEO
  name={siteName}
  title={finalTitle}
  description={description}
  canonicalURL={canonicalURL}
  noindex={noindex}
  additionalJsonLd={additionalJsonLd}
/>
