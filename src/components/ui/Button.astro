---
/**
 * Primary call-to-action button component.
 * Renders as an anchor link by default, or as a button element when needed (e.g., for modals).
 * Supports primary (filled) and secondary (outlined) variants.
 *
 * @example
 * ```astro
 * <!-- Primary link button (default) -->
 * <Button href="/contact">Get Started</Button>
 *
 * <!-- Secondary link button -->
 * <Button href="/learn-more" variant="secondary">Learn More</Button>
 *
 * <!-- Button element for modal trigger -->
 * <Button as="button" command="show-modal" commandfor="quiz-modal">
 *   Take the Quiz
 * </Button>
 * ```
 */
type Variant = 'primary' | 'secondary';

const { variant = 'primary', as: Element = 'a', class: className, ...rest } = Astro.props;

const baseClasses =
  'inline-flex items-center justify-center rounded-md px-3.5 py-2.5 text-sm font-semibold shadow-xs transition-colors focus-visible:outline-2 focus-visible:outline-offset-2';

const variantClasses: Record<Variant, string> = {
  primary:
    'bg-accent-600 text-white hover:bg-accent-500 focus-visible:outline-accent-600 dark:bg-accent-500 dark:hover:bg-accent-400 dark:focus-visible:outline-accent-500',
  secondary:
    'bg-white text-foreground-950 ring-1 ring-foreground-950/10 hover:bg-foreground-50 focus-visible:outline-foreground-600 dark:bg-white/10 dark:text-white dark:ring-white/10 dark:hover:bg-white/20',
};

const classes = [baseClasses, variantClasses[variant as Variant], className]
  .filter(Boolean)
  .join(' ');
---

<Element class={classes} {...rest}>
  <slot />
</Element>
