---
/**
 * Primary call-to-action button component.
 * Renders as an anchor link by default, or as a button element when needed (e.g., for modals).
 * Supports primary (filled) and secondary (outlined) variants.
 *
 * Uses a discriminated union on `as` to enforce element-appropriate attributes:
 * - `as="a"` (default): requires `href`, accepts anchor attributes
 * - `as="button"`: accepts button attributes, defaults to `type="button"`
 *   to prevent accidental form submission
 *
 * @example
 * ```astro
 * <!-- Primary link button (default) -->
 * <Button href="/contact">Get Started</Button>
 *
 * <!-- Secondary link button -->
 * <Button href="/learn-more" variant="secondary">Learn More</Button>
 *
 * <!-- Button element for modal trigger -->
 * <Button as="button" command="show-modal" commandfor={MODAL_IDS.quiz}>
 *   Find Your Fit
 * </Button>
 * ```
 */

import type { HTMLAttributes } from 'astro/types';

type BaseProps = {
  /** Visual variant */
  variant?: 'primary' | 'secondary';
  /** Additional CSS classes */
  class?: string;
};

type AnchorProps = BaseProps & {
  /** Render as anchor link (default) */
  as?: 'a';
  /** Target URL (required for anchor links) */
  href: string;
} & Omit<HTMLAttributes<'a'>, 'class' | 'href'>;

type NativeButtonProps = BaseProps & {
  /** Render as button element */
  as: 'button';
} & Omit<HTMLAttributes<'button'>, 'class'>;

type Variant = NonNullable<BaseProps['variant']>;

type Props = AnchorProps | NativeButtonProps;

const { variant = 'primary', as: tag = 'a', class: className, ...rest } = Astro.props as Props;

const buttonProps = rest as Omit<NativeButtonProps, 'as' | 'variant' | 'class'>;
const anchorProps = rest as Omit<AnchorProps, 'as' | 'variant' | 'class'>;

const { type: buttonType = 'button', ...buttonRest } = buttonProps;

const baseClasses =
  'inline-flex items-center justify-center rounded-md px-3.5 py-2.5 text-sm font-semibold shadow-sm transition-colors cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 disabled:cursor-not-allowed disabled:opacity-50';

const variantClasses = {
  primary:
    'hover-shine bg-accent-600 text-white hover:bg-accent-500 focus-visible:outline-accent-600 dark:bg-accent-500 dark:hover:bg-accent-400 dark:focus-visible:outline-accent-500',
  secondary:
    'bg-white text-foreground-950 ring-1 ring-foreground-950/10 hover:bg-foreground-50 focus-visible:outline-foreground-600 dark:bg-white/10 dark:text-white dark:ring-white/10 dark:hover:bg-white/20',
} satisfies Record<Variant, string>;

// Cast needed: TS loses variant's literal type when destructuring from a union.
// At runtime, variant is always 'primary' | 'secondary' due to the default value.
const classes = [baseClasses, variantClasses[variant as Variant], className]
  .filter(Boolean)
  .join(' ');
---

{
  tag === 'button' ? (
    /* type="button" prevents accidental form submission.
       It's a safe default — explicit type="submit" on the component
       overrides it via buttonType destructuring. */
    <button class={classes} type={buttonType} {...buttonRest}>
      <slot />
    </button>
  ) : (
    <a class={classes} {...anchorProps}>
      <slot />
    </a>
  )
}
