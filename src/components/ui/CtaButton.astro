---
/**
 * CtaButton is the CTA-action resolver that renders Button as a link or a modal
 * trigger, centralising the `isModalCta()` discriminated-union narrowing.
 *
 * @useWhen Your call-site has a typed `CtaAction` value (link or modal trigger)
 *   and you do not want to write the `isModalCta()` branch yourself.
 * @dontUseWhen You already know the action is a link or a button trigger at the
 *   call-site — use Button directly with `as="a"` or `as="button"` to skip the
 *   indirection.
 * @alternativeTo Button — pick Button when you can name the rendering shape
 *   statically at the call-site; CtaButton is for when the shape comes from a
 *   `CtaAction` value.
 * @relatedTo Button — CtaButton renders a Button internally; the variant prop
 *   passes through.
 *
 * Centralizes the `isModalCta()` narrowing logic that was previously
 * duplicated in CTA.astro, HeroSplit.astro, and HeroFullscreen.astro.
 *
 * @example
 * ```astro
 * <!-- Link CTA -->
 * <CtaButton action={{ label: 'Get Started', href: '/contact' }} />
 *
 * <!-- Modal CTA -->
 * <CtaButton action={{ label: 'Find Your Fit', type: 'modal', modalId: MODAL_IDS.quiz }} />
 *
 * <!-- With variant -->
 * <CtaButton action={primaryCta} variant="secondary" />
 * ```
 */

import Button from '~/components/ui/Button.astro';
import { type CtaAction, isModalCta } from '~/types/components';

type Props = {
  /** CTA action — link or modal trigger */
  action: CtaAction;
  /** Button visual variant (passed through to Button) */
  variant?: 'primary' | 'secondary';
};

const { action, variant = 'primary' } = Astro.props;
---

{
  isModalCta(action) ? (
    <Button as="button" variant={variant} command="show-modal" commandfor={action.modalId}>
      {action.label}
    </Button>
  ) : (
    <Button href={action.href} variant={variant}>
      {action.label}
    </Button>
  )
}
