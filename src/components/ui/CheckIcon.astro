---
/**
 * CheckIcon is the checkmark icon primitive for feature lists and success
 * indicators, with `currentColor` fill for flexible styling.
 *
 * @useWhen You need a checkmark icon inside a feature list, success indicator,
 *   or confirmation surface, and want the icon's colour to follow text colour.
 * @dontUseWhen You need a different icon (warning, info, close) — CheckIcon's
 *   path is hardcoded as a checkmark. Inline a different SVG or extract a
 *   sibling icon component.
 * @example
 * ```astro
 * <li class="flex items-center gap-2">
 *   <CheckIcon class="text-accent-600" />
 *   <span>Feature included</span>
 * </li>
 * ```
 */

type Props = {
  /** Additional CSS classes */
  class?: string;
};

const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 20 20"
  fill="currentColor"
  aria-hidden="true"
  class:list={['size-5 flex-none', className]}
>
  <path
    fill-rule="evenodd"
    clip-rule="evenodd"
    d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z"
  ></path>
</svg>
