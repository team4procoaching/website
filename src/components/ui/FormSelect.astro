---
/**
 * Form select field with custom chevron indicator.
 * Uses the appearance-none + grid overlay pattern for consistent
 * cross-browser styling with a visible dropdown arrow.
 *
 * Options are passed via the default slot to support both flat options
 * and optgroup structures.
 *
 * Optionality XOR: at most one of `optional` (renders the "(optional)"
 * label hint) or `required` (sets the HTML5 `required` attribute on the
 * underlying `<select>`) may be set. The `?: never` flag on the
 * alternative branch turns "both at once" into a TypeScript error at
 * call-site, complementing the runtime check below. The "neither"
 * branch is legal for consumers that inherit required-ness from a
 * surrounding `<fieldset required>` or that want no chrome hint at all.
 * Mirrors the FilterBar labelling-XOR shape (`FilterBar.astro` +
 * `filterBarValidation.ts`).
 *
 * @example
 * ```astro
 * <FormSelect id="service" name="service" label="Service" required>
 *   <option value="">Select a service…</option>
 *   <optgroup label="Bodybuilding">
 *     <option value="competition-prep">Competition Prep</option>
 *   </optgroup>
 * </FormSelect>
 * ```
 */

import { validateFormSelectOptionality } from '~/utils/formSelectOptionalityValidation';

type BaseProps = {
  /** HTML id attribute */
  id: string;
  /** Form field name */
  name: string;
  /** Visible label text */
  label: string;
  /** Additional HTML attributes to spread on the select element */
  [key: `data-${string}`]: string | boolean;
};

/**
 * Optionality XOR: at most one of `optional` (renders the "(optional)"
 * label hint) or `required` (sets the HTML5 `required` attribute) may
 * be set. `?: never` on the alternative branch turns "both at once"
 * into a TypeScript error at call-site, complementing the runtime
 * check below. The "neither" branch is legal for consumers that
 * inherit required-ness from a surrounding `<fieldset required>` or
 * that want no chrome hint at all.
 */
type OptionalityProps =
  | { optional: true; required?: never }
  | { required: true; optional?: never }
  | { optional?: never; required?: never };

type Props = BaseProps & OptionalityProps;

const { id, name, label, optional, required, ...rest } = Astro.props;

// Runtime guard — belt-and-suspenders against .astro consumers without
// strict TypeScript. Extracted to a pure helper so the XOR contract can
// be regression-tested without an Astro render harness.
validateFormSelectOptionality({ optional, required });

// Extract data-* attributes for the select element
const dataAttrs = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key.startsWith('data-')),
);

const labelClasses = 'block text-sm/6 font-semibold text-foreground-950 dark:text-white';
---

<div class="sm:col-span-2">
  <label for={id} class={labelClasses}>
    {label}
    {optional && <span class="text-foreground-400 font-normal dark:text-gray-500">(optional)</span>}
  </label>
  <div class="mt-2.5 grid grid-cols-1">
    <select
      id={id}
      name={name}
      required={required}
      class="text-foreground-950 outline-foreground-300 focus:outline-accent-600 dark:focus:outline-accent-500 col-start-1 row-start-1 w-full appearance-none rounded-md bg-white py-2 pr-10 pl-3.5 text-base outline outline-1 -outline-offset-1 focus:outline-2 focus:-outline-offset-2 dark:bg-white/5 dark:text-white dark:outline-white/10"
      {...dataAttrs}
    >
      <slot />
    </select>
    {/* Chevron down — dropdown indicator */}
    <svg
      viewBox="0 0 16 16"
      fill="currentColor"
      aria-hidden="true"
      class="fill-foreground-500 pointer-events-none col-start-1 row-start-1 mr-3 size-5 self-center justify-self-end dark:fill-gray-400"
    >
      <path
        d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z"
        clip-rule="evenodd"
        fill-rule="evenodd"></path>
    </svg>
  </div>
</div>
