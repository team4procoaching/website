---
/**
 * StatsGrid is the scroll-triggered counter-grid primitive that renders a
 * `<dl>` of stat tiles with `data-countup` count-up animation.
 *
 * @useWhen You need a grid of numeric stats (years, percentages, counts) with
 *   the scroll-triggered count-up animation, composed inside a section
 *   component.
 * @dontUseWhen You need a generic data grid without the count-up animation or
 *   the tile background — render the data directly; StatsGrid is opinionated
 *   about visual and motion treatment.
 * @relatedTo Stats — wraps StatsGrid in a Content section for the homepage
 *   stats block.
 * @relatedTo SuccessStoryResultsGrid — wraps StatsGrid for the success-story
 *   result tiles.
 * @relatedTo SuccessStoryHero — composes StatsGrid in its footer for the
 *   process-strip metrics.
 * @adr ADR-0015
 * @adr ADR-0040
 *
 * Renders a `<dl>` where each entry shows a large numeric value and a label,
 * with the global ScrollAnimations observer driving the count-up via
 * `data-countup*` attributes and the stagger via `data-animate-stagger`.
 *
 * Stagger limit: the `:nth-child` delay rules in `~/styles/global.css` cover
 * up to eight tiles. Beyond the eighth, tiles render correctly but lose
 * their staggered `transition-delay`. The cap is enforced upstream on the
 * success-story authoring surface via `StoryStats` in `~/data/successStories`
 * (see ADR-0040). Other callers stay within the cap by construction:
 * `src/pages/index.astro` derives its array from
 * `Object.values(statsSection.stats)`, which is record-keyed by `StatId`
 * (`as const satisfies Record<StatId, …>` in `~/data/stats`); inline-literal
 * callers (`src/pages/coaches/index.astro` `heroStats`,
 * `src/components/sections/services/ServicesCatalog.astro` `servicesStats`)
 * own their cap discipline locally with 2–3-element literals.
 *
 * The component owns only the grid and its tiles — no outer margin, no
 * section wrapper, no headline. The consumer composes it into a section
 * (e.g. inside `Content.astro`) and applies spacing via the `class` prop.
 *
 * Background constraint: the tile fill uses semi-transparent neutrals
 * (`bg-foreground-950/5 dark:bg-white/5`), which blend into the section
 * background and only read as a grid on light section backgrounds
 * (`default`, `muted`). Rendering onto dark section backgrounds (e.g.
 * `teal`) is not supported — the tiles would lose visual separation. No
 * `background` prop is exposed until a dark-background consumer exists;
 * see ADR-0014 for the project's dark-background handling pattern.
 *
 * @example
 * ```astro
 * ---
 * import StatsGrid from '~/components/ui/StatsGrid.astro';
 * import { statsSection } from '~/data/stats';
 * ---
 * <StatsGrid stats={Object.values(statsSection.stats)} columns={4} class="mt-16" />
 * ```
 *
 * @see ~/data/stats — the `Stat` type consumed here
 */
import type { Stat } from '~/data/stats';
import { composeCounterText } from '~/scripts/counterController';

type Props = {
  /** Stats tiles to render, one per grid cell */
  stats: readonly Stat[];
  /**
   * Column count on the widest breakpoint. When omitted, derives from
   * `stats.length` — 1–2 tiles render in 2 columns, 3 tiles in 3,
   * 4+ tiles in 4 — so the grid never leaves a trailing empty cell.
   */
  columns?: 2 | 3 | 4;
  /** Optional consumer-side class (e.g. outer margin) merged onto the root <dl> */
  class?: string;
};

const {
  stats,
  columns = stats.length <= 2 ? 2 : stats.length === 3 ? 3 : 4,
  class: className,
} = Astro.props;

const gridColumnClasses = {
  2: 'grid-cols-1 sm:grid-cols-2',
  3: 'grid-cols-1 sm:grid-cols-3',
  4: 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-4',
} satisfies Record<NonNullable<Props['columns']>, string>;
---

<dl
  data-animate-stagger
  class:list={[
    'grid gap-0.5 overflow-hidden rounded-2xl text-center',
    gridColumnClasses[columns],
    className,
  ]}
>
  {
    stats.map((stat) => (
      <div data-animate="scale-up" class="bg-foreground-950/5 flex flex-col p-8 dark:bg-white/5">
        <dt class="text-foreground-600 text-sm/6 font-semibold dark:text-gray-300">{stat.label}</dt>
        <dd
          data-countup
          data-countup-target={stat.target}
          {...(stat.prefix ? { 'data-countup-prefix': stat.prefix } : {})}
          {...(stat.suffix ? { 'data-countup-suffix': stat.suffix } : {})}
          class="text-foreground-950 order-first font-serif text-3xl font-bold tracking-tight dark:text-white"
        >
          {composeCounterText(stat.target, stat.prefix ?? '', stat.suffix ?? '')}
        </dd>
      </div>
    ))
  }
</dl>
