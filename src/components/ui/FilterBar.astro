---
/**
 * JS-driven pill-style filter bar with toolbar/aria-pressed semantics.
 *
 * This is a template primitive — it renders markup and attributes but does
 * not carry its own behavior. Consumers wire up a controller module that
 * listens for clicks, manages URL state, handles deep-links, and performs
 * keyboard navigation (Arrow keys / Home / End with roving tabindex). See
 * {@link src/scripts/servicesFilterController.ts} for the reference consumer.
 *
 * Use {@link SegmentedControl} instead when the control is a pure local
 * selection with no URL state, no scroll side-effects, and no deep-links —
 * SegmentedControl is CSS-only (radio buttons + `:checked`) and does not
 * ship JavaScript. FilterBar and SegmentedControl share pill styling but
 * have disjoint interaction models. See ADR-0023 for the decision tree.
 *
 * ARIA: `role="toolbar"` needs an Accessible Name. Consumers pick exactly
 * one of two labelling paths:
 *
 * - **`ariaLabelledBy`** — reference a visible label element outside the
 *   primitive (e.g., `<p id="filter-label">Browse by goal</p>`). Use this
 *   when the surrounding design already carries a label that would be
 *   duplicated by a hidden one.
 * - **`ariaLabel`** — an invisible string name on the toolbar itself. Use
 *   this when no visible label element is positioned as a DOM-id anchor for
 *   `aria-labelledby` (e.g., the surrounding composition establishes the
 *   filter's purpose through section context and pill labels rather than a
 *   referenced label element).
 *
 * Supplying both or neither throws at render time — single source of
 * labelling truth is required for a valid Accessible Name.
 *
 * Each button carries `aria-pressed="true|false"` reflecting
 * the active filter — only one button is pressed at a time for single-select
 * filtering (including "All"), but the toolbar pattern itself does not
 * forbid multi-pressed states, so consumers with multi-select filters can
 * reuse this primitive.
 *
 * Visual state is driven entirely by `aria-pressed`: Tailwind's
 * `aria-pressed:` variant applies the active pill styling. The controller
 * toggles the attribute; CSS handles the rest. No controller-side class
 * maps are required.
 *
 * Layout is the consumer's responsibility. The primitive renders its pill
 * container (`inline-flex`) directly — centering, alignment, or grid
 * placement is applied by whoever embeds it, consistent with
 * {@link SegmentedControl}'s composition model.
 *
 * Sentinel-ID contract: when paired with `servicesFilterController`, the
 * `items` array must include an entry with `id: "all"` — the controller
 * treats this ID as the sentinel for the unfiltered view. Other controllers
 * may use different conventions; the primitive itself is agnostic.
 *
 * @example With visible label (ariaLabelledBy):
 * ```astro
 * ---
 * import FilterBar from '~/components/ui/FilterBar.astro';
 * ---
 * <p id="filter-label" class="text-sm text-foreground-600">Browse by goal</p>
 * <FilterBar
 *   items={[
 *     { id: 'all', label: 'All' },
 *     { id: 'bodybuilding', label: 'Bodybuilding' },
 *     { id: 'athletic', label: 'Athletic' },
 *     { id: 'wellness', label: 'Wellness' },
 *   ]}
 *   defaultValue="all"
 *   ariaLabelledBy="filter-label"
 *   name="category"
 * />
 * ```
 *
 * @example Without visible label (ariaLabel):
 * ```astro
 * <FilterBar
 *   items={[
 *     { id: 'all', label: 'All' },
 *     { id: 'bodybuilding', label: 'Bodybuilding' },
 *     { id: 'athletic', label: 'Athletic' },
 *     { id: 'wellness', label: 'Wellness' },
 *   ]}
 *   defaultValue="all"
 *   ariaLabel="Filter services by goal"
 *   name="category"
 * />
 * ```
 */

import { validateFilterBarLabelling } from '~/utils/filterBarValidation';

type FilterItem = {
  /** Unique value for this filter option */
  id: string;
  /** Display label */
  label: string;
};

type BaseProps = {
  /** Items to display as filter buttons */
  items: readonly FilterItem[];
  /** Initially active item (must match an item's id) */
  defaultValue: string;
  /** Prefix for the data attribute applied to each button: data-{name}-button */
  name: string;
};

/**
 * Labelling XOR: exactly one of ariaLabelledBy (reference a visible label)
 * or ariaLabel (invisible accessible name) must be provided. The `?: never`
 * flag on the alternative prop turns "both at once" into a TypeScript error
 * at call-site, complementing the runtime check below.
 */
type LabellingProps =
  | { ariaLabelledBy: string; ariaLabel?: never }
  | { ariaLabel: string; ariaLabelledBy?: never };

type Props = BaseProps & LabellingProps;

const { items, defaultValue, ariaLabelledBy, ariaLabel, name } = Astro.props;

if (items.length === 0) {
  throw new Error('FilterBar requires at least one item');
}

// Runtime guard — belt-and-suspenders against .astro consumers without
// strict TypeScript. Extracted to a pure helper so the XOR contract can be
// regression-tested without an Astro render harness.
validateFilterBarLabelling(ariaLabelledBy, ariaLabel);
---

<div
  role="toolbar"
  aria-labelledby={ariaLabelledBy}
  aria-label={ariaLabel}
  class="inset-ring-foreground-950/10 inline-flex rounded-full p-1 text-center font-semibold inset-ring dark:inset-ring-white/10"
>
  {
    items.map((item) => {
      const isActive = item.id === defaultValue;
      return (
        /* Visual state is driven by aria-pressed alone. Tailwind's aria-pressed: 
           variant applies the active pill; unpressed buttons use the neutral hover/text styling. */
        <button
          type="button"
          aria-pressed={isActive ? 'true' : 'false'}
          tabindex={isActive ? 0 : -1}
          class="focus-visible:outline-accent-600 text-foreground-700 hover:bg-foreground-100 hover:text-foreground-950 aria-pressed:bg-accent-600 aria-pressed:hover:bg-accent-600 dark:aria-pressed:bg-accent-500 cursor-pointer rounded-full px-4 py-1.5 text-xs font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 aria-pressed:text-white aria-pressed:hover:text-white sm:text-sm/6 dark:text-gray-400 dark:hover:bg-white/10 dark:hover:text-white"
          {...{ [`data-${name}-button`]: item.id }}
        >
          {item.label}
        </button>
      );
    })
  }
</div>
