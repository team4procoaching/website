---
/**
 * Card is the flexible card-container primitive, with optional named `header`
 * and `footer` slots and a dark-background variant.
 *
 * @useWhen You need a card-shaped surface that wraps content with a consistent
 *   rounded border and shadow, optionally with header and footer regions.
 * @dontUseWhen The component you want already exists as a domain card
 *   (ServiceCard, PackageCard, CoachCardCompact, TestimonialCard,
 *   SuccessStoryGridCard, SuccessStoryOverviewCard) — use the domain card; Card
 *   is the generic primitive those compose.
 * @relatedTo PackageCard — composes Card with header / body / footer slots for
 *   the session configurator.
 * @relatedTo ServiceCard — composes Card with header / body / footer slots for
 *   the services catalogue.
 * @example
 * ```astro
 * <Card>
 *   <Fragment slot="header"><h3>Premium</h3></Fragment>
 *   <p>Plan description and features.</p>
 *   <Fragment slot="footer"><Button href="/signup">Sign Up</Button></Fragment>
 * </Card>
 * ```
 */

type Props = {
  /** Whether the card sits on a dark section background */
  darkBackground?: boolean;
  /** Additional CSS classes */
  class?: string;
};

const { darkBackground = false, class: className } = Astro.props;

const baseClasses = 'flex flex-col rounded-3xl p-8 xl:p-10';

const variantClasses = darkBackground
  ? 'bg-white shadow-lg shadow-black/10 dark:bg-background-dark-muted dark:ring-1 dark:ring-white/10'
  : 'bg-white ring-1 ring-foreground-950/10 dark:bg-background-dark-muted dark:ring-white/10';

const hasHeader = Astro.slots.has('header');
const hasFooter = Astro.slots.has('footer');
---

<div class:list={[baseClasses, variantClasses, className]}>
  {
    hasHeader && (
      <div class="card-header">
        <slot name="header" />
      </div>
    )
  }
  <div class="card-body flex-1">
    <slot />
  </div>
  {
    hasFooter && (
      <div class="card-footer mt-8">
        <slot name="footer" />
      </div>
    )
  }
</div>
