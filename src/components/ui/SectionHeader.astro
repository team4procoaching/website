---
/**
 * Reusable section header with headline and optional intro text.
 * Use this as a building block inside section components.
 *
 * @example
 * ```astro
 * <section class="...">
 *   <SectionHeader headline="Our Features">
 *     <p>Discover what makes us different.</p>
 *   </SectionHeader>
 *
 *   <!-- On a dark section background -->
 *   <SectionHeader headline="Our Programs" background="teal">
 *     <p>Choose your path.</p>
 *   </SectionHeader>
 * </section>
 * ```
 */
import { type SectionBackground, sectionHeadline, sectionText } from '~/styles/sectionStyles';

type Props = {
  /** Optional eyebrow label above headline (e.g. "Testimonials") */
  eyebrow?: string;
  /** Section headline */
  headline: string;
  /** Semantic heading level */
  headingLevel?: 'h1' | 'h2' | 'h3' | 'h4';
  /** Text alignment */
  align?: 'center' | 'left';
  /** ID for the heading (used for aria-labelledby on parent section) */
  headingId?: string;
  /** Background context — drives text color selection */
  background?: SectionBackground;
};

const {
  eyebrow,
  headline,
  headingLevel: Tag = 'h2',
  align = 'center',
  headingId,
  background = 'default',
} = Astro.props;

const alignClasses = {
  center: 'mx-auto max-w-2xl text-center',
  left: 'max-w-2xl text-left',
} satisfies Record<NonNullable<Props['align']>, string>;

// Astro.slots.has is whitespace-permissive — it returns true for forwarded
// slots that ultimately carry no content. Render-and-trim instead, matching
// the pattern documented in ServicesCatalog.astro:64-69.
const slotHtml = (await Astro.slots.render('default')) ?? '';
const hasSlotContent = slotHtml.trim().length > 0;
---

<div class={alignClasses[align]}>
  {
    eyebrow && (
      <p class="text-accent-600 dark:text-accent-400 text-base/7 font-semibold">{eyebrow}</p>
    )
  }
  <Tag
    id={headingId}
    class:list={[
      'font-serif text-4xl font-bold tracking-tight sm:text-5xl',
      sectionHeadline[background],
      eyebrow && 'mt-2',
    ]}
  >
    {headline}
  </Tag>
  {
    hasSlotContent && (
      <div
        class:list={['mt-6 text-lg font-medium text-pretty sm:text-xl/8', sectionText[background]]}
      >
        <Fragment set:html={slotHtml} />
      </div>
    )
  }
</div>
