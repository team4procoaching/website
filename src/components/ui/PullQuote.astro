---
/**
 * PullQuote is the highlighted-quote primitive for the `aside` slot inside
 * two-column Content layouts, with default and large size variants.
 *
 * @useWhen You are composing a Content section in `layout="two-column"` and
 *   need to highlight a sentence or short paragraph in the aside column.
 * @dontUseWhen You need a multi-paragraph testimonial with attribution image
 *   and author title — use TestimonialCard, which has the structured figure /
 *   figcaption shape PullQuote does not.
 * @alternativeTo TestimonialCard — pick TestimonialCard for client testimonials
 *   with attribution; PullQuote is for in-narrative emphasis pulls.
 * @relatedTo Content — primary consumer; PullQuote sits in Content's `aside`
 *   slot.
 * @example
 * ```astro
 * <Content headline="Our Story" layout="two-column">
 *   <p>Main content…</p>
 *   <PullQuote slot="aside" cite="Helle Trevino">
 *     Three minds, three decades of experience each, one unified mission.
 *   </PullQuote>
 * </Content>
 * ```
 */

type Props = {
  /** Optional citation/attribution */
  cite?: string;
  /** Visual variant */
  variant?: 'default' | 'large';
};

const { cite, variant = 'default' } = Astro.props;

const quoteClasses = {
  default: 'text-xl/8 sm:text-2xl/9',
  large: 'text-2xl/9 sm:text-3xl/10',
};
---

<figure
  class="border-accent-600 dark:border-accent-500 pullquote-animate border-l-4 pl-8"
  data-animate="fade"
>
  <blockquote
    class:list={[
      'text-foreground-950 font-serif font-medium italic dark:text-white',
      quoteClasses[variant],
    ]}
  >
    <p>"<slot />"</p>
  </blockquote>
  {
    cite && (
      <figcaption class="text-foreground-600 mt-4 text-sm dark:text-gray-400">— {cite}</figcaption>
    )
  }
</figure>
