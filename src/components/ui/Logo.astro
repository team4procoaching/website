---
/**
 * Logo is the site brand-logo primitive with light / dark background variant
 * support, linking to home.
 *
 * @useWhen You need the brand logo in a header, footer, mobile menu, or splash
 *   surface, and want the light / dark variant to switch with the surrounding
 *   background.
 * @dontUseWhen You need a generic content image — use SmartImage, which handles
 *   `ImageSource` discrimination, responsive widths, and accessibility alt
 *   text. Logo is brand-specific and always links to home.
 * @relatedTo Header — primary consumer; Header positions Logo at the top-left
 *   of the absolute-positioned navigation bar.
 * @relatedTo MobileMenu — secondary consumer; MobileMenu repeats Logo at the
 *   top of the slide-in panel.
 * @example
 * ```astro
 * <Logo name={siteName} logo={logo} variant="on-dark" />
 * ```
 */
import { routes } from '~/data/routes';
import type { LogoConfig } from '~/data/site';

type Props = {
  /** Site or brand name for accessibility */
  name: string;
  /** Logo URLs for light/dark mode */
  logo: LogoConfig;
  /** Optional height class (Tailwind), defaults to h-8 */
  height?: string;
  /** Color variant based on background */
  variant?: 'default' | 'on-dark';
};

const { name, logo, height = 'h-8', variant = 'default' } = Astro.props;
---

<a href={routes.home} class="-m-1.5 p-1.5">
  <span class="sr-only">{name}</span>
  {
    variant === 'on-dark' ? (
      /* On dark background: always show light/dark logo */
      <img src={logo.dark} alt="" role="presentation" class:list={[height, 'w-auto']} />
    ) : (
      /* On light background: respect system dark mode */
      <>
        <img
          src={logo.light}
          alt=""
          role="presentation"
          class:list={[height, 'w-auto dark:hidden']}
        />
        <img
          src={logo.dark}
          alt=""
          role="presentation"
          class:list={[height, 'w-auto not-dark:hidden']}
        />
      </>
    )
  }
</a>
