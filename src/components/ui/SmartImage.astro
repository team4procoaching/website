---
/**
 * SmartImage is the unified image primitive that wraps Astro's `<Image />`,
 * handling the `ImageSource` discriminated-union narrowing in one place.
 *
 * @useWhen You are rendering a content image larger than 64px and need the
 *   `ImageSource` discriminated union (local Astro asset vs. remote URL with
 *   explicit dimensions) handled by the component.
 * @dontUseWhen You are rendering a small decorative image (≤ 64px — avatars,
 *   icons, small badges) — use a plain `<img>` per ADR-0010 to avoid the
 *   build-time `<Image />` overhead.
 * @adr ADR-0010
 * @example
 * ```astro
 * <SmartImage
 *   src={remoteImage('https://…', 800, 600)}
 *   alt="Description"
 *   widths={[400, 800]}
 *   sizes="(max-width: 800px) 100vw, 800px"
 * />
 * ```
 */
import { Image } from 'astro:assets';
import type { ImageSource } from '~/types/components';

type Props = {
  /** Image source (local asset or remote URL with dimensions) */
  src: ImageSource;
  /** Alt text for accessibility */
  alt: string;
  /** Responsive image widths for srcset generation */
  widths?: number[];
  /** Responsive sizes attribute */
  sizes?: string;
  /** Loading strategy */
  loading?: 'lazy' | 'eager';
  /** Additional CSS classes */
  class?: string;
};

const { src, alt, widths, sizes, loading, class: className } = Astro.props;
---

{
  src.kind === 'remote' ? (
    <Image
      src={src.src}
      alt={alt}
      width={src.width}
      height={src.height}
      widths={widths}
      sizes={sizes}
      loading={loading}
      class={className}
    />
  ) : (
    <Image
      src={src.src}
      alt={alt}
      widths={widths}
      sizes={sizes}
      loading={loading}
      class={className}
    />
  )
}
