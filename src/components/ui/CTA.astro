---
/**
 * Call-to-action box with multiple visual variants.
 * Can be used standalone or embedded within other sections.
 * Supports both link buttons and modal triggers.
 *
 * **Variants:**
 * - `dark` (default): Solid dark background for use on light sections
 * - `glass`: Semi-transparent panel for use on dark/colored section backgrounds
 *
 * Note: Modal triggers use the experimental Invoker API (`command`/`commandfor`).
 * Browser support is currently limited (Chrome 135+). Ensure a JS fallback is in place
 * for broader compatibility, or the el-dialog custom element handles this.
 *
 * @example
 * ```astro
 * <!-- Standalone CTA on light background -->
 * <Cta
 *   headline="Ready to Get Started?"
 *   description="Join thousands of satisfied customers."
 *   primaryCta={{ label: "Sign Up", href: "/signup" }}
 *   secondaryCta={{ label: "Learn More", href: "/about" }}
 * />
 *
 * <!-- Glass CTA on dark section background -->
 * <Cta
 *   headline="Not Sure Which Plan?"
 *   description="Take our quiz to find the perfect fit."
 *   primaryCta={{ label: "Take Quiz", type: "modal", modalId: "quiz-modal" }}
 *   headingLevel="h3"
 *   size="compact"
 *   variant="glass"
 * />
 * ```
 */

import CtaButton from '~/components/ui/CtaButton.astro';
import TextLink from '~/components/ui/TextLink.astro';
import type { CtaAction, SecondaryCta } from '~/types/components';
import { slugify } from '~/utils/slugify';

type Props = {
  /** CTA headline */
  headline: string;
  /** Description text */
  description: string;
  /** Primary CTA button (link or modal trigger) */
  primaryCta: CtaAction;
  /** Optional secondary text link */
  secondaryCta?: SecondaryCta;
  /** Heading level - use h2 for standalone sections, h3 when nested */
  headingLevel?: 'h2' | 'h3';
  /** Size variant */
  size?: 'default' | 'compact';
  /** Visual variant */
  variant?: 'dark' | 'glass';
};

const {
  headline,
  description,
  primaryCta,
  secondaryCta,
  headingLevel = 'h2',
  size = 'default',
  variant = 'dark',
} = Astro.props;

const HeadingTag = headingLevel;

// Generate IDs for accessibility
const headlineId = `cta-${slugify(headline)}`;
const descriptionId = `${headlineId}-desc`;

const isGlass = variant === 'glass';

const styles = {
  container: {
    default: 'px-6 py-24 sm:px-16',
    compact: 'px-6 py-16 sm:px-16',
  },
  headline: {
    default: 'text-4xl sm:text-5xl',
    compact: 'text-2xl sm:text-3xl',
  },
  description: {
    default: 'mt-6 text-lg/8',
    compact: 'mt-4 text-base/7',
  },
  actions: {
    default: 'mt-10',
    compact: 'mt-8',
  },
} as const;

const containerClasses = isGlass
  ? 'overflow-hidden rounded-3xl text-center bg-white/10 inset-ring inset-ring-white/20 backdrop-blur-sm'
  : 'bg-foreground-950 overflow-hidden rounded-3xl text-center shadow-2xl dark:bg-background-dark-muted dark:shadow-none dark:inset-ring dark:inset-ring-white/10';

const headlineClasses = isGlass
  ? 'font-serif font-bold tracking-tight text-balance text-white'
  : 'font-serif font-bold tracking-tight text-balance text-white';

const descriptionClasses = isGlass
  ? 'mx-auto max-w-xl text-pretty text-white/80'
  : 'mx-auto max-w-xl text-pretty text-gray-300';
---

<div
  role="region"
  aria-labelledby={headlineId}
  aria-describedby={descriptionId}
  data-animate="fade-up-lg"
  class:list={[containerClasses, styles.container[size]]}
>
  <HeadingTag id={headlineId} class:list={[headlineClasses, styles.headline[size]]}>
    {headline}
  </HeadingTag>
  <p id={descriptionId} class:list={[descriptionClasses, styles.description[size]]}>
    {description}
  </p>
  <div class:list={['flex items-center justify-center gap-x-6', styles.actions[size]]}>
    <CtaButton action={primaryCta} variant={isGlass ? 'primary' : 'secondary'} />
    {
      secondaryCta && (
        <TextLink href={secondaryCta.href} variant="light">
          {secondaryCta.label}
        </TextLink>
      )
    }
  </div>
</div>
