---
/**
 * Shared pill-style switcher with mobile select dropdown and desktop buttons.
 * Renders the template only — each consumer provides its own `<script>`.
 *
 * Supports two ARIA patterns:
 * - `tabs`: `role="tablist"` + `role="tab"` with `aria-selected` and `aria-controls`
 * - `toolbar`: `role="toolbar"` with `aria-pressed`
 *
 * Data attributes are prefixed with the `name` prop so consumer scripts
 * can target them (e.g., `data-category-tab`, `data-filter-select`).
 *
 * @example
 * ```astro
 * <!-- Tab pattern (switches panels) -->
 * <PillSwitcher
 *   items={categories.map((c) => ({ id: c.id, label: c.name }))}
 *   defaultValue="bodybuilding"
 *   ariaLabel="Service categories"
 *   name="category"
 *   variant="tabs"
 * />
 *
 * <!-- Filter pattern (toggles card visibility) -->
 * <PillSwitcher
 *   items={filterOptions}
 *   defaultValue="all"
 *   ariaLabel="Filter by program type"
 *   name="filter"
 *   variant="toolbar"
 * />
 * ```
 */

type PillItem = {
  /** Unique value for this option */
  id: string;
  /** Display label */
  label: string;
};

type Props = {
  /** Items to display as options */
  items: readonly PillItem[];
  /** Initially active value */
  defaultValue: string;
  /** Accessible label for the control group */
  ariaLabel: string;
  /** Prefix for data attributes: data-{name}-tab, data-{name}-select */
  name: string;
  /** ARIA pattern: 'tabs' for panel switching, 'toolbar' for filtering */
  variant?: 'tabs' | 'toolbar';
};

const { items, defaultValue, ariaLabel, name, variant = 'toolbar' } = Astro.props;

const isTabs = variant === 'tabs';

// Shared pill classes — identical for both variants
const baseClasses =
  'focus-visible:outline-accent-600 cursor-pointer rounded-lg px-4 py-2.5 text-sm font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2';
const activeClasses = 'bg-accent-600 dark:bg-accent-500 text-white';
const inactiveClasses =
  'text-foreground-600 hover:bg-foreground-100 hover:text-foreground-950 dark:text-gray-400 dark:hover:bg-white/10 dark:hover:text-white';
---

{/* Mobile: Dropdown select */}
<div class="grid grid-cols-1 sm:hidden">
  <select
    aria-label={ariaLabel}
    class="text-foreground-950 outline-foreground-200 focus:outline-accent-600 dark:focus:outline-accent-500 col-start-1 row-start-1 w-full appearance-none rounded-lg bg-white py-3 pr-10 pl-4 text-base font-medium outline-1 -outline-offset-1 focus:outline-2 focus:-outline-offset-2 dark:bg-white/5 dark:text-white dark:outline-white/10"
    {...{ [`data-${name}-select`]: true }}
  >
    {
      items.map((item) => (
        <option value={item.id} selected={item.id === defaultValue}>
          {item.label}
        </option>
      ))
    }
  </select>
  <svg
    viewBox="0 0 16 16"
    fill="currentColor"
    aria-hidden="true"
    class="fill-foreground-500 pointer-events-none col-start-1 row-start-1 mr-3 size-5 self-center justify-self-end dark:fill-gray-400"
  >
    <path
      d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z"
      clip-rule="evenodd"
      fill-rule="evenodd"></path>
  </svg>
</div>

{/* Desktop: Pill buttons */}
<div class="hidden sm:block">
  <div
    role={isTabs ? 'tablist' : 'toolbar'}
    aria-label={ariaLabel}
    class="flex justify-center space-x-2"
  >
    {
      items.map((item) => {
        const isActive = item.id === defaultValue;
        return (
          <button
            type="button"
            {...(isTabs
              ? {
                  role: 'tab',
                  'aria-selected': isActive ? 'true' : 'false',
                  'aria-controls': `${name}-panel-${item.id}`,
                  id: `${name}-tab-${item.id}`,
                }
              : {
                  'aria-pressed': isActive ? 'true' : 'false',
                })}
            tabindex={isActive ? 0 : -1}
            class:list={[baseClasses, isActive ? activeClasses : inactiveClasses]}
            {...{ [`data-${name}-tab`]: item.id }}
          >
            {item.label}
          </button>
        );
      })
    }
  </div>
</div>
