---
/**
 * TextLink is the subtle text-link primitive with trailing arrow indicator, for
 * secondary navigation actions.
 *
 * @useWhen You need a subtle "see more / browse all" link with the arrow
 *   indicator, on either light or dark backgrounds.
 * @dontUseWhen You need a filled-CTA visual treatment — use Button, which
 *   carries the primary / secondary filled variants; TextLink is the
 *   underline-with-arrow shape, not a filled button.
 * @alternativeTo Button — pick Button for filled-CTA actions; TextLink is the
 *   lighter secondary affordance.
 * @example
 * ```astro
 * <TextLink href="/services">Browse All Services</TextLink>
 * <TextLink href="/about" variant="light">Learn More</TextLink>
 * ```
 */

import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'> & {
  /** Target URL */
  href: string;
  /** Color variant for different backgrounds */
  variant?: 'default' | 'light';
};

const { href, variant = 'default', class: className, ...rest } = Astro.props;

const variants = {
  default: 'text-foreground-950 hover:text-foreground-700 dark:text-white dark:hover:text-gray-300',
  light: 'text-white hover:text-gray-200',
};

const classes = [
  'animated-underline text-sm/6 font-semibold transition-colors',
  variants[variant],
  className,
]
  .filter(Boolean)
  .join(' ');
---

<a href={href} class={classes} {...rest}>
  <slot />
  <span aria-hidden="true">→</span>
</a>
