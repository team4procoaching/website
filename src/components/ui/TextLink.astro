---
/**
 * Text link with arrow indicator for secondary navigation actions.
 * Supports default (dark text) and light (white text) variants.
 *
 * @example
 * ```astro
 * <!-- Default variant (on light backgrounds) -->
 * <TextLink href="/services">Browse All Services</TextLink>
 *
 * <!-- Light variant (on dark backgrounds like CTAs) -->
 * <TextLink href="/about" variant="light">Learn More</TextLink>
 * ```
 */

import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'> & {
  /** Target URL */
  href: string;
  /** Color variant for different backgrounds */
  variant?: 'default' | 'light';
};

const { href, variant = 'default', class: className, ...rest } = Astro.props;

const variants = {
  default: 'text-foreground-950 hover:text-foreground-700 dark:text-white dark:hover:text-gray-300',
  light: 'text-white hover:text-gray-200',
};

const classes = [
  'animated-underline text-sm/6 font-semibold transition-colors',
  variants[variant],
  className,
]
  .filter(Boolean)
  .join(' ');
---

<a href={href} class={classes} {...rest}>
  <slot />
  <span aria-hidden="true">→</span>
</a>
