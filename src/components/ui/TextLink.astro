---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'> & {
  /** Target URL */
  href: string;
  /** Color variant for different backgrounds */
  variant?: 'default' | 'light';
};

const { href, variant = 'default', class: className, ...rest } = Astro.props;

const variants = {
  default: 'text-foreground-950 hover:text-foreground-700 dark:text-white dark:hover:text-gray-300',
  light: 'text-white hover:text-gray-200',
};

const classes = ['text-sm/6 font-semibold transition-colors', variants[variant], className]
  .filter(Boolean)
  .join(' ');
---

<a href={href} class={classes} {...rest}>
  <slot />
  <span aria-hidden="true">→</span>
</a>
