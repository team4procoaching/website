---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'> & {
  /** Target URL */
  href: string;
};

const { href, class: className, ...rest } = Astro.props;

const classes = [
  'text-sm/6 font-semibold text-foreground-950 transition-colors hover:text-foreground-700 dark:text-white dark:hover:text-gray-300',
  className,
]
  .filter(Boolean)
  .join(' ');
---

<a href={href} class={classes} {...rest}>
  <slot />
  <span aria-hidden="true">→</span>
</a>
