---
/**
 * SubmitButton is the thin form-submit wrapper around Button, rendering as
 * `<button type="submit">` with the same variant styling.
 *
 * @useWhen You need a submit button inside a `<form>` — SubmitButton presets
 *   `as="button"` and `type="submit"` so the call-site does not.
 * @dontUseWhen You need a navigation link or modal trigger — use Button
 *   directly with `as="a"` or `as="button"` + Invokers API attributes;
 *   SubmitButton is form-only.
 * @alternativeTo Button — pick Button when the trigger is not a form submit.
 * @relatedTo Button — SubmitButton renders a Button internally.
 * @example
 * ```astro
 * <SubmitButton>Send Message</SubmitButton>
 * <SubmitButton variant="secondary">Save Draft</SubmitButton>
 * ```
 */

import Button from '~/components/ui/Button.astro';

type Props = {
  /** Button style variant */
  variant?: 'primary' | 'secondary';
  /** Additional CSS classes */
  class?: string;
  /** Disabled state */
  disabled?: boolean;
};

const { variant = 'primary', ...rest } = Astro.props;
---

<Button as="button" type="submit" variant={variant} {...rest}>
  <slot />
</Button>
