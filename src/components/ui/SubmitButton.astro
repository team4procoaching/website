---
/**
 * Form submit button — thin wrapper around {@link Button}.
 * Renders as `<button type="submit">` with the same visual styling.
 *
 * Use this for form submissions. For navigation links or modal triggers,
 * use Button.astro directly.
 *
 * @example
 * ```astro
 * <SubmitButton>Send Message</SubmitButton>
 * <SubmitButton variant="secondary">Save Draft</SubmitButton>
 * ```
 */

import Button from '~/components/ui/Button.astro';

type Props = {
  /** Button style variant */
  variant?: 'primary' | 'secondary';
  /** Additional CSS classes */
  class?: string;
  /** Disabled state */
  disabled?: boolean;
};

const { variant = 'primary', ...rest } = Astro.props;
---

<Button as="button" type="submit" variant={variant} {...rest}>
  <slot />
</Button>
