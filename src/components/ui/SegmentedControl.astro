---
/**
 * CSS-only segmented control (radio button group) for toggling between options.
 * Works without JavaScript using the :checked pseudo-class.
 *
 * Use this primitive for pure local selection where the control has no side
 * effects beyond its own visual state and dependent CSS — e.g., a pricing
 * period toggle that drives per-card price visibility via `:has()` selectors
 * on a parent with `group/{name}`. No URL state, no scroll, no deep-links.
 *
 * Use {@link FilterBar} instead when the control changes what content is
 * visible and that state must survive URL sharing, bookmarks, or deep-links
 * from external sources (e.g., the Services-page category filter). FilterBar
 * is JS-driven with `role="toolbar"` + `aria-pressed`; SegmentedControl stays
 * CSS-only with `<fieldset>` + radio inputs. See ADR-0023 for the full
 * decision tree.
 *
 * Note: Parent container must have `group/{name}` class to enable
 * CSS-based content switching with `group-has-[...]` selectors.
 *
 * ARIA: `<fieldset>` needs an Accessible Name. Both WAI-ARIA labelling
 * mechanisms (`aria-labelledby` and a `<legend>` element) are equally valid
 * here; the primitive does not prefer one path over the other. Consumers pick
 * exactly one based on a structural heuristic — what the surrounding DOM
 * offers, not how "sufficient" ambient copy feels:
 *
 * - **`ariaLabelledBy`** — a visible label element is already positioned as
 *   a DOM-id anchor (e.g., `<p id="toggle-label">Show pricing for:</p>`). Use
 *   this when the surrounding design already carries such a label and a
 *   hidden `<legend>` would duplicate it. The `<fieldset>` binds
 *   `aria-labelledby` to the anchor and the `<legend>` is omitted.
 * - **`ariaLabel`** — no visible label element is positioned as a DOM-id
 *   anchor. The surrounding composition establishes the control's purpose
 *   through section context or other surrounding copy rather than a
 *   referenced label element. The `<legend>` is rendered as `sr-only`
 *   carrying the label text.
 *
 * The heuristic resolves to a single answer for any given template: the
 * consumer looks at their own markup for a DOM-id anchor, not at whether
 * ambient copy carries "enough" context to substitute for a label.
 *
 * Supplying both or neither throws at render time — single source of
 * labelling truth is required for a valid Accessible Name.
 *
 * @example With visible label (ariaLabelledBy):
 * ```astro
 * <p id="toggle-label" class="text-sm text-foreground-600">Show pricing for:</p>
 * <SegmentedControl
 *   name="frequency"
 *   options={[
 *     { value: "monthly", label: "Monthly" },
 *     { value: "yearly", label: "Yearly" },
 *   ]}
 *   defaultValue="monthly"
 *   ariaLabelledBy="toggle-label"
 * />
 * ```
 *
 * @example Without visible label (ariaLabel):
 * ```astro
 * <form class="group/tiers">
 *   <SegmentedControl
 *     name="frequency"
 *     options={[
 *       { value: "monthly", label: "Monthly" },
 *       { value: "yearly", label: "Yearly" },
 *     ]}
 *     defaultValue="monthly"
 *     ariaLabel="Select billing frequency"
 *   />
 *
 *   <!-- Content that changes based on selection -->
 *   <p class="group-has-[[value=monthly]:checked]/tiers:block hidden">
 *     Monthly pricing shown
 *   </p>
 * </form>
 * ```
 */

import { validateSegmentedControlLabelling } from '~/utils/segmentedControlValidation';

type Option = {
  /** Unique value for this option */
  value: string;
  /** Display label */
  label: string;
};

type BaseProps = {
  /** Unique name for the radio group (used for CSS targeting) */
  name: string;
  /** Available options */
  options: readonly Option[];
  /** Initially selected value (defaults to first option) */
  defaultValue?: string;
  /** Visual variant for different background contexts */
  variant?: 'default' | 'on-dark';
};

/**
 * Labelling XOR: exactly one of ariaLabelledBy (reference a visible label)
 * or ariaLabel (invisible accessible name) must be provided. The `?: never`
 * flag on the alternative prop turns "both at once" into a TypeScript error
 * at call-site, complementing the runtime check below.
 */
type LabellingProps =
  | { ariaLabelledBy: string; ariaLabel?: never }
  | { ariaLabel: string; ariaLabelledBy?: never };

type Props = BaseProps & LabellingProps;

const { name, options, defaultValue, ariaLabel, ariaLabelledBy, variant = 'default' } = Astro.props;

// Guard against empty options
if (options.length === 0) {
  throw new Error('SegmentedControl requires at least one option');
}

// Runtime guard — belt-and-suspenders against .astro consumers without
// strict TypeScript. Extracted to a pure helper so the XOR contract can be
// regression-tested without an Astro render harness.
validateSegmentedControlLabelling(ariaLabelledBy, ariaLabel);

const selectedValue = defaultValue ?? options[0].value;

const containerClasses =
  variant === 'on-dark'
    ? 'inset-ring-white/30 inline-flex rounded-full p-1 text-center text-sm/6 font-semibold inset-ring'
    : 'inset-ring-foreground-950/10 inline-flex rounded-full p-1 text-center text-sm/6 font-semibold inset-ring dark:inset-ring-white/10';

const labelTextClasses =
  variant === 'on-dark'
    ? 'text-white/70 group-has-checked:text-white'
    : 'text-foreground-700 group-has-checked:text-white dark:text-gray-400 dark:group-has-checked:text-white';
---

<fieldset aria-labelledby={ariaLabelledBy}>
  {ariaLabel && <legend class="sr-only">{ariaLabel}</legend>}
  <div class={containerClasses}>
    {
      options.map((option) => (
        <label class="group has-checked:bg-accent-600 has-focus-visible:ring-accent-500 dark:has-checked:bg-accent-500 dark:has-focus-visible:ring-offset-background-dark relative cursor-pointer rounded-full px-4 py-1.5 transition-colors has-focus-visible:ring-2 has-focus-visible:ring-offset-2">
          <input
            type="radio"
            name={name}
            value={option.value}
            checked={option.value === selectedValue}
            class="absolute inset-0 cursor-pointer appearance-none rounded-full"
          />
          <span class={labelTextClasses}>{option.label}</span>
        </label>
      ))
    }
  </div>
</fieldset>
