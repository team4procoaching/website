---
import BaseHead from '~/components/layout/BaseHead.astro';
import Footer from '~/components/navigation/Footer.astro';
import Header from '~/components/navigation/Header.astro';
import navigationConfig from '~/data/navigation';
import siteConfig from '~/data/site';
import '~/styles/global.css';

type Props = {
  /** Page-specific title (combined with site name) */
  title?: string;
  /** Complete title override (ignores automatic title construction) */
  overrideTitle?: string;
  /** Page description for meta tags (falls back to site description) */
  description?: string;
  /** Canonical URL for this page */
  canonicalURL?: URL | string;
  /** Prevent search engines from indexing this page */
  noindex?: boolean;
  /** Language code, defaults to 'en' */
  locale?: string;
  /** Header color variant for pages with dark hero backgrounds */
  headerVariant?: 'default' | 'on-dark';
};

const {
  title,
  overrideTitle,
  description,
  canonicalURL,
  noindex,
  locale = 'en',
  headerVariant = 'default',
} = Astro.props;

const fontPreloads = [
  { href: '/fonts/manrope-v20-latin-regular.woff2' },
  { href: '/fonts/manrope-v20-latin-600.woff2' },
];
---

<!doctype html>
<html lang={locale}>
  <head>
    <BaseHead
      siteName={siteConfig.name}
      title={title}
      overrideTitle={overrideTitle}
      description={description ?? siteConfig.description}
      canonicalURL={canonicalURL}
      noindex={noindex}
      fontPreloads={fontPreloads}
    />
  </head>
  <body class="bg-background text-primary-950 dark:bg-background-dark dark:text-gray-100">
    <a
      href="#main"
      class="bg-primary-600 focus:ring-primary-500 fixed top-4 left-4 z-100 -translate-y-16 rounded-md px-4 py-2 text-sm font-semibold text-white transition-transform focus:translate-y-0 focus:ring-2 focus:ring-offset-2 focus:outline-none"
    >
      Skip to main content
    </a>
    <Header
      siteName={siteConfig.name}
      logo={siteConfig.logo}
      navigation={navigationConfig.main}
      variant={headerVariant}
    />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer
      social={siteConfig.social}
      footerLinks={navigationConfig.footer}
      copyright={siteConfig.copyright}
    />
    <script>
      import '@tailwindplus/elements';
    </script>
  </body>
</html>
